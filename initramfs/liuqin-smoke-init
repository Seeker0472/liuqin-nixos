#!/bin/busybox sh
# liuqin smoke-test initramfs /init.
#
# The device has no wired UART, so the only console is the panel: the kernel
# paints earlycon output into ABL's framebuffer and, once the DRM log client is
# up, onto the panel itself (BRINGUP-LOG 53.15).  This script runs as PID 1
# from an initramfs, prints the facts that are otherwise unreadable, waits long
# enough for a photo, then reboots - so the whole "boot -> look -> come back"
# cycle needs no button press on either boot path.
#
# Pairs with ../initramfs/make-smoke-initramfs.sh (packs this plus a static
# aarch64 busybox into a cpio.gz) and a boot.img that carries it as its ramdisk.
export PATH=/bin
/bin/busybox --install -s /bin 2>/dev/null

# Unmissable marker, printed before anything that can hang.
#
# The panel only ever shows kernel output on this board (DEBUGGING.md section
# 10: simplefb is blacklisted so fbcon has no framebuffer, and the drm_log
# client waits on a display stack that never finishes probing), so silence from
# this init has two completely different meanings: "the init did not run" or
# "it ran and nothing can be seen". Thirty identical lines make that readable:
# if they appear, the console works and whatever is missing afterwards is the
# step that hung; if they never appear, userspace has no console at all and the
# only way forward is another channel (USB CDC-ACM, or leaving simplefb alone
# so tty0 gets fbcon).
i=0
while [ "$i" -lt 30 ]; do
	echo "=============== LIUQIN SMOKE INIT IS RUNNING ($i) ==============="
	i=$((i + 1))
done
echo "--- kernel $(uname -r), PID 1 alive, starting checks ---"
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null

echo "=== liuqin: userspace UP (kernel $(uname -r)) ==="
echo "--- /proc/version ---"
cat /proc/version
echo "--- /proc/partitions ---"
cat /proc/partitions
echo "--- block devices ---"
ls -l /dev/sd* /dev/mmcblk* 2>/dev/null | head -20
echo "--- /sys/class/drm (connectors) ---"
for s in /sys/class/drm/card*/card*/status; do
	[ -f "$s" ] && echo "$s = $(cat "$s")"
done
echo "--- /sys/class/backlight ---"
ls /sys/class/backlight/ 2>/dev/null
echo "--- firmware tree ---"
ls /lib/firmware 2>/dev/null | head
echo "--- /dev/disk/by-partlabel ---"
ls -l /dev/disk/by-partlabel/ 2>/dev/null | head -40
echo "--- 新 linux 分区（GPT 第 36 项 = /dev/sda36）---"
blkid /dev/sda36 2>/dev/null || echo "(no blkid, relying on the mount below)"
# The partition is named by the GPT, and that name is the only thing standing
# between "format the partition we carved tonight" and "format something else".
# mke2fs below is destructive, so refuse to run it on anything not called linux.
part=$(sed -n 's/^PARTNAME=//p' /sys/class/block/sda36/uevent 2>/dev/null)
echo "--- /dev/sda36 PARTNAME=$part ---"
mount_ok=0
if [ "$part" != "linux" ]; then
	mount_ok=9
	echo "=== LIUQIN CHECK: refusing, sda36 is PARTNAME=$part, not linux ==="
elif mount -t ext4 -o ro /dev/sda36 /mnt 2>&1; then
	mount_ok=1
	echo "=== LIUQIN CHECK: /dev/sda36 mounted read-only (a valid ext4) ==="
	df -h /mnt 2>/dev/null | tail -2
	ls -la /mnt | head -12
	echo "--- label (blkid) ---"
	blkid /dev/sda36 2>&1 | head -2
	umount /mnt
else
	echo "=== LIUQIN CHECK: /dev/sda36 does not mount as ext4 ==="
	# The 256 MiB image pushed over fastboot did not survive that path (where
	# ABL places it inside the partition cannot be checked from the host), so
	# make the filesystem here instead, where the partition offset is known,
	# and verify by mounting what we just made.
	# busybox already ships this (its mke2fs is the mkfs.ext2 applet, which
	# makes ext2 - the ext4 driver mounts that happily and resize2fs grows
	# it); a static e2fsprogs in the archive would provide mke2fs/mkfs.ext4
	# instead. Take whichever is present.
	fmt=
	for c in mke2fs mkfs.ext4 mkfs.ext3 mkfs.ext2; do
		if command -v "$c" >/dev/null 2>&1; then fmt=$c; break; fi
	done
	if [ -n "$fmt" ]; then
		echo "--- $fmt -F -L LIUQIN_ROOT /dev/sda36 ---"
		if "$fmt" -F -L LIUQIN_ROOT /dev/sda36; then
			echo "=== LIUQIN CHECK: format OK ==="
			sync
			mkdir -p /mnt
			if mount -t ext4 -o ro /dev/sda36 /mnt 2>&1; then
				mount_ok=1
				echo "=== LIUQIN CHECK: freshly formatted /dev/sda36 mounts ==="
				df -h /mnt 2>/dev/null | tail -2
				ls -la /mnt | head -6
				umount /mnt
			else
				echo "=== LIUQIN CHECK: formatted but still will not mount ==="
			fi
		else
			echo "=== LIUQIN CHECK: formatter failed ==="
		fi
	else
		echo "--- no formatter in this initramfs, cannot format ---"
	fi
fi
echo "--- dmesg tail ---"
dmesg 2>/dev/null | tail -15

# The result is reported twice over: on the panel for a human, and by
# behaviour for the host.  There is no UART and no gadget in this userspace, so
# "did it work" has to be observable from outside without a photo: on success
# this reboots (the device comes back to ABL and then Android within ~90 s), on
# failure it holds here and never returns - the absence of the reboot *is* the
# failure report.
# The result is shouted, not stated: on a panel where userspace output may not
# appear at all, one line and thirty lines are very different amounts of
# evidence, and a missing burst is itself the answer.
if [ "$mount_ok" = 1 ]; then
	i=0
	while [ "$i" -lt 20 ]; do
		echo "############ LIUQIN CHECK PASSED: sda36 IS A MOUNTABLE EXT4 ############"
		i=$((i + 1))
	done
	echo "=== holding 60s for a photo, then reboot -f ==="
	sleep 60
	echo "=== rebooting (mount check passed) ==="
	reboot -f
else
	i=0
	while [ "$i" -lt 20 ]; do
		echo "!!!!!!!!!!!! LIUQIN CHECK FAILED (mount_ok=$mount_ok) !!!!!!!!!!!!"
		i=$((i + 1))
	done
	echo "=== holding indefinitely (no reboot); that absence is the signal ==="
	sleep 3600
fi
