#!/bin/busybox sh
# liuqin smoke-test initramfs /init.
#
# The device has no wired UART, so the only console is the panel: the kernel
# paints earlycon output into ABL's framebuffer and, once the DRM log client is
# up, onto the panel itself (BRINGUP-LOG 53.15).  This script runs as PID 1
# from an initramfs, prints the facts that are otherwise unreadable, and holds
# with a read-only USB control channel for host diagnostics.
#
# Pairs with ../initramfs/make-smoke-initramfs.sh (packs this plus a static
# aarch64 busybox into a cpio.gz) and a boot.img that carries it as its ramdisk.
export PATH=/bin
/bin/busybox --install -s /bin 2>/dev/null

# Unmissable marker, printed before anything that can hang.
#
# The panel only ever shows kernel output on this board (DEBUGGING.md section
# 10: simplefb is blacklisted so fbcon has no framebuffer, and the drm_log
# client waits on a display stack that never finishes probing), so silence from
# this init has two completely different meanings: "the init did not run" or
# "it ran and nothing can be seen". Thirty identical lines make that readable:
# if they appear, the console works and whatever is missing afterwards is the
# step that hung; if they never appear, userspace has no console at all and the
# only way forward is another channel (USB CDC-ACM, or leaving simplefb alone
# so tty0 gets fbcon).
i=0
while [ "$i" -lt 30 ]; do
	echo "=============== LIUQIN SMOKE INIT IS RUNNING ($i) ==============="
	i=$((i + 1))
done
echo "--- kernel $(uname -r), PID 1 alive, starting checks ---"
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mkdir -p /mnt

echo "=== liuqin: userspace UP (kernel $(uname -r)) ==="
echo "--- /proc/version ---"
cat /proc/version
echo "--- /proc/partitions ---"
cat /proc/partitions
echo "--- block devices ---"
ls -l /dev/sd* /dev/mmcblk* 2>/dev/null | head -20
echo "--- /sys/class/drm (connectors) ---"
for s in /sys/class/drm/card*/card*/status; do
	[ -f "$s" ] && echo "$s = $(cat "$s")"
done
echo "--- /sys/class/backlight ---"
ls /sys/class/backlight/ 2>/dev/null
echo "--- firmware tree ---"
ls /lib/firmware 2>/dev/null | head
echo "--- /dev/disk/by-partlabel ---"
ls -l /dev/disk/by-partlabel/ 2>/dev/null | head -40
echo "--- linux partition (resolved by GPT partlabel) ---"
# No udev is started in this deliberately tiny initramfs, so /dev/disk/by-*
# links are not a reliable source of identity. Resolve the GPT label directly
# from each kernel block-device uevent instead.
linux_dev=
part=
for uevent in /sys/class/block/*/uevent; do
	[ -r "$uevent" ] || continue
	[ "$(sed -n 's/^PARTNAME=//p' "$uevent" | head -1)" = linux ] || continue
	devname=$(basename "$(dirname "$uevent")")
	[ -e "/sys/class/block/$devname/partition" ] || continue
	linux_dev="/dev/$devname"
	part=linux
	break
done
echo "--- $linux_dev PARTNAME=$part ---"
mount_ok=0
if [ -z "$linux_dev" ] || [ "$part" != "linux" ]; then
	mount_ok=9
	echo "=== LIUQIN CHECK: refusing, partlabel linux is absent or mismatched ==="
elif mount -t ext4 -o ro "$linux_dev" /mnt 2>&1; then
	mount_ok=1
	echo "=== LIUQIN CHECK: $linux_dev mounted read-only (a valid ext4) ==="
	df -h /mnt 2>/dev/null | tail -2
	ls -la /mnt | head -12
	echo "--- label (blkid) ---"
	blkid "$linux_dev" 2>&1 | head -2
	umount /mnt
	# This image is a diagnostic RAM boot, not an installer. No writes are
	# performed even when the filesystem is valid.
else
	# This image is a diagnostic RAM boot, not an installer.  Never format or
	# write a block device here: geometry is capacity-specific and GPT changes
# belong to the explicit operator-driven sgdisk step.
	echo "=== LIUQIN CHECK: $linux_dev is not a mountable ext4; no writes performed ==="
fi

# Prove every UFS block node is read-only before exposing any remote shell.
ufs_safe=1
ufs_seen=0
for node in /dev/sd[a-z] /dev/sd*[0-9]*; do
	[ -b "$node" ] || continue
	ufs_seen=1
	blockdev --setro "$node" 2>/dev/null || ufs_safe=0
done
[ "$ufs_seen" = 1 ] || ufs_safe=0
for node in /dev/sd[a-z] /dev/sd*[0-9]*; do
	[ -b "$node" ] || continue
	[ "$(blockdev --getro "$node" 2>/dev/null || echo 0)" = 1 ] || ufs_safe=0
done
echo "--- UFS write lock: seen=$ufs_seen safe=$ufs_safe ---"

# The default is read-only, but this image is also the hands-on bring-up
# console. Make the dangerous transition explicit and visible instead of
# requiring a shell user to know blockdev(8)'s inverse operation. The command
# is installed only after the initial lock and requires an exact confirmation
# token; it does not partition or format anything by itself.
cat >/bin/enable-storage-writes <<'EOF'
#!/bin/busybox sh
if [ "$1" != LIUQIN-ENABLE-WRITES ]; then
	echo "refusing: run enable-storage-writes LIUQIN-ENABLE-WRITES" >&2
	exit 2
fi
failed=0
seen=0
for node in /dev/sd[a-z] /dev/sd*[0-9]*; do
	[ -b "$node" ] || continue
	seen=1
	blockdev --setrw "$node" 2>/dev/null || failed=1
done
[ "$seen" = 1 ] || failed=1
for node in /dev/sd[a-z] /dev/sd*[0-9]*; do
	[ -b "$node" ] || continue
	[ "$(blockdev --getro "$node" 2>/dev/null || echo 1)" = 0 ] || failed=1
done
if [ "$failed" = 0 ]; then
	echo "UFS write access ENABLED by explicit operator request"
	echo "Use sgdisk only after a GPT backup and a second geometry review."
	exit 0
fi
echo "refusing: could not make every UFS block node writable" >&2
exit 1
EOF
chmod 0755 /bin/enable-storage-writes
echo "--- storage writes remain locked; explicit command: enable-storage-writes LIUQIN-ENABLE-WRITES ---"

# The smoke image has no udev, module loader, or persistent network config.
# Bind a USB2 NCM gadget only after every UFS block device is read-only. This
# is a diagnostics/control channel; GPT changes remain an explicit operator
# operation after measurement and backup.
gadget=/sys/kernel/config/usb_gadget/liuqin
mkdir -p /sys/kernel/config
if [ "$ufs_safe" = 1 ] && mount -t configfs configfs /sys/kernel/config 2>/dev/null && mkdir -p "$gadget"; then
	echo 0x1d6b >"$gadget/idVendor"
	echo 0x1040 >"$gadget/idProduct"
	echo 0x0200 >"$gadget/bcdUSB"
	mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
	echo liuqin-smoke >"$gadget/strings/0x409/serialnumber"
	echo "Xiaomi Pad 6 Pro" >"$gadget/strings/0x409/manufacturer"
	echo "liuqin read-only bring-up" >"$gadget/strings/0x409/product"
	echo "diagnostics" >"$gadget/configs/c.1/strings/0x409/configuration"
	function_name=ncm.usb0
	if ! mkdir "$gadget/functions/$function_name" 2>/dev/null; then
		function_name=ecm.usb0
		mkdir "$gadget/functions/$function_name"
	fi
	ln -s "$gadget/functions/$function_name" "$gadget/configs/c.1/$function_name"
	udc=
	for node in /sys/class/udc/*; do [ -e "$node" ] && udc=$(basename "$node") && break; done
	if [ -n "$udc" ]; then
		echo "$udc" >"$gadget/UDC"
		if ip link set usb0 up 2>/dev/null && ip addr add 192.168.7.2/24 dev usb0 2>/dev/null; then
			cat >/run/udhcpd.conf <<-EOF
			start 192.168.7.10
			end 192.168.7.19
			interface usb0
			lease_file /run/udhcpd.leases
			pidfile /run/udhcpd.pid
			max_leases 10
			option subnet 255.255.255.0
			EOF
			: >/run/udhcpd.leases
			udhcpd /run/udhcpd.conf 2>/dev/null || true
			echo "=== USB $function_name ready: telnet 192.168.7.2 2323 ==="
			telnetd -F -l /bin/sh -p 2323 >/dev/null 2>&1 &
		else
			echo "=== USB gadget bound but usb0 setup failed ==="
		fi
	else
		echo "=== USB configfs ready but no UDC found ==="
	fi
else
	echo "=== USB control withheld: UFS was not proven read-only or configfs is unavailable ==="
fi
echo "--- dmesg tail ---"
dmesg 2>/dev/null | tail -15

# The result is reported twice over: on the panel for a human, and by
# behaviour for the host. The USB shell is diagnostic-only and the image does
# not reboot or write storage.
# The result is shouted, not stated: on a panel where userspace output may not
# appear at all, one line and thirty lines are very different amounts of
# evidence, and a missing burst is itself the answer.
if [ "$mount_ok" = 1 ]; then
	i=0
	while [ "$i" -lt 20 ]; do
		echo "############ LIUQIN CHECK PASSED: $linux_dev IS A MOUNTABLE EXT4 ############"
		i=$((i + 1))
	done
	echo "=== holding for USB diagnostics; no reboot or storage write ==="
	sleep 3600
else
	i=0
	while [ "$i" -lt 20 ]; do
		echo "!!!!!!!!!!!! LIUQIN CHECK FAILED (mount_ok=$mount_ok) !!!!!!!!!!!!"
		i=$((i + 1))
	done
	echo "=== holding indefinitely (no reboot); that absence is the signal ==="
	sleep 3600
fi
