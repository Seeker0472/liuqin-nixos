+	.regulators = { \
+		{ .supply = "vdda-phy", .init_load_uA = 88000 }, \
+		{ .supply = "vdda-pll", .init_load_uA = 17800 }, \
+	}, \
+	.clock = { "csiphy" #_n, "csiphy" #_n "_timer" }, \
+	.clock_rate = { { 400000000, 480000000 }, { 400000000 } }, \
+	.reg = { "csiphy" #_n }, .interrupt = { "csiphy" #_n }, \
+	.csiphy = { .id = _n, .hw_ops = &csiphy_ops_3ph_1_0, \
