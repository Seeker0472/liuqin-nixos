+		/*
+		 * The depth camera's I/O rail.  The vendor's own l4 range is
+		 * 1.62-3.3 V with a 1.8 V default (phandle 0x305); 1.8 V is
+		 * pinned here because nothing else on this board uses l4.
+		 */
+		pm8350c_l4: ldo4 {
+			regulator-name = "pm8350c_l4";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * The wide camera's autofocus rail (the dw9768's vdd/vin).
+		 * Kept always on: the VCM only answers while the sensor
+		 * module is powered anyway (the sensor driver owns the
+		 * module supplies), so gating this rail too would add a
+		 * second power state without buying anything.  The cost is
+		 * the actuator's quiescent draw while the system runs.
+		 *
+		 * Stays at its 3.0 V default: nothing writes the vendor's
+		 * 3.1 V any more, and focus works at 3.0 V.
+		 */
+		pm8350c_l7: ldo7 {
+			regulator-name = "pm8350c_l7";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-always-on;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		pm8350c_l10: ldo10 {
 			regulator-name = "pm8350c_l10";
 			regulator-min-microvolt = <1200000>;
@@ -1572,3 +1611,493 @@
 
 	status = "okay";
 };
+
+/*
+ * Mainline CAMSS bring-up.  This exposes the public CAMSS media graph and
+ * leaves Spectra CPAS/ICP/JPEG outside the first raw-RDI milestone.  The
+ * CSIPHY driver currently uses its upstream 2.1.2 programming table for the
+ * vendor's 2.1.3 PHY; the resulting link must be checked on hardware.
+ */
+/* CAMSS_TOP_GDSC needs the CAMNOC high frequency path before power-on. */
+&camcc {
+	interconnects = <&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
+			 &mmss_noc SLAVE_MNOC_HF_MEM_NOC QCOM_ICC_TAG_ALWAYS>;
+};
+
+&soc {
+	camss: isp@acb7000 {
+		compatible = "qcom,sm8475-camss";
+
+		reg = <0x0 0x0acb7000 0x0 0x0d00>,
+		      <0x0 0x0acb9000 0x0 0x0d00>,
+		      <0x0 0x0acbb000 0x0 0x0d00>,
+		      <0x0 0x0acc6000 0x0 0x0a00>,
+		      <0x0 0x0acca000 0x0 0x0a00>,
+		      <0x0 0x0acb6000 0x0 0x1000>,
+		      <0x0 0x0ace4000 0x0 0x2000>,
+		      <0x0 0x0ace6000 0x0 0x2000>,
+		      <0x0 0x0ace8000 0x0 0x2000>,
+		      <0x0 0x0acea000 0x0 0x2000>,
+		      <0x0 0x0acec000 0x0 0x2000>,
+		      <0x0 0x0acee000 0x0 0x2000>,
+		      <0x0 0x0ac62000 0x0 0xf000>,
+		      <0x0 0x0ac71000 0x0 0xf000>,
+		      <0x0 0x0ac80000 0x0 0xf000>,
+		      <0x0 0x0acc6000 0x0 0x2800>,
+		      <0x0 0x0acca000 0x0 0x2800>;
+		reg-names = "csid0", "csid1", "csid2", "csid_lite0", "csid_lite1",
+			    "csid_wrapper", "csiphy0", "csiphy1", "csiphy2", "csiphy3",
+			    "csiphy4", "csiphy5", "vfe0", "vfe1", "vfe2",
+			    "vfe_lite0", "vfe_lite1";
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CPAS_FAST_AHB_CLK>,
+			 <&camcc CAM_CC_CPAS_IFE_0_CLK>,
+			 <&camcc CAM_CC_CPAS_IFE_1_CLK>,
+			 <&camcc CAM_CC_CPAS_IFE_2_CLK>,
+			 <&camcc CAM_CC_CPAS_IFE_LITE_CLK>,
+			 <&camcc CAM_CC_CSID_CLK>,
+			 <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
+			 <&camcc CAM_CC_CSIPHY0_CLK>, <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY1_CLK>, <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY2_CLK>, <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY3_CLK>, <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY4_CLK>, <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY5_CLK>, <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
+			 <&camcc CAM_CC_IFE_0_FAST_AHB_CLK>, <&camcc CAM_CC_IFE_0_CLK>,
+			 <&camcc CAM_CC_IFE_1_FAST_AHB_CLK>, <&camcc CAM_CC_IFE_1_CLK>,
+			 <&camcc CAM_CC_IFE_2_FAST_AHB_CLK>, <&camcc CAM_CC_IFE_2_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_AHB_CLK>, <&camcc CAM_CC_IFE_LITE_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>;
+		clock-names = "camnoc_rt_axi", "camnoc_nrt_axi", "cpas_ahb",
+			      "cpas_fast_ahb", "cpas_vfe0", "cpas_vfe1", "cpas_vfe2",
+			      "cpas_ife_lite", "csid", "csiphy_rx",
+			      "csiphy0", "csiphy0_timer", "csiphy1", "csiphy1_timer",
+			      "csiphy2", "csiphy2_timer", "csiphy3", "csiphy3_timer",
+			      "csiphy4", "csiphy4_timer", "csiphy5", "csiphy5_timer",
+			      "vfe0_fast_ahb", "vfe0", "vfe1_fast_ahb", "vfe1",
+			      "vfe2_fast_ahb", "vfe2", "vfe_lite_ahb", "vfe_lite",
+			      "vfe_lite_csid", "vfe_lite_cphy_rx";
+
+		interrupts = <GIC_SPI 464 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 466 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 640 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 468 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 359 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 465 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 467 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 641 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 469 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 360 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "csid0", "csid1", "csid2", "csid_lite0", "csid_lite1",
+				  "csiphy0", "csiphy1", "csiphy2", "csiphy3", "csiphy4",
+				  "csiphy5", "vfe0", "vfe1", "vfe2", "vfe_lite0", "vfe_lite1";
+
+		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
+				<&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "cam_ahb", "cam_hf_mnoc";
+		/*
+		 * The ife/sfe write masters use SIDs {0x800,0x820,0x840,0x860,
+		 * 0xc00,0xc20,0xc40,0xc60} (vendor DT lists all eight with mask
+		 * 0x460; the arm-smmu mask field is only 8 bits [23:16], so the
+		 * vendor's 0x400 is a flag and the real mask is 0x60).  One entry
+		 * cannot span bit 10, hence two entries.  With the upstream
+		 * (0x800 0x20) the WM writes from 0x840/0x860/0xc0x are silently
+		 * dropped by the SMMU (no fault) and no frame data reaches DRAM.
+		 */
+		iommus = <&apps_smmu 0x800 0x60>, <&apps_smmu 0xc00 0x60>;
+
+		power-domains = <&camcc IFE_0_GDSC>,
+				<&camcc IFE_1_GDSC>,
+				<&camcc IFE_2_GDSC>,
+				<&camcc TITAN_TOP_GDSC>;
+		power-domain-names = "ife0", "ife1", "ife2", "top";
+		vdda-phy-supply = <&pm8350_l5>;
+		vdda-pll-supply = <&pm8350c_l10>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 { reg = <0>; };
+			port@1 { reg = <1>; };
+			port@2 { reg = <2>; };
+			port@3 { reg = <3>; };
+			port@4 { reg = <4>; };
+			port@5 { reg = <5>; };
+		};
+	};
+};
+
+/* Camera sensor rails copied from the vendor board wiring. */
+/ {
+	/*
+	 * Camera module rails, from the vendor runtime DT: the wide and front
+	 * modules each have their own DVDD/AVDD switches on TLMM GPIOs, and
+	 * the depth module has one AVDD switch.  The vendor's 100 us enable
+	 * ramp delay is kept.
+	 */
+	camera_wide_dvdd_ldo: camera-wide-dvdd-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_wide_dvdd_ldo";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		regulator-enable-ramp-delay = <100>;
+		gpio = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	camera_wide_avdd_ldo: camera-wide-avdd-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_wide_avdd_ldo";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-enable-ramp-delay = <100>;
+		gpio = <&tlmm 52 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	camera_front_vdig_ldo: camera-front-vdig-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_front_vdig_ldo";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		regulator-enable-ramp-delay = <100>;
+		gpio = <&tlmm 74 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	camera_front_avdd_ldo: camera-front-avdd-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_front_avdd_ldo";
+		regulator-min-microvolt = <2900000>;
+		regulator-max-microvolt = <2900000>;
+		regulator-enable-ramp-delay = <100>;
+		gpio = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	camera_deep_avdd: camera-deep-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_deep_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-enable-ramp-delay = <100>;
+		gpio = <&tlmm 118 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&tlmm {
+	/* The vendor camera graph muxes MCLK2 onto GPIO102. */
+	cam_sensor_mclk2_active: cam-sensor-mclk2-active {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_mclk2_suspend: cam-sensor-mclk2-suspend {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-pull-down;
+	};
+
+	cam_sensor_active_rst0: cam-sensor-active-rst0 {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_suspend_rst0: cam-sensor-suspend-rst0 {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+	/* IMX596 (front): MCLK5 on gpio105, RESET5 on gpio127 (vendor runtime DT). */
+	cam_sensor_mclk5_active: cam-sensor-mclk5-active {
+		pins = "gpio105";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_mclk5_suspend: cam-sensor-mclk5-suspend {
+		pins = "gpio105";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-pull-down;
+	};
+
+	cam_sensor_active_rst5: cam-sensor-active-rst5 {
+		pins = "gpio127";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_suspend_rst5: cam-sensor-suspend-rst5 {
+		pins = "gpio127";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* SC202CS (depth): MCLK1 on gpio101, RESET1 on gpio24 (vendor runtime DT). */
+	cam_sensor_mclk1_active: cam-sensor-mclk1-active {
+		pins = "gpio101";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_mclk1_suspend: cam-sensor-mclk1-suspend {
+		pins = "gpio101";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-pull-down;
+	};
+
+	cam_sensor_active_rst1: cam-sensor-active-rst1 {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_suspend_rst1: cam-sensor-suspend-rst1 {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/* First milestone: main rear S5KJN1 on CCI0 / CSIPHY3. */
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c1 {
+	status = "okay";
+
+	camera@10 {
+		compatible = "samsung,s5kjn1";
+		reg = <0x10>;
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		/*
+		 * 24 MHz selects the upstream mode tables.  The vendor's four
+		 * 19.2 MHz tables (patch 0020) are selected by changing this
+		 * rate; this node runs at 19200000 (the vendor tables), and the
+		 * driver rejects any MCLK it has no mode table for.
+		 */
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_sensor_mclk2_active &cam_sensor_active_rst0>;
+		pinctrl-1 = <&cam_sensor_mclk2_suspend &cam_sensor_suspend_rst0>;
+		vddd-supply = <&camera_wide_dvdd_ldo>;
+		vdda-supply = <&camera_wide_avdd_ldo>;
+		vddio-supply = <&pm8350c_l1>;
+		/* Vendor autofocus rail (l6 on this board is not the VCM). */
+		afvdd-supply = <&pm8350c_l7>;
+		status = "okay";
+		lens-focus = <&camera_vcm>;
+
+		port {
+			camera_out: endpoint {
+				clock-lanes = <0>;
+				/* Sensor lane numbering follows samsung,s5kjn1.yaml. */
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <700000000>;
+				remote-endpoint = <&camss_in3>;
+			};
+		};
+	};
+
+	/*
+	 * Rear module autofocus: GT9764, which uses the DW9768 register map
+	 * (AAC control at 0x02, 10-bit DAC split over 0x03/0x04, AAC
+	 * mode/prescale at 0x06 and the AAC period at 0x07).
+	 *
+	 * The vendor module data drives it with AAC enabled, AC[2:0] = 2 and
+	 * AACT[5:0] = 0x2a, i.e. exactly the values below; patch 0024 records
+	 * that evidence.  The I2C address is the family default 0x0c and has
+	 * not been read back on this board yet - if the node fails to probe,
+	 * check it with an i2ctransfer before suspecting anything else.
+	 */
+	camera_vcm: camera-lens@0c {
+		compatible = "giantec,gt9764";
+		/* The DW9768-family default, confirmed on the always-on
+		 * bus: 0x0c ACKs (DAC reads 512), 0x11/0x16/0x26/0x28 NACK. */
+		reg = <0x0c>;
+		vin-supply = <&pm8350c_l7>;
+		vdd-supply = <&pm8350c_l7>;
+		dongwoon,aac-mode = <2>;
+		dongwoon,clock-presc = <0>;
+		dongwoon,aac-timing = <0x2a>;
+		status = "okay";
+	};
+};
+
+&camss {
+	ports {
+		port@1 {
+			reg = <1>;
+			camss_in1: endpoint {
+				clock-lanes = <4>;
+				/* The SC202CS PLL rate equals its internal pixel rate: one lane. */
+				data-lanes = <0>;
+				remote-endpoint = <&sc202cs_out>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;
+			camss_in2: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx596_out>;
+			};
+		};
+
+		port@3 {
+			reg = <3>;
+			camss_in3: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&camera_out>;
+			};
+		};
+	};
+};
+
+/*
+ * Additional modules from the vendor runtime graph.  Both nodes are enabled:
+ * the CCI buses, rails, Bayer order and lane wiring were checked on hardware
+ * (the front needs its measured 678.4 MHz rate; the depth a 360 MHz
+ * single-lane link), and both capture through csid0.
+ */
+&cci0_i2c0 {
+	camera@10 {
+		compatible = "sony,imx596";
+		reg = <0x10>; /* vendor 8-bit write address 0x20 */
+		clocks = <&camcc CAM_CC_MCLK5_CLK>;
+		clock-names = "xvclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK5_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_sensor_mclk5_active &cam_sensor_active_rst5>;
+		pinctrl-1 = <&cam_sensor_mclk5_suspend &cam_sensor_suspend_rst5>;
+		vddd-supply = <&camera_front_vdig_ldo>;
+		vdda-supply = <&camera_front_avdd_ldo>;
+		vddio-supply = <&pm8350c_l1>;
+		status = "okay";
+
+		port {
+			imx596_out: endpoint {
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				/* 678.4 MHz, measured on the vendor stack (CAM_START_PHYDEV). */
+				link-frequencies = /bits/ 64 <678400000>;
+				remote-endpoint = <&camss_in2>;
+			};
+		};
+	};
+};
+
+/* CCI1 carries the depth sensor; upstream keeps the whole controller off. */
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	camera@36 {
+		compatible = "smartsens,sc202cs";
+		reg = <0x36>; /* vendor 8-bit write address 0x6c */
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		clock-names = "xvclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_sensor_mclk1_active &cam_sensor_active_rst1>;
+		pinctrl-1 = <&cam_sensor_mclk1_suspend &cam_sensor_suspend_rst1>;
+		vdda-supply = <&camera_deep_avdd>;
+		vddio-supply = <&pm8350c_l4>;
+		status = "okay";
+
+		port {
+			sc202cs_out: endpoint {
+				clock-lanes = <0>;
+				/* One lane: the PLL rate equals the internal pixel rate. */
+				data-lanes = <1>;
+				/* 720 Mbps on the vendor stack (CAM_START_PHYDEV csiphy1). */
+				link-frequencies = /bits/ 64 <360000000>;
+				remote-endpoint = <&camss_in1>;
+			};
+		};
+	};
+};
+
+/*
+ * Rear camera flash: PM8350C LED controller channel 1, which is what the
+ * vendor's qcom,camera-flash@0 drives (flash_0/torch_0/switch_0).  The
+ * currents and the timeout are the vendor's values: 500 mA torch, 1500 mA
+ * flash, 1280 ms.  Torch works on its own through /sys/class/leds; flash
+ * strobing still needs the sensor-side V4L2 flash linkage.
+ */
+&pm8350c_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>;
+		led-max-microamp = <500000>;
+		flash-max-microamp = <1500000>;
+		flash-max-timeout-us = <1280000>;
+	};
+};
+
+/*
+ * Module EEPROMs on the camera CCI buses.  The chip types come from the
+ * module blobs (gt24p128e on the wide, gt24p64e on the front).  The wide
+ * module's part was measured at 0x51 on this board and its node is enabled
+ * there; the front module's address is unconfirmed and its node stays
+ * disabled.  Read one with `i2ctransfer -y <bus> w2@0x51 0x00 0x00 r8`
+ * (the CCI adapter refuses longer reads) and take the bytes from the nvmem
+ * device under /sys/bus/nvmem/devices/.
+ * The depth module's EEPROM type is not named anywhere in its blob.
+ */
+&cci0_i2c1 {
+	eeprom@51 {
+		compatible = "atmel,24c128";
+		reg = <0x51>;
+		status = "okay";
+	};
+};
+
+&cci0_i2c0 {
+	eeprom@50 {
+		compatible = "atmel,24c64";
+		reg = <0x50>;
+		status = "disabled";
+	};
+};
