+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,sm8475-camss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM8475 Camera Subsystem (CAMSS)
+
+maintainers:
+  - Linux Media maintainers <linux-media@vger.kernel.org>
+
+description:
+  Qualcomm SM8475 CSI decoder, CSIPHY and IFE camera subsystem.
+  The first board integration uses three full CSID/IFE instances, two
+  lite instances and six CSIPHY blocks.
+
+properties:
+  compatible:
+    const: qcom,sm8475-camss
+
+  reg:
+    minItems: 17
+    maxItems: 17
+
+  reg-names:
+    minItems: 17
+    maxItems: 17
+    items:
+      - const: csid0
+      - const: csid1
+      - const: csid2
+      - const: csid_lite0
+      - const: csid_lite1
+      - const: csid_wrapper
+      - const: csiphy0
+      - const: csiphy1
+      - const: csiphy2
+      - const: csiphy3
+      - const: csiphy4
+      - const: csiphy5
+      - const: vfe0
+      - const: vfe1
+      - const: vfe2
+      - const: vfe_lite0
+      - const: vfe_lite1
+
+  clocks:
+    minItems: 32
+    maxItems: 32
+
+  clock-names:
+    minItems: 32
+    maxItems: 32
+    items:
+      - const: camnoc_rt_axi
+      - const: camnoc_nrt_axi
+      - const: cpas_ahb
+      - const: cpas_fast_ahb
+      - const: cpas_vfe0
+      - const: cpas_vfe1
+      - const: cpas_vfe2
+      - const: cpas_ife_lite
+      - const: csid
+      - const: csiphy_rx
+      - const: csiphy0
+      - const: csiphy0_timer
+      - const: csiphy1
+      - const: csiphy1_timer
+      - const: csiphy2
+      - const: csiphy2_timer
+      - const: csiphy3
+      - const: csiphy3_timer
+      - const: csiphy4
+      - const: csiphy4_timer
+      - const: csiphy5
+      - const: csiphy5_timer
+      - const: vfe0_fast_ahb
+      - const: vfe0
+      - const: vfe1_fast_ahb
+      - const: vfe1
+      - const: vfe2_fast_ahb
+      - const: vfe2
+      - const: vfe_lite_ahb
+      - const: vfe_lite
+      - const: vfe_lite_csid
+      - const: vfe_lite_cphy_rx
+
+  interrupts:
+    minItems: 16
+    maxItems: 16
+
+  interrupt-names:
+    minItems: 16
+    maxItems: 16
+    items:
+      - const: csid0
+      - const: csid1
+      - const: csid2
+      - const: csid_lite0
+      - const: csid_lite1
+      - const: csiphy0
+      - const: csiphy1
+      - const: csiphy2
+      - const: csiphy3
+      - const: csiphy4
+      - const: csiphy5
+      - const: vfe0
+      - const: vfe1
+      - const: vfe2
+      - const: vfe_lite0
+      - const: vfe_lite1
+
+  interconnects:
+    minItems: 2
+    maxItems: 2
+
+  interconnect-names:
+    minItems: 2
+    maxItems: 2
+    items:
+      - const: cam_ahb
+      - const: cam_hf_mnoc
+
+  iommus:
+    maxItems: 2
+
+  power-domains:
+    minItems: 4
+    maxItems: 4
+
+  power-domain-names:
+    minItems: 4
+    maxItems: 4
+    items:
+      - const: ife0
+      - const: ife1
+      - const: ife2
+      - const: top
+
+  vdda-phy-supply: {}
+  vdda-pll-supply: {}
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    description: CSI input ports.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - interrupt-names
+  - interconnects
+  - interconnect-names
+  - iommus
+  - power-domains
+  - power-domain-names
+  - vdda-phy-supply
+  - vdda-pll-supply
+
+additionalProperties: false
