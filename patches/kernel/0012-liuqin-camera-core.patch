Camera core: CAMSS for sm8475, the board's camera sensors and the board-DTS
camera wiring.

Merged from: bring-up patches 0018-camera-camss-sm8475, 0019-camera-sensors, 0022-camera-board-dts

--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/qcom,liuqin-camera-sensors.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/qcom,liuqin-camera-sensors.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Liuqin IMX596 and SC202CS image sensors
+
+description: |
+  The Xiaomi Liuqin board contains a Sony IMX596 front sensor and a
+  SmartSens SC202CS depth sensor.  The mode tables are supplied by the
+  mainline driver.  The SC202CS lane count and both modules' Bayer order
+  remain bring-up assumptions until hardware measurements are available.
+
+maintainers:
+  - Linux Media maintainers <linux-media@vger.kernel.org>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    enum:
+      - sony,imx596
+      - smartsens,sc202cs
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: 19.2 MHz sensor master clock.
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: xvclk
+
+  reset-gpios:
+    maxItems: 1
+
+  vdda-supply:
+    description: Optional analogue sensor supply.
+
+  vddd-supply:
+    description: Optional digital core supply.
+
+  vddio-supply:
+    description: Optional digital I/O supply.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          clock-lanes:
+            maxItems: 1
+          data-lanes:
+            minItems: 1
+            maxItems: 4
+          link-frequencies:
+            minItems: 1
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - port
+
+unevaluatedProperties: false
