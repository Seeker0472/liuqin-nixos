+static ssize_t verify_digest_store(struct device *dev,
+					   struct device_attribute *attr,
+					   const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u8 digest[32];
+	int ret;
+
+	if (count < sizeof(digest) * 2 || hex2bin(digest, buf, sizeof(digest)))
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_xm_digest_locked(battmgr, BATTMGR_XM_PROPERTY_SET,
+					    digest, battmgr->verify_slave_flag, NULL);
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : count;
