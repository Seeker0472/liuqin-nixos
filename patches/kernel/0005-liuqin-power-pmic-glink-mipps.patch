+/*
+ * The liuqin ADSP implements UCSI 1.0, which carries no orientation field,
+ * and its charger service reports the Type-C CC orientation as XM property
+ * 36 instead.  The vendor stack uses the same value to drive the combo
+ * PHY's port select, so forward it to the QMP orientation switch here.
+ */
+static void qcom_battmgr_cc_orientation_work(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr,
+						    cc_orientation_work);
+	unsigned int value = 0, last = ~0u;
+	int ret;
+
+	if (!battmgr->service_up)
+		return;
+
+	if (!battmgr->cc_switch) {
+		qcom_battmgr_cc_switch_get(battmgr);
+		if (!battmgr->cc_switch)
+			return;
+	}
+
+	/*
+	 * The charger service may update the orientation only after the
+	 * attach notification that triggered this work, so poll briefly
+	 * for a real value instead of caching a stale 0 until the next
+	 * event arrives.
+	 */
+	for (int i = 0; i < 20; i++) {
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_CC_ORIENTATION,
+						       &value);
+		mutex_unlock(&battmgr->lock);
+		if (ret)
+			return;
+		if (value != last)
+			dev_dbg(battmgr->dev, "cc orientation read %u (try %d)\n",
+				 value, i);
+		last = value;
+		if (value == 1 || value == 2)
+			break;
+		msleep(250);
+	}
+
+	if (value == battmgr->cc_orientation)
+		return;
+	battmgr->cc_orientation = value;
+	dev_info(battmgr->dev, "Type-C CC orientation %u\n", value);
+
+	/* Charger service convention: 1 = CC1 (normal), 2 = CC2 (reverse). */
+	if (value == 1)
+		typec_switch_set(battmgr->cc_switch, TYPEC_ORIENTATION_NORMAL);
+	else if (value == 2)
+		typec_switch_set(battmgr->cc_switch, TYPEC_ORIENTATION_REVERSE);
+}
+#endif
+
+static void qcom_battmgr_schedule_cc_orientation(struct qcom_battmgr *battmgr)
+{
+#if IS_ENABLED(CONFIG_TYPEC)
+	if (battmgr->variant == QCOM_BATTMGR_SM8475)
+		schedule_work(&battmgr->cc_orientation_work);
+#endif
