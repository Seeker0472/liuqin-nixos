+static const char *qcom_battmgr_current_state_name(unsigned int state)
+{
+	switch (state) {
+	case 25:
+		return "SNK_Startup";
+	case 31:
+		return "SNK_Ready";
+	case 5:
+		return "SRC_Ready";
+	default:
+		return "UNKNOWN";
+	}
+}
