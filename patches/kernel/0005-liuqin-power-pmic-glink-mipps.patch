+static ssize_t request_vdm_cmd_show(struct device *dev,
+					    struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u32 state, words[4] = {};
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_UVDM_STATE, &state);
+	if (!ret && state == 5)
+		ret = qcom_battmgr_xm_get_words_locked(battmgr, XM_VDM_AUTHENTICATION, words);
+	mutex_unlock(&battmgr->lock);
+	if (ret)
+		return ret;
+	if (state == 5)
+		return sysfs_emit(buf, "5,%08x%08x%08x%08x\n", words[0], words[1], words[2], words[3]);
+	if (state == 1 || state == 2 || state == 3)
+		return sysfs_emit(buf, "%u,0\n", state);
+	return sysfs_emit(buf, "%u,Null\n", state);
+}
+
+static ssize_t request_vdm_cmd_store(struct device *dev,
+					     struct device_attribute *attr,
+					     const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	char payload[80];
+	unsigned int command, value, words[4];
+	/* Commands 4/5/8 all use the 32-byte session/auth frame; the vendor
+	 * driver takes the W32 reply for property 15 too (write_ss_auth_prop_id),
+	 * so all three expect QCOM_BATTMGR_XM_WORDS_RESPONSE. */
+	int ret;
+
+	if (sscanf(buf, "%u,%79s", &command, payload) != 2 || command > 8 || !command)
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	if (command == 4 || command == 5 || command == 8) {
+		if (strlen(payload) != 32 || sscanf(payload, "%8x%8x%8x%8x",
+					     &words[0], &words[1], &words[2], &words[3]) != 4)
+			ret = -EINVAL;
+		else {
+			/* the big-endian hex parse already equals the vendor's
+			 * BSWAP_32()ed word, so the words go out unswapped */
+			ret = qcom_battmgr_xm_request_locked(battmgr, BATTMGR_XM_PROPERTY_SET,
+							     command == 4 ? XM_VDM_SESSION_SEED :
+							     command == 5 ? XM_VDM_AUTHENTICATION : XM_VDM_REVERSE_AUTHEN,
+							     0, words,
+							     QCOM_BATTMGR_XM_WORDS_RESPONSE,
+							     NULL, NULL);
+		}
+	} else {
+		ret = 0;
+		if (!strcmp(payload, "null"))
+			value = 0;
+		else if (kstrtouint(payload, 16, &value))
+			ret = -EINVAL;
+		else if (command == 6 || command == 7)
+			value = swab32(value);
+		if (!ret) {
+			u32 property = command == 1 ? XM_VDM_CHARGER_VERSION :
+				command == 2 ? XM_VDM_CHARGER_VOLTAGE :
+				command == 3 ? XM_VDM_CHARGER_TEMP :
+				command == 6 ? XM_VDM_VERIFIED : XM_VDM_REMOVE_COMPENSATION;
+			ret = qcom_battmgr_xm_request_locked(battmgr, BATTMGR_XM_PROPERTY_SET,
+							     property, value, NULL,
+							     QCOM_BATTMGR_XM_VALUE_RESPONSE, NULL, NULL);
+		}
+	}
+	if (!ret)
+		battmgr->uvdm_state = command;
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : count;
+}
