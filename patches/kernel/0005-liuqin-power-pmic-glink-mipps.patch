+static int qcom_battmgr_class_value(struct qcom_battmgr *battmgr,
+				    unsigned int property, unsigned int *value)
+{
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_xm_get_value_locked(battmgr, property, value);
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
