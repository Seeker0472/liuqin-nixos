+static void qcom_battmgr_put_cc_switch(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	if (battmgr->cc_switch) {
+		typec_switch_put(battmgr->cc_switch);
+		battmgr->cc_switch = NULL;
+	}
+}
+
+static void qcom_battmgr_cc_switch_get(struct qcom_battmgr *battmgr)
+{
+	struct fwnode_handle *child;
+
+	device_for_each_child_node_scoped(battmgr->dev, child) {
+		struct typec_switch *sw = fwnode_typec_switch_get(child);
+
+		if (IS_ERR(sw))
+			continue;
+		battmgr->cc_switch = sw;
+		if (devm_add_action_or_reset(battmgr->dev,
+					     qcom_battmgr_put_cc_switch,
+					     battmgr)) {
+			battmgr->cc_switch = NULL;
+			return;
+		}
+		return;
+	}
+}
