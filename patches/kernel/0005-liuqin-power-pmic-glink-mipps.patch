+static const char *qcom_battmgr_real_type_name(unsigned int type)
+{
+	static const char *const names[] = { "Unknown", "SDP", "DCP", "CDP", "ACA", "C",
+		"PD", "PD_DRP", "PD_PPS", "BrickID", "USB_FLOAT", "HVDCP", "HVDCP_3",
+		"HVDCP_3P5", "USB_FLOAT", "HVDCP_3" };
+	unsigned int i = type < 0x80 ? type : 11 + type - 0x80;
+
+	return i < ARRAY_SIZE(names) ? names[i] : "Unknown";
+}
