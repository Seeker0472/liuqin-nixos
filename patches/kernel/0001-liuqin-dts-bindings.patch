+			 * This hall pin is pulled up when no magnet (keyboard/folio) is
+			 * near, so active-high maps detached -> tablet mode and attached
+			 * -> laptop mode -- the latter additionally gates GNOME's
+			 * on-screen keyboard.
+			 */
+			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <150>;
+			wakeup-source;
+		};
