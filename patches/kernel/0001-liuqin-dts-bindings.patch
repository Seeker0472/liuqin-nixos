+/*
+ * The magnetic keyboard folio's bridge chip, a Nanosic WN8030. The vendor tree
+ * has it as nanosic@4c under i2c@a94000 (abl-final-fdt.dts:13263-13293), which
+ * is sm8450.dtsi's i2c13 -- QUPv3 wrapper 1, SE 5. The pin state that .dtsi
+ * already selects for it, qup_i2c13_data_clk, is gpio48/gpio49 at drive 2 with
+ * a pull-up, matching the vendor's qupv3_se13_i2c_active (:3438) word for word.
+ *
+ * No clock-frequency, for the same reason as the amplifiers below: the vendor
+ * node sets none, so the bus runs at i2c-qcom-geni's 100 kHz default.
+ */
+&i2c13 {
+	status = "okay";
+
+	keyboard@4c {
+		compatible = "xiaomi,liuqin-keyboard", "nanosic,wn8030";
+		reg = <0x4c>;
+
+		/*
+		 * Two lines out of the bridge:
+		 *
+		 *  "data"   gpio50. The vendor passes this pin's third DT cell,
+		 *           0x6001, straight to request_threaded_irq() as flags
+		 *           (nano_driver.c:67 -> nano_i2c.c:543), where it reads
+		 *           as NO_SUSPEND | ONESHOT | TRIGGER_RISING. Rising is
+		 *           what matters here; the source comment nearby claims
+		 *           falling and is simply wrong.
+		 *  "wakeup" gpio46, the vendor's status_pin: a rising edge while
+		 *           the system is suspended. The I2C core claims this named
+		 *           dedicated wake IRQ; hid-nanosic owns only the data IRQ.
+		 */
+		interrupts-extended = <&tlmm 50 IRQ_TYPE_EDGE_RISING>,
+				      <&tlmm 46 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "data", "wakeup";
+
+		vdd-supply = <&keyboard_vdd_regulator>;
+
+		/* reset_pin gpio83, asserted low. */
+		reset-gpios = <&tlmm 83 GPIO_ACTIVE_LOW>;
+
+		/*
+		 * sleep_pin gpio42: high keeps the bridge running, low lets it
+		 * sleep. Named for what the line does, because the vendor's own
+		 * Nanosic_GPIO_sleep(true) means wake up, not sleep.
+		 */
+		wake-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&kb_data_irq_default>, <&kb_wakeup_irq_default>,
+			    <&kb_reset_default>, <&kb_wake_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+
+		/*
+		 * Deliberately no hall-*-gpios. The vendor node lists
+		 * hall_n_pin gpio10 and hall_s_pin gpio23, but those two are
+		 * already claimed above as gpio-keys SW_LID / SW_TABLET_MODE,
+		 * which is what logind and GNOME consume. A second consumer
+		 * would take this node's probe down with -EBUSY, and would gain
+		 * nothing: the vendor driver only forwarded those levels to a
+		 * Xiaomi userspace daemon that does not exist here.
+		 */
+	};
+};
+
+/*
+ * Speaker amplifiers. Four Cirrus CS35L41 parts, two per I2C controller, from
+ * the tree the bootloader actually handed the vendor kernel:
+ *
+ *   i2c@880000 (sm8450.dtsi i2c15)  abl-final-fdt.dts:13393
+ *     @43 TL  reset gpio1   irq gpio88   :13410-13433
+ *     @40 TR  reset gpio3   irq gpio63   :13435-13458
+ *   i2c@888000 (sm8450.dtsi i2c17)  :13556
+ *     @40 BR  reset gpio92  irq gpio89   :13572-13595
+ *     @41 BL  reset gpio87  irq gpio90   :13597-13620
+ *
+ * Boost 4000 mA / 1000 nH / 15 uF, asp-sdout-hiz 3, gpio2 = push-pull INTB
+ * (src-select 4) are copied from those nodes. Vendor interrupt flags 0x2008
+ * collapse to IRQ_TYPE_LEVEL_LOW, which is what INTB active-low is.
+ *
+ * The machine driver and tertiary TDM backend live in &sound below. Still no
+ * speaker-protection firmware: DAPM PRE_PMU must fail closed. Do not play.
+ *
+ * Preserve the vendor driver's default 400 kHz explicitly. A 20300-byte
+ * protection firmware block exceeds mainline's one-second timeout at 100 kHz.
+ */
+&i2c15 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	cs35l41_tl: speaker-amp@43 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x43>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "TL";
+
+		VA-supply = <&cs35l41_va>;
+		VP-supply = <&cs35l41_vp>;
+
+		reset-gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <88 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cirrus_reset_tl>, <&cirrus_irq_tl>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+
+	cs35l41_tr: speaker-amp@40 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "TR";
+
+		VA-supply = <&cs35l41_va>;
+		VP-supply = <&cs35l41_vp>;
+
+		reset-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <63 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cirrus_reset_tr>, <&cirrus_irq_tr>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+};
+
+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	cs35l41_br: speaker-amp@40 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "BR";
+
+		VA-supply = <&cs35l41_va>;
+		VP-supply = <&cs35l41_vp>;
+
+		reset-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <89 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cirrus_reset_br>, <&cirrus_irq_br>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+
+	cs35l41_bl: speaker-amp@41 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x41>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "BL";
+
+		VA-supply = <&cs35l41_va>;
+		VP-supply = <&cs35l41_vp>;
+
+		reset-gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <90 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cirrus_reset_bl>, <&cirrus_irq_bl>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+};
+
+/*
+ * Speaker backend only. Vendor waipio-asoc-snd has qcom,wsa-max-devs = <0>
+ * and disables the WSA SoundWire pin states (abl-final-fdt.dts:32346,
+ * :32385-32404); tert_tdm_pinctrl is ok and tert_mi2s_pinctrl is disabled
+ * (:32365-32383). Playback is four CS35L41s on tertiary TDM, not WSA883x.
+ * Pins gpio121/122/123/124 as mi2s2_sck/data0/ws/data1 match that FDT
+ * (:1795-1928) and cupid's TDM pinmux. Do not add WCD, WSA, or firmware-name.
+ *
+ * This is a DPCM backend: q6apm consumes the matching AudioReach topology
+ * qcom/sm8450/Xiaomi-Pad-6-Pro-tplg.bin. The topology and the standard TDM
+ * slot properties below form one atomic dependency; omitting either makes the
+ * PCM unusable. DAPM must not reach DSP1 Preloader: the image has no wmfw.
+ */
+&sound {
+	compatible = "qcom,sm8450-sndcard";
+	model = "Xiaomi-Pad-6-Pro";
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&tert_tdm_clk_active>, <&tert_tdm_ws_active>,
+		    <&tert_tdm_din_active>, <&tert_tdm_dout_active>;
+	pinctrl-1 = <&tert_tdm_clk_sleep>, <&tert_tdm_ws_sleep>,
+		    <&tert_tdm_din_sleep>, <&tert_tdm_dout_sleep>;
+
+	speaker-playback-dai-link {
+		link-name = "Primary Spkr Playback";
+
+		cpu {
+			sound-dai = <&q6apmbedai TERTIARY_TDM_RX_0>;
+			/*
+			 * The liuqin vendor speaker group is 48 kHz, four-channel,
+			 * 24-bit with slots 0..3 active (backend_conf.xml and the
+			 * cape resource manager both say mask 0xf).  S24_LE has a
+			 * 32-bit physical container, and q6apm accepts 16 or 32-bit
+			 * serial slots only, hence four 32-bit TDM slots.
+			 */
+			dai-tdm-slot-num = <4>;
+			dai-tdm-slot-width = <32>;
+			dai-tdm-slot-rx-mask = <1 1 1 1>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+
+		codec {
+			sound-dai = <&cs35l41_tl 0>, <&cs35l41_tr 0>,
+				    <&cs35l41_br 0>, <&cs35l41_bl 0>;
+		};
+	};
+};
+
+&wsamacro {
+	status = "disabled";
+};
+
+&wsa2macro {
+	status = "disabled";
+};
+
+/*
+ * Display. The panel is an 1800x2880 Novatek NT36532 driven at 120 Hz over two
+ * bonded DSI links with DSC 1.1, 450x20 slices. Every number below is taken
+ * from the m81_42_02_0b panel node in the device tree this unit's bootloader
+ * hands the vendor kernel, abl-final-fdt.dts:26160-26294 -- never from
+ * sources/sm8450-fdt/liuqin.dts, whose pretty-printer renders any integer that
+ * happens to equal a phandle as a <&label> and silently corrupts exactly the
+ * numbers that matter here.
+ *
+ * The timings live in the panel driver rather than in this file, and they are
+ * verifiable: running the vendor's porches (2*(100,2,46) horizontal, 26/2/214
+ * vertical) through dsi_host.c's own arithmetic -- compression-adjusted pclk,
+ * bonded halving, byte clock -- reproduces the vendor's declared per-lane rate
+ * of 1 007 032 320 Hz bit for bit. See docs/DISPLAY_RECON.zh-CN.md.
+ *
+ * Deliberately left alone: /chosen/bootargs, framebuffer@b8000000 and
+ * splash_region. earlycon=simplefb is still the only channel that can show a
+ * failure before device_initcall, and initcall_blacklist=simplefb_driver_init
+ * keeps fbcon off that same memory. Once DRM comes up it registers its own
+ * fb0, fbcon binds to it, and the earlycon simply goes blind -- which costs
+ * nothing now that telnet and a full dmesg are available on this board.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8350c_l10>;
+
+	/*
+	 * qcom,dual-dsi-mode, qcom,master-dsi and qcom,sync-dual-dsi are the
+	 * three properties dsi_manager.c:47-63 reads to put the pair into
+	 * bonded mode, where the DRM mode carries the full 1800 px width and
+	 * each host drives half of it.
+	 */
+	qcom,dual-dsi-mode;
+	qcom,master-dsi;
+	qcom,sync-dual-dsi;
+
+	status = "okay";
+
+	/*
+	 * Reuse pipa's description rather than adding a liuqin one. Every field
+	 * of pipa_desc (drivers/gpu/drm/panel/panel-novatek-nt36532.c:442-461)
+	 * matches this unit's m81_42_02_0b: mode, porches, 120 Hz, 450x20
+	 * slices, 2 slices per link, 8 bpc, 8 bpp, block prediction, physical
+	 * size. Its init sequence agrees with the vendor's 194-command blob in
+	 * 183 places, including the one command that encodes this panel's
+	 * porches, 3b 03 d8 1a 0a 0a 00, where 0xd8 is VBP+2 and 0x1a is VFP.
+	 *
+	 * reset-gpios is GPIO_ACTIVE_HIGH and that is not a copy of yudi.
+	 * pipa_reset() (:48-57) drives the line 0,1,0,1 with 12 ms between each
+	 * step and *ends on 1*, whereas yudi_reset() (:59-67) ends on 0. Only
+	 * one polarity makes each of them leave the panel out of reset, and for
+	 * pipa_reset() that is active-high: it then produces low, high, low,
+	 * high, which is the vendor's own reset waveform
+	 * qcom,mdss-dsi-reset-sequence = <0 10 1 3 0 3 1 15> (:26205) in shape,
+	 * ending deasserted, differing only in the dwell times. With
+	 * GPIO_ACTIVE_LOW the same helper inverts to high, low, high, low and
+	 * leaves NT36532 nRESET asserted for the whole init sequence and PPS --
+	 * every DSI write would still report success and the panel would stay
+	 * black with nothing in dmesg to explain it.
+	 *
+	 * No te-gpios: this is video mode, so there is no tear-effect
+	 * handshake. The vendor wires TE to gpio86 with the mdp_vsync function
+	 * (:32985, sde_te_active) for its command-mode paths; mainline's msm
+	 * DSI has no consumer for it here.
+	 */
+	panel: panel@0 {
+		compatible = "xiaomi,pipa-nt36532";
+		reg = <0>;
+
+		vddio-supply = <&pm8350c_l2>;
+		dvddbuck-supply = <&display_panel_dvdd_buck>;
+		dvddldo-supply = <&display_panel_dvdd_ldo>;
+
+		reset-gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>;
+		backlight = <&backlight>;
+
+		pinctrl-0 = <&sde_dsi_active>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				panel_in_0: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				panel_in_1: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in_0>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&pm8350_l5>;
+
+	status = "okay";
+};
+
+&mdss_dsi1 {
+	vdda-supply = <&pm8350c_l10>;
+
+	qcom,dual-dsi-mode;
+	qcom,sync-dual-dsi;
+
+	/*
+	 * The second link's byte and pixel clocks are sourced from the *first*
+	 * PHY's PLL, which is what keeps the two halves of the panel in step.
+	 * This overrides the self-referencing parents sm8450.dtsi:3624-3626
+	 * gives mdss_dsi1.
+	 */
+	assigned-clock-parents = <&mdss_dsi0_phy 0>, <&mdss_dsi0_phy 1>;
+
+	status = "okay";
+};
+
+&mdss_dsi1_out {
+	remote-endpoint = <&panel_in_1>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi1_phy {
+	vdds-supply = <&pm8350_l5>;
+
+	status = "okay";
+};
+
+/*
+ * QCA6490 WLAN on PCIe RC0. The wifi child exists before enumeration so
+ * pci-pwrctrl-pwrseq can claim the WCN6855 PMU's "wlan" target, raise gpio80
+ * and the shared rails, and only then release the host bridge to scan the bus.
+ * PCI pwrctrl is selected by ATH11K_PCI, so that dependency chain is built in;
+ * E20 still ends when PCI core sees 17cb:1103 because WLAN runtime firmware is
+ * deliberately absent and the driver must stop before firmware acceptance.
+ */
+&pcie0 {
+	status = "okay";
+};
+
+&pcieport0 {
+	wifi@0 {
+		compatible = "pci17cb,1103";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+		vddaon-supply = <&vreg_pmu_aon_0p8>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p7>;
+	};
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350c_l10>;
+
+	status = "okay";
+};
+
+&pm8350_gpios {
+	vol_up_n: vol-up-n-state {
+		pins = "gpio6";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		power-source = <1>;
+		input-enable;
+		bias-pull-up;
+	};
+};
+
+&pm8350c_gpios {
+	eusb2_reset_default: eusb2-reset-state {
+		pins = "gpio7";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		power-source = <1>;
+		input-enable;
+		output-enable;
+		bias-disable;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+	};
+};
+
+&pmk8350_rtc {
+	/*
+	 * Disabled upstream because not every SM8450-family board wires the RTC
+	 * battery, so enabling it is a per-board statement. Without it the kernel
+	 * has no real-time clock at all: it starts from the epoch and userspace
+	 * shows whatever systemd can salvage from filesystem timestamps -- this
+	 * tablet was reporting April while the host said August. On a desktop
+	 * that is not cosmetic; TLS validation, apt metadata freshness and every
+	 * log timestamp read from it.
+	 */
+	status = "okay";
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&qupv3_id_1 {
+	status = "okay";
+};
+
+&qupv3_id_2 {
+	status = "okay";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8475/liuqin/adsp.mbn";
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/sm8475/liuqin/cdsp.mbn";
+	status = "okay";
+};
+
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8475/liuqin/slpi.mbn";
+	status = "okay";
+};
