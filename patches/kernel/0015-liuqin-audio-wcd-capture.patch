From liuqin audio bring-up: WCD9385 SoundWire capture graph

The vendor runtime tree proves this tablet has WCD938x RX/TX slaves at
SoundWire addresses 0x0d:0x1170224 and 0x0d:0x1170223, plus LPASS RX/TX/VA
macros and the GPIO43 codec reset.  Wire those devices into the mainline
sm8450-sndcard graph.  The existing tertiary TDM CS35L41 speaker link remains
unchanged and stays protected by its calibration gate.

This adds the WCD playback link and the WCD capture link.  The capture link is
deliberately separate from the protected speaker backend so microphone
enumeration does not require CS35L41 Halo firmware.  Micbias is 2.75 V (0xabe)
for all four biases, matching the vendor runtime DT.

The VA macro is enabled only as the fsgen clock source every other macro
takes, and no VA capture link or DMIC routing is added: the vendor runtime DT
leaves all four swr-dmic slaves and the DMIC pinctrls disabled, so liuqin has
no AP-visible digital microphone.  The vendor audio-routing also names
"Digital Mic0".."Digital Mic3" widgets that only its own machine driver
creates; mainline rejects unknown route widgets and would fail the whole card,
so only the analog AMIC routes and the ADC-to-TX-SWR inputs are wired.

--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -450,6 +450,33 @@
 		pinctrl-0 = <&kb_vdd_default>;
 		pinctrl-names = "default";
 	};
+
+	/* WCD9385 is the RX/TX SoundWire codec used by the built-in mics. */
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wcd_reset_default>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+		qcom,mbhc-buttons-vthreshold-microvolt =
+			<75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+		reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&pm8350c_bob>;
+
+		#sound-dai-cells = <1>;
+	};
 };
 
 &apps_rsc {
@@ -524,6 +551,7 @@
 	regulators-1 {
 		compatible = "qcom,pm8350c-rpmh-regulators";
 		qcom,pmic-id = "c";
+		vdd-bob-supply = <&vph_pwr>;
 
 		pm8350c_l1: ldo1 {
 			regulator-name = "pm8350c_l1";
@@ -539,6 +567,14 @@
 			regulator-always-on;
 		};
 
+		/* WCD9385 mic-bias rail; the vendor DT uses pm8350c BOB. */
+		pm8350c_bob: bob {
+			regulator-name = "pm8350c_bob";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+
 		/*
 		 * The panel's iovdd. Range copied from the vendor's own
 		 * regulator-pm8350c-l2 (abl-final-fdt.dts:6179-6187,
@@ -977,6 +1013,23 @@
 	compatible = "qcom,sm8450-sndcard";
 	model = "Xiaomi-Pad-6-Pro";
 
