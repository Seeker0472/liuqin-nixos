+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mainline V4L2 drivers for the two additional Liuqin camera modules.
+ *
+ * The register tables are the byte-write containers extracted from the
+ * shipped sensor-module blobs.  They are intentionally kept as data tables;
+ * no vendor camera ABI is required by this driver.  Clock, lane, Bayer and
+ * link-frequency values marked in the descriptor are bring-up assumptions
+ * until a physical board has been exercised.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define LIUQIN_MCLK_FREQ	(19200000UL)
+#define LIUQIN_VTS_MAX		0xffff
+#define LIUQIN_EXPOSURE_MIN	8
+#define LIUQIN_EXPOSURE_MARGIN	8
+#define LIUQIN_AGAIN_MIN	1
+#define LIUQIN_AGAIN_MAX	16
+
+struct liuqin_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct liuqin_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	struct liuqin_reg_list reg_list;
+};
+
+struct liuqin_sensor_desc {
+	const char *name;
+	unsigned int lanes;
+	u32 mbus_code;
+	u64 link_freq;
+	const s64 *link_freq_menu;
+	unsigned int num_link_freqs;
+	unsigned int chip_reg;
+	u16 chip_id;
+	unsigned int vts_reg;
+	unsigned int exposure_reg;
+	unsigned int again_reg;
+	u32 again_min;
+	u32 again_max;
+	const struct liuqin_reg_list *init;
+	const struct liuqin_reg_list *stream_on;
+	const struct liuqin_reg_list *stream_off;
+	const struct liuqin_mode *modes;
+	unsigned int num_modes;
+	bool exposure_20bit;
+};
+
+struct liuqin_sensor {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vdda;
+	struct regulator *vddd;
+	struct regulator *vddio;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	const struct liuqin_sensor_desc *desc;
+	const struct liuqin_mode *mode;
+};
+
+#define to_liuqin(_sd) container_of(_sd, struct liuqin_sensor, sd)
