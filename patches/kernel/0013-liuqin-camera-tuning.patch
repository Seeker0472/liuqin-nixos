+++ b/drivers/media/i2c/dw9768.c
@@ -99,6 +99,7 @@ static const char * const dw9768_supply_names[] = {
 
 /* dw9768 device structure */
 struct dw9768 {
+	bool initialized;
 	struct regulator_bulk_data supplies[ARRAY_SIZE(dw9768_supply_names)];
 	struct v4l2_ctrl_handler ctrls;
 	struct v4l2_ctrl *focus;
@@ -313,7 +314,24 @@ static int dw9768_runtime_suspend(struct device *dev)
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct dw9768 *dw9768 = sd_to_dw9768(sd);
 
-	dw9768_release(dw9768);
+	/*
+	 * liuqin: only run the power-down sequence if the chip actually came
+	 * up.  A resume whose init never reached the chip must not send more
+	 * I2C into an unpowered part (each write would just time out).
+	 *
+	 * FIXME(2026-10-05, system-129): this power-down never runs in a
+	 * desktop session - libcamera (wireplumber) opens this node at
+	 * startup and holds it for the whole session - so dw9768_release()
+	 * never parks the lens: it keeps the last DAC (measured: 639 after
+	 * the camera app was closed) and the coil stays energised at that
+	 * position, on top of the rail the board DTS keeps on anyway
+	 * (regulator-always-on, 0022).  Park on stream-stop instead of on
+	 * suspend - see docs/TODO/CAMERA-MAINLINE.md, open items.
+	 */
+	if (dw9768->initialized)
+		dw9768_release(dw9768);
+	dw9768->initialized = false;
+
 	regulator_bulk_disable(ARRAY_SIZE(dw9768_supply_names),
 			       dw9768->supplies);
 
@@ -334,22 +352,45 @@ static int dw9768_runtime_resume(struct device *dev)
 	}
 
 	/*
-	 * The datasheet refers to t_OPR that needs to be waited before sending
-	 * I2C commands after power-up.
+	 * liuqin: the VCM shares the camera module's power.  This rail itself
+	 * is always on, but the module's other supplies are switched by the
+	 * sensor driver, so a resume may find the part unpowered - the
+	 * datasheet's t_OPR alone measured too short over this path.
 	 */
-	usleep_range(DW9768_T_OPR_US, DW9768_T_OPR_US + 100);
+	usleep_range(20000, 21000);
 
+	/*
+	 * liuqin: the VCM sits on the camera module, whose other rails (the
+	 * module's dvdd/avdd and the shared 1.8 V I/O) are switched by the
+	 * sensor driver's runtime PM.  While the module is down this init
+	 * cannot be answered and the CCI times out (-ETIMEDOUT).  Keep that
+	 * failure local: returning it here would set the sticky
+	 * runtime_error and turn every later open of this boot into -EINVAL.
+	 * Report it, stay active, and retry on the next resume - i.e. the
+	 * next open, when the module may be powered (touch the lens while
+	 * the sensor is streaming).
+	 *
+	 * FIXME(2026-10-05, system-129): that next resume never comes while
+	 * the node stays open - an already-active device is not resumed again
+	 * - so the chip stays uninitialized for the whole boot (POR defaults:
+	 * no AAC mode, no PD reset), every suspend skips its park, and only
+	 * direct DAC writes reach the lens once the module is up.  The rail
+	 * is on (always-on by the board DTS) while the module's I/O is down,
+	 * so the powered chip cannot be reached at all: writes time out
+	 * (-ETIMEDOUT) until the sensor streams again.  Retry from the
+	 * sensor's stream-on instead - see docs/TODO/CAMERA-MAINLINE.md,
+	 * open items.
+	 */
 	ret = dw9768_init(dw9768);
-	if (ret < 0)
-		goto disable_regulator;
-
-	return 0;
+	if (ret < 0) {
+		dev_warn(dev, "init failed (%d), retrying on the next resume\n",
+			 ret);
+		return 0;
+	}
 
-disable_regulator:
-	regulator_bulk_disable(ARRAY_SIZE(dw9768_supply_names),
-			       dw9768->supplies);
+	dw9768->initialized = true;
 
-	return ret;
+	return 0;
 }
 
