--- a/drivers/clk/qcom/gcc-sm8450.c
+++ b/drivers/clk/qcom/gcc-sm8450.c
@@ -1376,6 +1376,7 @@ static struct clk_branch gcc_camera_hf_axi_clk = {
 		.enable_reg = 0x36010,
 		.enable_mask = BIT(0),
 		.hw.init = &(struct clk_init_data){
+			.flags = CLK_IGNORE_UNUSED,
 			.name = "gcc_camera_hf_axi_clk",
 			.ops = &clk_branch2_ops,
 		},
@@ -1391,6 +1392,7 @@ static struct clk_branch gcc_camera_sf_axi_clk = {
 		.enable_reg = 0x36018,
 		.enable_mask = BIT(0),
 		.hw.init = &(struct clk_init_data){
+			.flags = CLK_IGNORE_UNUSED,
 			.name = "gcc_camera_sf_axi_clk",
 			.ops = &clk_branch2_ops,
 		},
@@ -3462,6 +3464,19 @@ static int gcc_sm8450_probe(struct platform_device *pdev)
 	/* Keep some clocks always-on */
 	qcom_branch_set_clk_en(regmap, 0x36004); /* GCC_CAMERA_AHB_CLK */
 	qcom_branch_set_clk_en(regmap, 0x36020); /* GCC_CAMERA_XO_CLK */
+	/*
+	 * Camera data path.  The vendor's cam-cpas clock vote enables these two
+	 * before it touches the CPAS/CAMNOC registers (cam-cpas clock-names start
+	 * with gcc_ahb_clk, gcc_axi_hf_clk, gcc_axi_sf_clk).  They are ordinary
+	 * branch clocks with no mainline consumer, so without this they stay
+	 * gated and every camera write master drains into a closed AXI port -
+	 * which is exactly the "frames arrive at 30 fps with an all-zero payload"
+	 * signature on this board.  Kept on only for bring-up.  CLK_IGNORE_UNUSED
+	 * (set on both clk_branch definitions above) is what makes it stick:
+	 * clk_disable_unused() would otherwise switch them back off.
+	 */
+	qcom_branch_set_clk_en(regmap, 0x36010); /* GCC_CAMERA_HF_AXI_CLK */
+	qcom_branch_set_clk_en(regmap, 0x36018); /* GCC_CAMERA_SF_AXI_CLK */
 	qcom_branch_set_clk_en(regmap, 0x37004); /* GCC_DISP_AHB_CLK */
 	qcom_branch_set_clk_en(regmap, 0x3701c); /* GCC_DISP_XO_CLK */
 	qcom_branch_set_clk_en(regmap, 0x81004); /* GCC_GPU_CFG_AHB_CLK */
