A console that keeps the kernel log in DRAM across a reset.

New file, no downstream provenance. On this board the panel is the only
console (no debug UART is brought out) and pstore/ramoops cannot take the job:
the region it needs sits in a Gunyah reserved range that ABL's forced DTBO
overlay references as well, so the kernel ends up with overlapping ramoops
nodes and never creates a ring (liuqin-dualboot/docs/BRINGUP-LOG.md section 55).

bootlog=<addr>,<size> registers a plain CON_PRINTBUFFER console that appends
printk's output into a persistent_ram-style ring ("DBGC", oldest-byte offset,
bytes in use) in reserved DRAM, and cleans every written line out of the
caches so a reset cannot lose the ones written just before a crash. The reader
sits in the bootloader: U-Boot's liuqin_rdump (or tools/liuqin-readlog.py dump
on the host), which is why the layout is ramoops' rather than something new.

It stays out of the earlycon table on purpose: the kernel has exactly one
earlycon slot and the panel wants it (0008's earlycon-simplefb).
CON_PRINTBUFFER gives the same early coverage by replaying the log buffer when
this console registers.

diff -Nur base/drivers/tty/serial/bootlog-console.c work/drivers/tty/serial/bootlog-console.c
--- a/drivers/tty/serial/bootlog-console.c
+++ b/drivers/tty/serial/bootlog-console.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * bootlog: a console that keeps the kernel log in DRAM across a reset.
+ *
+ * Retail phones and tablets rarely bring out the debug UART, so the panel ends
+ * up being the only console and every post-mortem costs a photograph. This
+ * console writes the same text into a ring buffer in reserved DRAM instead,
+ * where it is still there after a reboot: the bootloader dumps it over its own
+ * channel (U-Boot's liuqin_rdump on this board) or the next kernel reads it.
+ *
+ *	bootlog=<addr>,<size>
+ *
+ * The region must be free DRAM. It is reserved with memblock so the allocator
+ * never hands it out, and it is written through the linear mapping with the
+ * touched lines cleaned after every store. That last part is the whole point: a
+ * reset does not clean caches, so a mapping left dirty would lose exactly the
+ * lines written just before the crash - the ones that matter.
+ *
+ * The layout is the one pstore/ramoops uses for its console zone, so existing
+ * readers work unchanged:
+ *
+ *	u32 sig;	"DBGC"
+ *	u32 start;	offset of the oldest byte
+ *	u32 size;	bytes in use
+ *
+ * then the data, which wraps. A valid header is continued rather than
+ * re-initialised, so a run whose log was never collected (booting straight
+ * into the next attempt) leaves the previous run's tail in place.
+ *
+ * This registers a plain console instead of going through the earlycon table on
+ * purpose: the kernel has exactly one earlycon slot (drivers/tty/serial/
+ * earlycon.c: early_con, CON_BOOT) and the panel wants it. CON_PRINTBUFFER
+ * makes printk replay the whole log buffer when this console registers, so the
+ * earliest boot messages land here anyway - earlier, in fact, than the driver
+ * that would print them to a screen.
+ *
+ * Attach a reader that understands the ring; for this board that is
+ *
+ *	fastboot oem run:liuqin_rdump 0x9f000000 0x100000
+ *
+ * in U-Boot, or tools/liuqin-readlog.py dump on the host. The address and size
+ * on that command line and the ones above have to match; the round number is
+ * the only reason this driver takes them as parameters instead of hardcoding.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/string.h>
+#include <asm/cacheflush.h>
+#include <asm/io.h>
+
+#define BOOTLOG_SIG		0x43474244U	/* "DBGC" */
+#define BOOTLOG_HDR_SIZE	12
+#define BOOTLOG_MIN_SIZE	(64 * 1024)
+
+struct bootlog_header {
+	u32 sig;
+	u32 start;
+	u32 size;
+};
+
+static struct bootlog_header *bootlog_hdr;
+static u8 *bootlog_buf;
+static u32 bootlog_len;		/* usable bytes, i.e. size - header */
+static u32 bootlog_pos;		/* where the next byte goes */
+static u32 bootlog_used;	/* bytes in use, capped at bootlog_len */
+static phys_addr_t bootlog_addr;
+static size_t bootlog_size;
+
+/*
+ * Publish the ring state for the reader on the other side of the reset. This
+ * runs on every write, so it stays at two words: the reader scans the data
+ * area for text anyway and only needs to know where the oldest byte is.
+ */
+static void bootlog_publish(void)
+{
+	bootlog_hdr->start = (bootlog_pos + bootlog_len - bootlog_used) %
+			     bootlog_len;
+	bootlog_hdr->size = bootlog_used;
+	dcache_clean_poc((unsigned long)bootlog_hdr,
+			 (unsigned long)bootlog_hdr + sizeof(*bootlog_hdr));
+}
+
+static void bootlog_write(struct console *con, const char *s, unsigned int n)
+{
+	if (!bootlog_buf)
+		return;
+
+	while (n) {
+		unsigned int chunk = min(n, bootlog_len - bootlog_pos);
+
+		memcpy(bootlog_buf + bootlog_pos, s, chunk);
+		dcache_clean_poc((unsigned long)(bootlog_buf + bootlog_pos),
+				 (unsigned long)(bootlog_buf + bootlog_pos +
+						 chunk));
+		bootlog_pos = (bootlog_pos + chunk) % bootlog_len;
+		bootlog_used = min(bootlog_used + chunk, bootlog_len);
+		s += chunk;
+		n -= chunk;
+	}
+
+	bootlog_publish();
+}
+
+static struct console bootlog_console = {
+	.name = "bootlog",
+	.write = bootlog_write,
+	.flags = CON_PRINTBUFFER | CON_ENABLED,
+	.index = -1,
+};
+
+static int __init bootlog_setup(char *str)
+{
+	unsigned long long addr, size;
+
+	if (!str || !*str)
+		return -EINVAL;
+
+	addr = memparse(str, &str);
+	if (*str != ',')
+		return -EINVAL;
+	size = memparse(str + 1, &str);
+
+	if (size < BOOTLOG_MIN_SIZE || !IS_ALIGNED(addr, PAGE_SIZE) ||
+	    !IS_ALIGNED(size, PAGE_SIZE)) {
+		pr_err("bootlog: bad geometry %#llx,%#llx\n", addr, size);
+		return -EINVAL;
+	}
+
+
+	/* early_param runs before the arm64 linear map exists. */
+	bootlog_addr = addr;
+	bootlog_size = size;
+	return 0;
+
+}
+early_param("bootlog", bootlog_setup);
+
+static int __init bootlog_init(void)
+{
+	if (!bootlog_size)
+		return 0;
+
+	/* Paging is established by this initcall level. */
+	if (memblock_is_region_reserved(bootlog_addr, bootlog_size)) {
+		pr_err("bootlog: %#llx+%#zx is already reserved\n",
+		       (unsigned long long)bootlog_addr, bootlog_size);
+		return -EBUSY;
+	}
+	if (memblock_reserve(bootlog_addr, bootlog_size))
+		return -EBUSY;
+
+	bootlog_hdr = __va(bootlog_addr);
+	bootlog_buf = (u8 *)bootlog_hdr + BOOTLOG_HDR_SIZE;
+	bootlog_len = bootlog_size - BOOTLOG_HDR_SIZE;
+	if (bootlog_hdr->sig == BOOTLOG_SIG &&
+	    bootlog_hdr->size <= bootlog_len &&
+	    bootlog_hdr->start < bootlog_len) {
+		bootlog_used = bootlog_hdr->size;
+		bootlog_pos = (bootlog_hdr->start + bootlog_used) % bootlog_len;
+	} else {
+		bootlog_hdr->sig = BOOTLOG_SIG;
+		bootlog_pos = 0;
+		bootlog_used = 0;
+	}
+	bootlog_publish();
+	register_console(&bootlog_console);
+	return 0;
+}
+postcore_initcall(bootlog_init);
diff -Nur base/drivers/tty/serial/Kconfig work/drivers/tty/serial/Kconfig
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -97,6 +97,21 @@
 	  anything before fbcon takes over at device_initcall, by which point
 	  the RPMh, clock and SoC drivers have already run.
 
+config BOOTLOG_CONSOLE
+	bool "Console that keeps the kernel log in DRAM across a reset"
+	help
+	  Register a console that appends everything printk writes into a ring
+	  buffer in reserved DRAM, so a boot that dies without a readable console
+	  (no debug UART, a panel that never lights up, ...) still leaves its log
+	  behind for the next boot to collect - a bootloader dumping the region,
+	  or the next kernel. Enable it with "bootlog=<addr>,<size>" on the
+	  kernel command line, where the region is free DRAM that nothing else
+	  has claimed; it is reserved with memblock. The layout is the one
+	  pstore/ramoops uses for its console zone.
+
+	  The lines written on the way down are cleaned out of the caches as they
+	  are written, so a reset cannot lose them.
+
 config SERIAL_EARLYCON_SEMIHOST
 	bool "Early console using Arm compatible semihosting"
 	depends on ARM64 || ARM || RISCV
diff -Nur base/drivers/tty/serial/Makefile work/drivers/tty/serial/Makefile
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -10,6 +10,7 @@
 obj-$(CONFIG_SERIAL_EARLYCON_SEMIHOST) += earlycon-semihost.o
 obj-$(CONFIG_SERIAL_EARLYCON_SIMPLEFB) += earlycon-simplefb.o
 obj-$(CONFIG_SERIAL_EARLYCON_RISCV_SBI) += earlycon-riscv-sbi.o
+obj-$(CONFIG_BOOTLOG_CONSOLE) += bootlog-console.o
 
 # These Sparc drivers have to appear before others such as 8250
 # which share ttySx minor node space.  Otherwise console device
