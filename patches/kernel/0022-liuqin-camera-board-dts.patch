+		vdda-phy-supply = <&pm8350_l5>;
+		vdda-pll-supply = <&pm8350c_l10>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 { reg = <0>; };
+			port@1 { reg = <1>; };
+			port@2 { reg = <2>; };
+			port@3 { reg = <3>; };
+			port@4 { reg = <4>; };
+			port@5 { reg = <5>; };
+		};
+	};
+};
