+/*
+ * SM8475 (Waipio) camera subsystem.  The CSID/VFE blocks are the 680
+ * generation also used by X1E.  Keep this table separate from X1E: the
+ * instance count, register layout and clock names are board-visible and
+ * must not be inferred from a different SoC.
+ *
+ * The CSIPHY lane programming is the vendor's own 2.1.3 table, recovered from
+ * the shipped camera.ko (csiphy_2ph_v2_1_3_reg) and stored as
+ * lane_regs_sm8475 in camss-csiphy-3ph-1-0.c.  It replaces an earlier bring-up
+ * assumption that reused the 2.1.2 table: the vendor sequences in fact match
+ * upstream x1e80100's table, whose skew-calibration records the driver skips.
+ */
+#define SM8475_CSIPHY(_n) { \
+	.regulators = { \
+		{ .supply = "vdda-phy", .init_load_uA = 88000 }, \
+		{ .supply = "vdda-pll", .init_load_uA = 17800 }, \
+	}, \
+	.clock = { "csiphy" #_n, "csiphy" #_n "_timer" }, \
+	.clock_rate = { { 400000000, 480000000 }, { 400000000 } }, \
+	.reg = { "csiphy" #_n }, .interrupt = { "csiphy" #_n }, \
+	.csiphy = { .id = _n, .hw_ops = &csiphy_ops_3ph_1_0, \
+		.formats = &csiphy_formats_sdm845 }, \
+}
+
+static const struct camss_subdev_resources csiphy_res_sm8475[] = {
+	SM8475_CSIPHY(0), SM8475_CSIPHY(1), SM8475_CSIPHY(2),
+	SM8475_CSIPHY(3), SM8475_CSIPHY(4), SM8475_CSIPHY(5),
+};
+
+#define SM8475_CSID(_n) { \
+	.clock = { "csid", "csiphy_rx" }, \
+	.clock_rate = { { 400000000, 480000000 }, \
+			{ 400000000, 480000000 } }, \
+	.reg = { "csid" #_n }, .interrupt = { "csid" #_n }, \
+	.csid = { .parent_dev_ops = &vfe_parent_dev_ops, \
+		.hw_ops = &csid_ops_680, .formats = &csid_formats_gen2 }, \
+}
+
+static const struct camss_subdev_resources csid_res_sm8475[] = {
+	SM8475_CSID(0), SM8475_CSID(1), SM8475_CSID(2),
+};
+
+#define SM8475_VFE(_n, _lite) { \
+	.clock = { "camnoc_rt_axi", "camnoc_nrt_axi", "cpas_ahb", \
+			   "cpas_fast_ahb", _lite ? "cpas_ife_lite" : "cpas_vfe" #_n, \
+			   _lite ? "vfe_lite_ahb" : "vfe" #_n "_fast_ahb", \
+			   _lite ? "vfe_lite" : "vfe" #_n }, \
+	.clock_rate = { { 400000000 }, { 0 }, { 0 }, { 0 }, { 0 }, \
+			{ 266666667, 400000000, 480000000 }, \
+			{ 266666667, 400000000, 480000000 } }, \
+	.reg = { _lite ? "vfe_lite" #_n : "vfe" #_n }, \
+	.interrupt = { _lite ? "vfe_lite" #_n : "vfe" #_n }, \
+	.vfe = { .line_num = 4, .is_lite = _lite, \
+		.has_pd = !_lite, .pd_name = _lite ? NULL : "ife" #_n, \
+		.hw_ops = &vfe_ops_680, .formats_rdi = &vfe_formats_rdi_845, \
+		.formats_pix = &vfe_formats_pix_845 }, \
+}
