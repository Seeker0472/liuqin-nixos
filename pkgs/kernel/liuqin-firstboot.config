# SM8475 board pin control is not selected by the generic arm64 defconfig.

# The eUSB2 repeater is attached to a GENI I2C controller using GPI DMA.
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y

# UFS must be available before the initramfs can perform a read-only probe.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_PCIE=y
# CONFIG_PHY_QCOM_QMP_PCIE_8996 is not set
CONFIG_PHY_QCOM_QMP_UFS=y
# CONFIG_PHY_QCOM_QMP_USB is not set
# CONFIG_PHY_QCOM_QMP_USB_LEGACY is not set
CONFIG_SCSI_UFS_QCOM=y

# PCIe0 carries the QCA6490 WLAN function. The endpoint is powered before bus
# enumeration by a platform device instantiated from wifi@0; that driver asks
# the already-validated WCN6855 power sequencer for its "wlan" target and only
# then tells PCI core the slot is ready. All three pieces must be built in:
# modules are unavailable in this RAM image, and without pwrctrl the endpoint
# remains behind an asserted wlan-enable line and cannot enumerate.
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y

# PCI pwrctrl is intentionally hidden and is selected by ATH11K_PCI; it cannot
# be promoted to built-in on its own. Pull the wireless/MHI/QRTR dependency
# chain in as built-ins so the pre-enumeration power consumer is reachable.
# Runtime firmware is supplied by the stage-1 image because ath11k probes before
# switch_root; the same pinned files are also present in the stage-2 rootfs.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH11K=y
# CONFIG_ATH11K_AHB is not set
CONFIG_ATH11K_PCI=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
# ADSP/CDSP/SLPI expose their service-registry notifier over RPMsg IPCRTR.
# With no module tree, QRTR_SMD=m leaves all three endpoints unbound and PDR
# can never observe audio_pd even after the local PD mapper is available.
CONFIG_QRTR_SMD=y

# The ADSP, CDSP and SLPI firmware is authenticated and started through PAS.
# Promote the complete GLINK/sysmon dependency chain: all three remoteprocs
# probe before switch_root and there is no module tree in the RAM image.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y

# GPR defers every service carrying qcom,protection-domain until a SERVREG
# locator maps it to a live DSP protection domain. This RAM image has neither
# a module tree nor a userspace pd-mapper, so the in-kernel SM8475 mapping must
# be built in; otherwise avs/audio never creates q6apm/q6apmbedai even though
# adsp_apps itself is online.
CONFIG_QCOM_PD_MAPPER=y

# The charger service now running on ADSP exposes standard PMIC GLINK battery
# and UCSI clients. Keep every link built in; this first step is observational
# and intentionally leaves the validated DWC3 peripheral role wiring unchanged.
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_DRM_MSM_DP=y

# USB2 peripheral networking must work without loading external modules.
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# Keep the bootloader-provided framebuffer usable before the DSI driver exists.
CONFIG_FB_SIMPLE=y

# The early simplefb console is the tty fallback until the DSI panel is ready.
# There is no accessible debug UART on a retail unit, so this is also the only
# usable console while the live installer is bringing up its root.

# The only way to read that panel is a camera pointed at 300 ppi, where an 8x16
# glyph is under a millimetre tall. Terminus 16x32 doubles it for free; the
# earlycon asks for it by name and falls back to 8x16 if it is absent.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# The whole rootfs lives in RAM: a squashfs carried inside the initramfs is the
# read-only lower layer, a tmpfs is the writable upper one, and overlayfs joins
# them. Both have to be built in. arm64 defconfig leaves overlayfs modular, and
# the live image must not depend on a late module load to switch_root. zstd is
# what sqfstar packs the image with;
# SQUASHFS_ZLIB alone mounts nothing.
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS_ZSTD=y

# The GNOME root brings a second squashfs consumer with different taste in
# compressors: snapd mounts one image per snap, and Canonical packs those with
# xz and lzo, not zstd. Without these the desktop still boots -- every snap
# mount unit just fails, taking Firefox, Thunderbird, the snap store and the
# gnome-46-2404 platform with it, and the only clue is "Filesystem uses \"xz\"
# compression. This is not supported" in the kernel log. Built in for the same
# reason as everything else here: this kernel has no module tree to load from.
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y

# The Novatek NT36532 touchscreen is an SPI device on QUPv3 wrapper 0's SE4.
# arm64 defconfig leaves the GENI SPI controller modular, which is the same trap
# overlayfs fell into just above: no module tree exists anywhere in this image,
# so =m means the bus never registers, the touchscreen never probes, and nothing
# in dmesg says why. Both halves have to be built in.
CONFIG_SPI=y
CONFIG_SPI_QCOM_GENI=y

# The NT36532 is a no-flash part: it has no on-chip firmware storage, so the
# host downloads the firmware into its SRAM on every boot and every resume, and
# request_firmware() is on the critical path rather than an optimization. The
# blob ships as a file in the initramfs and again in the rootfs -- never through
# CONFIG_EXTRA_FIRMWARE, which would link a proprietary binary into vmlinux.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y

# The driver registers an input device; evdev is what turns that into the
# /dev/input/eventN a shell can actually read, and it is the only way to observe
# the touchscreen on a tablet with no display stack yet.
CONFIG_INPUT_EVDEV=y

# Display. The panel is a dual-DSI Novatek NT36532 driving 1800x2880 at 120 Hz
# over DSC 1.1, so the chain that has to exist is dispcc -> mdss -> dpu ->
# two DSI hosts and 5nm PHYs -> the panel driver -> the KTZ8866 backlight on
# i2c1. Every one of them is =y for the reason the rest of this file keeps
# repeating: the image has no module tree, so =m is indistinguishable from
# "not set".
#
# This block replaces the "# CONFIG_DRM is not set" that stood here through
# first boot. That line existed because the built-in touch driver calls
# drm_is_panel_follower() and devm_drm_panel_add_follower(), which live in
# drm.ko when CONFIG_DRM=m, and a built-in driver cannot link against a module:
#
#   ld: nt36xxx.o: in function `nvt_ts_probe':
#       undefined reference to `drm_is_panel_follower'
#
# CONFIG_DRM=y fixes that the other way round and the touch driver's behaviour
# does not change. CONFIG_DRM_PANEL is select-ed by DRM_MSM_KMS, so
# drm_panel.o (drivers/gpu/drm/Makefile:82) is linked into vmlinux and both
# symbols are the real EXPORT_SYMBOL functions. drm_is_panel_follower() is
# nothing but device_property_present(dev, "panel")
# (drivers/gpu/drm/drm_panel.c:526-534), and touchscreen@0 in the board DTS
# carries no "panel" property, so nt36xxx.c:1323 still takes the else-branch
# that sets panel_on = true and never waits on a panel. Its Kconfig dependency
# "depends on DRM || DRM = n" (drivers/input/touchscreen/nt36523/Kconfig:6) is
# satisfied by the DRM=y branch rather than the DRM=n one.
CONFIG_DRM=y

# DRM_MSM is "depends on QCOM_LLCC || QCOM_LLCC=n" and the same for QCOM_OCMEM
# (drivers/gpu/drm/msm/Kconfig). A tristate dependency caps the dependent
# symbol at the dependency's own level, so arm64 defconfig's =m for either one
# silently pins CONFIG_DRM_MSM at =m no matter what this fragment asks for --
# which in an image with no module tree means no display driver at all. Both
# are =m -> =y conversions and nothing else. LLCC is real hardware here (the
# SM8450 system cache, which msm uses for UBWC); OCMEM is msm8974-era and will
# never match a node on this SoC, but it still has to be y or n rather than m.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y

# Adreno/GMU depend on the SM8450-family GPU clock controller. Defconfig leaves
# it modular; enabling the GPU with no module tree otherwise defers until the
# timeout and takes the entire MSM DRM component bind down with it.
CONFIG_SM_GPUCC_8450=y

CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y

# 5nm is what sm8450.dtsi calls the DSI PHY at ae94400/ae96400; the 7nm driver
# is the one that covers 7/5/4nm (drivers/gpu/drm/msm/Kconfig, DRM_MSM_DSI_7NM_PHY).
CONFIG_DRM_MSM_DSI_7NM_PHY=y

# Pinned rather than left to select/default so that the fragment survival check
# in tools/build-liuqin-firstboot.sh fails loudly if a future defconfig moves
# any of them back to =m. DRM_MSM select-s the helpers, DRM_MSM_DPU select-s
# the DSC helper, DRM_MSM select-s QCOM_MDT_LOADER on ARCH_QCOM.
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_QCOM_MDT_LOADER=y

# The panel is this board's only early failure channel, so the installed system
# must own it with something that can show a full terminal - the same choice,
# and the same measurement, as the RAM installer (pkgs/kernel/installer.config):
# with the "log" DRM client the panel is seized by a client that only renders
# the kernel log and implements no terminal; at NixOS' default loglevel=4 it
# clears the screen and has nothing to print, so a boot that is perfectly
# healthy looks like a dead panel (measured on the unit: panel probe, both DSI
# links and the backlight fine, /sys/class/graphics has no fb device, and the
# compositor's buffers never reach the panel).  "fbdev" lets fbcon bind on top
# of the DRM driver, so console=tty0 gives the kernel log and a getty on the
# panel, and mutter can take DRM master from it normally afterwards.  The
# earlier E16 note that MSM's fbdev never commits an atomic modeset is stale:
# the installer boots this very kernel with fbdev and paints its log on the
# panel.  The choice can still be overridden at runtime with
# drm_client_lib.active=log.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_LOG=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y

# The display clock controller. dispcc-sm8450.c matches "qcom,sm8475-dispcc"
# natively (drivers/clk/qcom/dispcc-sm8450.c:1794) and swaps PLL0/PLL1 to
# LUCID_OLE for it, so no fork patch is involved.
CONFIG_SM_DISPCC_8450=y

# The panel itself. "xiaomi,pipa-nt36532" is reused as-is: its mode, porches,
# DSC parameters and physical size match this unit's m81_42_02_0b field for
# field, and its init sequence matches the vendor blob's 194 commands in 183
# places. See docs/DISPLAY_RECON.zh-CN.md.

# Backlight. The panel driver's drm_panel_of_backlight() returns -EPROBE_DEFER
# until this device exists, so an =m here would wedge the panel in permanent
# probe deferral rather than merely lose the brightness control.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y

# The simple-framebuffer driver enabled near the top of this file is
# "depends on !DRM_SIMPLEDRM" (drivers/video/fbdev/Kconfig), so turning DRM on
# puts it at the mercy of a symbol that was unreachable until now. In this
# tree DRM_SIMPLEDRM carries no
# "default" (drivers/gpu/drm/sysfb/Kconfig:41) and arm64 defconfig does not name
# it, so it resolves to n on its own -- but it is spelled out here so the
# survival check enforces it instead of trusting that. simpledrm is unwanted in
# any case: it would bind the same bootloader framebuffer that msm_kms.c:274
# then evicts through aperture_remove_all_conflicting_devices().
# CONFIG_DRM_SIMPLEDRM is not set

# Bluetooth on the QCA6490. The HCI transport is a 4-wire UART on uart20, so the
# path is serdev -> hci_uart -> the qca protocol -> btqca, plus the power
# sequencer that owns the chip's enable lines and shared rails.
#
# Everything here is a =m -> =y conversion and nothing else: arm64 defconfig
# already builds all of it, just as modules, and this image has no module tree
# to load them from -- the same trap CONFIG_OVERLAY_FS and CONFIG_SPI_QCOM_GENI
# fell into above. The pieces that were already =y need no help:
# CONFIG_BT_HCIUART_QCA, CONFIG_BT_HCIUART_SERDEV, CONFIG_SERIAL_DEV_BUS,
# CONFIG_SERIAL_DEV_CTRL_TTYPORT and CONFIG_SERIAL_QCOM_GENI (the GENI serial
# driver, which uart20 needs as a plain port -- the console half of it,
# CONFIG_SERIAL_QCOM_GENI_CONSOLE, is separate and irrelevant on a unit whose
# debug UART is not brought out).
#
# CONFIG_RFKILL has to come along even though nothing here toggles a kill
# switch: CONFIG_BT is "depends on RFKILL || !RFKILL", so leaving rfkill modular
# caps Bluetooth at =m no matter what this fragment asks for. CONFIG_BT_QCA is
# select-ed by CONFIG_BT_HCIUART_QCA and would follow on its own; it is spelled
# out so that the survival check covers it.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART_QCA=y

# BlueZ's userspace HID profile presents keyboards through /dev/uhid.  This
# image has no module tree, so the otherwise-default-n UHID transport must be
# built in rather than left unavailable at runtime.
CONFIG_UHID=y

# Bluetooth keyboards commonly use the LE HoG profile.  arm64 defconfig leaves
# this optional bool disabled in the exact product build, so make the protocol
# support explicit rather than inferring it from a dual-mode controller.
CONFIG_BT_LE=y

# The audio card is a real built-in graph: four CS35L41 speaker amplifiers on
# tertiary TDM plus the WCD9385 RX/TX codec and LPASS RX/TX/VA macros on
# SoundWire.  The AudioReach topology and the CS35L41 protection payloads are
# shipped by pkgs/firmware.nix, not by the kernel.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_CS35L41_I2C=y

# SC8280XP is the machine driver that matches qcom,sm8450-sndcard.  Promote
# its SoundWire master and WCD9385/LPASS macro components as well: this image
# deliberately has no module tree, and a modular dependency would leave the
# card without a codec or capture DAI during the early boot.
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_QCOM_APR=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_LPASS_MACRO_COMMON=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y

# The QCA6490 powers its Bluetooth and WLAN sides from one sequence of shared
# rails and enable GPIOs, described by the wcn6855-pmu node in the board DTS.
# hci_qca acquires it through the power-sequencing core, so both halves must be
# built in or the Bluetooth node never gets past its pwrseq lookup.
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y

# Power management. The tablet cannot charge from a host USB port while it is
# running: the SDP ceiling is 500 mA (2.5 W) and idle draw exceeds it, so the
# battery discharges with the charger attached. Some of that is
# clk_ignore_unused/pd_ignore_unused in the command line keeping every clock and
# power domain alive; the rest is that nothing here was ever tuned for idle.
#
# QCOM_STATS is the instrument, not a tweak: it exports the RPMh sleep counters
# through debugfs, which is the only direct way to see whether the SoC ever
# entered AOSD/CXSD at all. Diagnosing idle draw without it is guesswork. It
# ships modular in defconfig and this image has no module tree, so =m means
# absent.
CONFIG_QCOM_STATS=y

# TEO picks idle states from timer deadlines rather than the menu governor's
# heuristics, and is the better default on anything battery-powered. Both are
# built in; the governor is chosen at runtime.
CONFIG_CPU_IDLE_GOV_TEO=y

# powersave and conservative are modular in defconfig, which in an image with
# no module tree means they simply do not exist -- an attempt to select either
# at runtime fails with no explanation. Capping scaling_max_freq was the only
# lever available during this session's charging investigation because of it.
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# The PMIC RTC is modular in defconfig, which in an image with no module tree
# means the board has no real-time clock at all. Without it the kernel starts
# from the epoch and userspace shows whatever systemd can salvage from
# filesystem timestamps -- the tablet was reporting April while the host said
# August. Wrong wall-clock time is not cosmetic on a desktop: TLS certificate
# validation, apt metadata freshness and every log timestamp depend on it.
CONFIG_RTC_DRV_PM8XXX=y

# The power key and volume-down key are dead in every image built so far, and
# the pwrkey driver is not why: CONFIG_INPUT_PM8941_PWRKEY is already =y in
# arm64 defconfig, pm8941_pwrkey_driver_init runs on the device, and it matches
# both qcom,pmk8350-pwrkey and qcom,pmk8350-resin. It simply never gets a
# device to bind to. /dev/input has only the touchscreen, the pen and gpio-keys
# -- no pmic_pwrkey, no pmic_resin.
#
# The missing link is one level up. pon_pwrkey and pon_resin are children of
# pmk8350_pon (pmk8350.dtsi pon@1300, both enabled by the board DTS since its
# first revision), and the only driver that matches qcom,pmk8350-pon is
# drivers/power/reset/qcom-pon.c, whose probe ends in
# devm_of_platform_populate(). That call is what creates the two child platform
# devices. It is modular in defconfig, which in an image with no module tree
# means pon@1300 never probes, the children are never instantiated, and a
# built-in pwrkey driver waits forever for hardware that was never registered.
#
# Safe to force on: on gen3 PON the pwrkey driver sets
# supports_ps_hold_poff_config = false, so it registers input devices and
# nothing else -- no reset handler, no change to shutdown behaviour. qcom-pon's
# own reboot-mode registration finds no mode-* properties on pon@1300 and its
# notifier becomes inert; the board's reboot magic still goes through the
# separate nvmem-reboot-mode node. REBOOT_MODE, which it selects, is already =y.
#
# The pwrkey line below fixes nothing on its own. It is here so that the
# fragment check turns "defconfig happens to set this" into an invariant this
# build asserts, next to the line that actually makes it reachable.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_INPUT_PM8941_PWRKEY=y

# Patch-introduced / non-assignable for the generator, but the postConfigure
# hook appends this file straight to the generated .config, where olddefconfig
# resolves it - so these must live here rather than in structuredExtraConfig.
CONFIG_DRM_PANEL_NOVATEK_NT36532=y
CONFIG_FB_SIMPLE=y

CONFIG_TOUCHSCREEN_NT36523_SPI=y

# NixOS 26.11 ships /etc as an EROFS metadata image plus an overlay, mounted by
# stage 1 on every boot (initrd and installed system alike). The image is
# uncompressed, but without the filesystem the mount unit fails and the initrd
# stops in emergency mode before switch_root - i.e. no live system and no USB
# channel. ZIP support is included so a compressed image keeps working.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# NixOS enables zramSwap by default and systemd-zram-setup@zram0 asks modprobe
# for the device; without CONFIG_ZRAM the unit waits out the full device
# timeout before the boot continues and the tablet has no swap at all
# (measured: dev-zram0.device timed out after 90 s on the first boot).  Keep it
# a module: zram-generator modprobes zram with num_devices=1, which a built-in
# driver never sees.  zram-generator.conf picks zstd (NixOS' default), so that
# backend has to be inside the module.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y

# NixOS' firewall is the iptables client on the nftables backend (measured on
# the device: "iptables v1.8.13 (nf_tables)").  Without NF_TABLES in the kernel
# firewall.service dies with "iptables: Failed to initialize nft: Protocol not
# supported" and the device boots with **no firewall at all** - nothing says so
# beyond one failed unit.  With nf_tables present the next failure is the rules
# that have no native nf_tables expression: iptables emulates those through
# nft_compat, which loads the matching xt module, so the modules must exist.
# Measured on the device with only NF_TABLES enabled:
#   Warning: Extension pkttype revision 0 not supported, missing kernel module?
#   iptables v1.8.13 (nf_tables): RULE_APPEND failed (No such file or
#     directory): rule in chain nixos-fw-log-refuse
#   firewall.service: Main process exited, code=exited, status=4/NOPERMISSION
# i.e. a partially applied ruleset.  The set below is what the NixOS ruleset in
# nixpkgs' firewall-iptables.nix resolves to on a known-good NixOS host (where
# the same script works): lsmod there has xt_pkttype, xt_conntrack,
# ipt_rpfilter, ip6t_rpfilter, xt_tcpudp, nft_compat and nf_tables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NFT_COMPAT=m
# -m pkttype (the "! --pkt-type unicast" rule in nixos-fw-log-refuse)
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
# -m conntrack --ctstate ESTABLISHED,RELATED
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
# -m rpfilter --validmark --loose (the mangle PREROUTING anti-spoof chain).
# ipt_rpfilter/ip6t_rpfilter depend on x_tables only (modinfo -F depends), and
# their Kconfig accepts NFT_COMPAT in place of the legacy IP_NF_MANGLE/
# IP_NF_RAW, so the ip_tables machinery does not come along.
CONFIG_IP_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
# nft expressions the ruleset uses directly: ct state, limit, log, reject, fib,
# plus the nat chains the script only cleans up (guarded with "|| true").
# (counter/last are part of nf_tables core, so there is no symbol for them.)
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
# CONFIG_NFT_FIB itself has no prompt (the family helpers select it), so the
# user-settable symbols are the ones listed here.
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m

# Docker's overlay networks (docker network create --driver overlay, swarm
# mode) tunnel container traffic with VXLAN, which the generated .config
# carried as "not set" while the rest of its requirements were already
# present: bridge/veth/br_netfilter and the built-in overlayfs, the nft
# nat/masq set above, and cgroups/namespaces/seccomp.  Keep this a module:
# nothing outside the container stack needs it.
CONFIG_VXLAN=m

# Docker's iptables client is iptables-nft - upstream 7.x keeps the legacy
# backend behind IP_NF_IPTABLES_LEGACY, which is off, and nixpkgs' iptables
# is built with the nft backend - so every target iptables has no native nft
# expression for is emulated through nft_compat, which fails unless the
# module registering the xt target exists.  The nft nat/masq set above does
# not cover that: it serves rules written as native nft expressions (the
# NixOS firewall), while dockerd's rules take the nft_compat path.
# Measured on Hippogriff 2026-10-10, dockerd 29.8.1, with these two absent -
# the daemon could not start at all:
#   Warning: Extension MASQUERADE revision 0 not supported, missing kernel module?
#   iptables v1.8.13 (nf_tables): RULE_INSERT failed (No such file or
#     directory): rule in chain POSTROUTING
#   failed to start daemon: Error initializing network controller: error
#     creating default "bridge" network: Failed to Setup IP tables: Unable to
#     enable NAT rule: iptables --wait -t nat -I POSTROUTING -s 172.17.0.0/16
#     ! -o docker0 -j MASQUERADE
# A stock x86_64 NixOS host running the same dockerd loads exactly these two
# more (xt_addrtype, xt_conntrack, xt_tcpudp, nft_compat and nf_nat are
# already in).  MASQUERADE revision 0 for IPv4 - the revision the rule above
# asks for - is this kernel's xt_MASQUERADE registration
# (nf_nat_ipv4_multi_range_compat target size); xt_nat carries SNAT/DNAT
# revisions 0/1/2 for published ports.  Both autoload under the aliases
# iptables requests (ipt_MASQUERADE, ipt_SNAT/ipt_DNAT).
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m

# TCP congestion control for lossy paths.  The tablet's traffic is mostly
# WiFi/cellular, where loss is often not congestion; cubic treats every loss
# as a congestion signal and collapses its window, while BBR keeps an
# explicit bandwidth/RTT model and tolerates loss and delay unrelated to
# congestion.  Without TCP_CONG_ADVANCED the tree offers only cubic (the
# arm64 defconfig leaves it off), so the menu has to be opened before BBR
# exists as an answer.  BBR is documented to require the fq pacing qdisc,
# which 7.2.5 does not select for it (net/ipv4/Kconfig carries only the
# sentence in the help text), so fq is answered here too - otherwise the
# runtime net.core.default_qdisc=fq that nixos-config sets has no
# implementation to load.  Both stay =m to match the other hosts, which load
# tcp_bbr through boot.kernelModules; sch_fq autoloads when the qdisc is
# requested.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m

# Runtime feature completion (2026-10-11): answers nixpkgs common-config
# carries, that this device's own services or removable media actually use.
# Each was checked against the running tablet before being answered here.

# Policy routing (RPDB).  mihomo's TUN auto-route and netbird's route manager
# both work through custom routing tables plus ip rule.  Measured on
# Hippogriff 2026-10-11:
#   mihomo[2061]: level=error msg="Start TUN listening error: configure tun
#     interface: cleanup rules: operation not supported"
#   $ ip rule show  ->  RTNETLINK answers: Operation not supported
# i.e. the tun.enable=true inbound died at startup and /sys/class/net had no
# Meta.  The desktop host, same nixos-config, carries table 2022 and rules
# 9000-9010 from the same mihomo binary.  IP_ADVANCED_ROUTER is the parent
# IP_MULTIPLE_TABLES hides behind; FIB_RULES arrives via select.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# cpu.max (cgroup v2 bandwidth) is CFS_BANDWIDTH: docker --cpus / compose
# cpus: and systemd's CPUQuota= need it.  Measured: no cpu.max under
# /sys/fs/cgroup on the tablet, while a stock NixOS host has it.
CONFIG_CFS_BANDWIDTH=y

# NixOS boots every host with lsm=landlock,yama,bpf; none of the three was
# compiled in here. Without Yama the Firefox/Zen content sandbox downgrades
# (about:support reports no ptrace restrictions). RestrictFileSystems= needs
# Landlock plus systemd's BPF LSM program; that program needs vmlinux BTF and
# FUNCTION_TRACER for the LSM trampoline. Measured before the complete set:
# /proc/sys/kernel/yama/ptrace_scope was absent; with BPF_LSM but no
# DEBUG_INFO_BTF, systemd 261 logged `Failed to load BPF object: No such
# process`; with BTF but no FUNCTION_TRACER it logged `Failed to link program`.
# BTF rejects DEBUG_INFO_REDUCED, so keep full DWARF during the build; the
# installed kernel output is stripped separately by the Nix build.
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_BPF_LSM=y
CONFIG_FUNCTION_TRACER=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y

# Removable media.  udisksd mounts through the kernel drivers with its own
# compiled-in option sets (exfat_defaults=...,iocharset=utf8, ntfs:ntfs3 the
# same shape), and /proc/filesystems carried only vfat.  F2FS covers SD cards
# and data partitions.  vfat itself needs nothing extra: the 7.2.5 fat driver
# handles utf8=1 natively (fs/fat/namei_vfat.c), NLS_UTF8 is only for
# explicit iocharset=utf8 mounts.
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_F2FS_FS=m
CONFIG_CIFS=m
CONFIG_NLS_UTF8=m

# The rest of the common-config set worth carrying here: UDMABUF (PipeWire /
# portal screencast dmabuf path), MPTCP (WiFi/cellular path mixing), BINFMT_MISC
# (qemu-user), HID battery reporting (Bluetooth peripherals' charge in GNOME),
# the joystick core, generic USB serial (adapters), fbcon rotation, the
# squashfs variants other images use, and the zram compression backends a zram
# configuration may request.
CONFIG_UDMABUF=y
CONFIG_MPTCP=y
CONFIG_BINFMT_MISC=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_MULTI_COMP=y
# iotop: TASKSTATS/TASK_XACCT are already on, only delay accounting is not.
CONFIG_TASK_DELAY_ACCT=y

# Kernel hardening from common-config this port did not carry: usercopy, slab
# freelist, init-on-alloc, allocator shuffle, list hardening, fortify, dmesg
# restriction, and the cheap corruption/scheduling checks.  Costs are small
# and were accepted deliberately to match a stock NixOS kernel.
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_KFENCE=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SCHED_STACK_END_CHECK=y

# Transparent huge pages: the device config carried ALWAYS, nixpkgs defaults
# to MADVISE.  Always-on THP buys little on a 12 GiB tablet and costs memory
# bloat plus tail latency, so follow the madvise default.
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Debug batch (2026-10-05): live kernel log + on-device tracing.
# netconsole: console output over UDP (runtime-configurable through configfs),
# so a freeze keeps its log on the wire instead of taking it to the reset.
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
# kprobes + tracers: inspect the running kernel without another rebuild (the
# technique the Android oracle sessions use).  CONFIG_DYNAMIC_DEBUG was part of
# the same batch and is deliberately not set any more: the callsite table costs
# memory in every boot and the bring-up sessions it served are over.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
