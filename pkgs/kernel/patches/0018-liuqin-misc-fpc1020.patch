+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * FPC1264 fingerprint sensor power/reset/IRQ control for the Xiaomi Pad 6
+ * Pro (liuqin).
+ *
+ * The sensor's SPI bus belongs to the secure world: the OEM fpcliu trusted
+ * application drives it over QSEE's SPI service (qsee_spi_*), and the stock
+ * kernel keeps spi@a88000 disabled for that reason.  The normal world only
+ * has to power the sensor, pulse its reset line and report the finger
+ * interrupt, which is what this driver does; it deliberately performs no
+ * SPI transfers.
+ *
+ * Userspace contract: /dev/fpc1020.  The first open powers the sensor, poll()
+ * reports the finger interrupt, the last close powers it down.  The
+ * electrical sequence (PM8350C LDO9 at 100 mA, GPIO41 reset pulse, GPIO40
+ * rising-edge interrupt) follows the vendor driver in the stock 5.10 tree,
+ * drivers/input/fingerprint/fpc_ta/fpc1020_tee.c.
+ */
+
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/ioctl.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeup.h>
+#include <linux/poll.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/wait.h>
+
+#define FPC1020_NAME			"fpc1020"
+#define FPC1020_TTW_HOLD_MS		2000
+#define FPC1020_PWR_ON_SLEEP_US		1000
+
+#define FPC1020_IOC_MAGIC		'f'
+#define FPC1020_IOC_RESET		_IO(FPC1020_IOC_MAGIC, 1)
+
+struct fpc1020 {
+	struct device *dev;
+	struct miscdevice miscdev;
+	struct regulator *vreg;
+	struct gpio_desc *reset_gpio;
+	int irq;
+	struct mutex lock;		/* serialises power transitions and ioctls */
+	unsigned int users;
+	bool prepared;
+	atomic_t irq_count;		/* consumed by poll() */
+	wait_queue_head_t irq_wait;
+};
+
+static irqreturn_t fpc1020_irq_handler(int irq, void *data)
+{
+	struct fpc1020 *fpc = data;
+
+	atomic_inc(&fpc->irq_count);
+	wake_up_interruptible(&fpc->irq_wait);
+	pm_wakeup_event(fpc->dev, FPC1020_TTW_HOLD_MS);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Vendor sequence (fpc1020_tee.c, hw_reset()): release, 100 us, assert,
+ * 5 ms, release, 5 ms.  The secure world performs the sensor's own soft
+ * reset afterwards, once it starts talking over SPI.
+ */
+static void fpc1020_reset_pulse(struct fpc1020 *fpc)
+{
+	gpiod_set_value_cansleep(fpc->reset_gpio, 0);
+	usleep_range(100, 200);
+	gpiod_set_value_cansleep(fpc->reset_gpio, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(fpc->reset_gpio, 0);
+	usleep_range(5000, 5100);
+}
+
+static int fpc1020_power_on(struct fpc1020 *fpc)
+{
+	int ret;
+
+	/* Hold the sensor in reset while its rail comes up. */
+	gpiod_set_value_cansleep(fpc->reset_gpio, 1);
+
+	ret = regulator_set_load(fpc->vreg, 100000);
+	if (ret)
+		dev_warn(fpc->dev, "regulator_set_load failed: %d\n", ret);
+
+	ret = regulator_enable(fpc->vreg);
+	if (ret) {
+		dev_err(fpc->dev, "could not enable fp_vdd_vreg: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(FPC1020_PWR_ON_SLEEP_US, FPC1020_PWR_ON_SLEEP_US + 900);
+	fpc1020_reset_pulse(fpc);
+
+	if (device_may_wakeup(fpc->dev))
+		enable_irq_wake(fpc->irq);
+	enable_irq(fpc->irq);
+	fpc->prepared = true;
+
+	return 0;
+}
+
+static void fpc1020_power_off(struct fpc1020 *fpc)
+{
+	if (!fpc->prepared)
+		return;
+
+	disable_irq(fpc->irq);
+	if (device_may_wakeup(fpc->dev))
+		disable_irq_wake(fpc->irq);
+
+	gpiod_set_value_cansleep(fpc->reset_gpio, 1);	/* hold in reset */
+	regulator_disable(fpc->vreg);
+	fpc->prepared = false;
+}
+
+static int fpc1020_open(struct inode *inode, struct file *file)
+{
+	struct fpc1020 *fpc = container_of(file->private_data, struct fpc1020,
+					   miscdev);
+	int ret = 0;
+
+	mutex_lock(&fpc->lock);
+	if (fpc->users++ == 0)
+		ret = fpc1020_power_on(fpc);
+	if (ret) {
+		fpc->users--;
+	} else {
+		atomic_set(&fpc->irq_count, 0);
+	}
+	mutex_unlock(&fpc->lock);
+
+	return ret;
+}
+
+static int fpc1020_release(struct inode *inode, struct file *file)
+{
+	struct fpc1020 *fpc = container_of(file->private_data, struct fpc1020,
+					   miscdev);
+
+	mutex_lock(&fpc->lock);
+	if (--fpc->users == 0)
+		fpc1020_power_off(fpc);
+	mutex_unlock(&fpc->lock);
+
+	return 0;
+}
+
+static __poll_t fpc1020_poll(struct file *file, poll_table *wait)
+{
+	struct fpc1020 *fpc = container_of(file->private_data, struct fpc1020,
+					   miscdev);
+
+	poll_wait(file, &fpc->irq_wait, wait);
+
+	if (!READ_ONCE(fpc->prepared))
+		return EPOLLERR;
+
+	if (atomic_xchg(&fpc->irq_count, 0))
+		return EPOLLIN | EPOLLRDNORM;
+
+	return 0;
+}
+
+static long fpc1020_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct fpc1020 *fpc = container_of(file->private_data, struct fpc1020,
+					   miscdev);
+	int ret = 0;
+
+	switch (cmd) {
+	case FPC1020_IOC_RESET:
+		mutex_lock(&fpc->lock);
+		if (fpc->prepared)
+			fpc1020_reset_pulse(fpc);
+		else
+			ret = -ENODEV;
+		mutex_unlock(&fpc->lock);
+		break;
+	default:
+		ret = -ENOTTY;
+	}
+
+	return ret;
+}
+
+static const struct file_operations fpc1020_fops = {
+	.owner		= THIS_MODULE,
+	.open		= fpc1020_open,
+	.release	= fpc1020_release,
+	.poll		= fpc1020_poll,
+	.unlocked_ioctl	= fpc1020_ioctl,
+};
+
+static ssize_t power_state_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct fpc1020 *fpc = dev_get_drvdata(dev);
+	bool on;
+
+	mutex_lock(&fpc->lock);
+	on = fpc->prepared;
+	mutex_unlock(&fpc->lock);
+
+	return sysfs_emit(buf, "%s\n", on ? "on" : "off");
+}
+static DEVICE_ATTR_RO(power_state);
+
+static struct attribute *fpc1020_attrs[] = {
+	&dev_attr_power_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(fpc1020);
+
+static int fpc1020_suspend(struct device *dev)
+{
+	struct fpc1020 *fpc = dev_get_drvdata(dev);
+
+	mutex_lock(&fpc->lock);
+	if (fpc->prepared)
+		fpc1020_power_off(fpc);
+	mutex_unlock(&fpc->lock);
+
+	return 0;
+}
+
+static int fpc1020_resume(struct device *dev)
+{
+	struct fpc1020 *fpc = dev_get_drvdata(dev);
+	int ret = 0;
+
+	mutex_lock(&fpc->lock);
+	if (fpc->users && !fpc->prepared)
+		ret = fpc1020_power_on(fpc);
+	mutex_unlock(&fpc->lock);
+
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(fpc1020_pm_ops, fpc1020_suspend, fpc1020_resume);
+
+static int fpc1020_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct fpc1020 *fpc;
+	int ret;
+
+	fpc = devm_kzalloc(dev, sizeof(*fpc), GFP_KERNEL);
+	if (!fpc)
+		return -ENOMEM;
+
+	fpc->dev = dev;
+	mutex_init(&fpc->lock);
+	init_waitqueue_head(&fpc->irq_wait);
+	atomic_set(&fpc->irq_count, 0);
+	platform_set_drvdata(pdev, fpc);
+
+	fpc->vreg = devm_regulator_get(dev, "fp_vdd_vreg");
+	if (IS_ERR(fpc->vreg))
+		return dev_err_probe(dev, PTR_ERR(fpc->vreg),
+				     "no fp_vdd_vreg supply\n");
+
+	fpc->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(fpc->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(fpc->reset_gpio),
+				     "no reset GPIO\n");
+
+	fpc->irq = platform_get_irq(pdev, 0);
+	if (fpc->irq < 0)
+		return fpc->irq;
+
+	fpc->miscdev.minor = MISC_DYNAMIC_MINOR;
+	fpc->miscdev.name = FPC1020_NAME;
+	fpc->miscdev.fops = &fpc1020_fops;
+	fpc->miscdev.parent = dev;
+
+	ret = misc_register(&fpc->miscdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not register /dev/%s\n",
+				     FPC1020_NAME);
+
+	ret = devm_request_threaded_irq(dev, fpc->irq, NULL,
+					fpc1020_irq_handler,
+					IRQF_TRIGGER_RISING | IRQF_ONESHOT |
+					IRQF_NO_AUTOEN,
+					dev_name(dev), fpc);
+	if (ret) {
+		misc_deregister(&fpc->miscdev);
+		return dev_err_probe(dev, ret, "could not request IRQ %d\n",
+				     fpc->irq);
+	}
+
+	device_init_wakeup(dev, true);
+	dev_info(dev, "FPC1020 control interface ready (secure-world SPI)\n");
+
+	return 0;
+}
+
+static void fpc1020_remove(struct platform_device *pdev)
+{
+	struct fpc1020 *fpc = platform_get_drvdata(pdev);
+
+	fpc1020_power_off(fpc);
+	misc_deregister(&fpc->miscdev);
+}
+
+static const struct of_device_id fpc1020_of_match[] = {
+	{ .compatible = "fpc,fpc1020" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fpc1020_of_match);
+
+static struct platform_driver fpc1020_driver = {
+	.probe	= fpc1020_probe,
+	.remove	= fpc1020_remove,
+	.driver	= {
+		.name		= FPC1020_NAME,
+		.of_match_table	= fpc1020_of_match,
+		.pm		= pm_ptr(&fpc1020_pm_ops),
+		.dev_groups	= fpc1020_groups,
+	},
+};
+module_platform_driver(fpc1020_driver);
+
+MODULE_AUTHOR("liuqin mainline port");
+MODULE_DESCRIPTION("FPC1264 power/reset/IRQ control (secure-world SPI)");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" FPC1020_NAME);
