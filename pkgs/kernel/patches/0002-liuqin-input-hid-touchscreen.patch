+        self.assertIn("pkt->wire_len > left", parse)
+        self.assertIn("pkt->report_len > pkt->wire_len", parse)
+
+    def test_dt_contract_has_two_irqs_and_soc_regulator(self):
+        self.assertEqual(BINDING.count("minItems: 2"), 2)
+        self.assertRegex(DTS, r"&soc\s*\{[\s\S]*?keyboard_vdd_regulator:")
+        keyboard = DTS.split("keyboard@4c {", 1)[1].split("\n\t};", 1)[0]
+        # No second DT reference to the hall lines: on 7.2.5 the shared-GPIO
+        # proxy path then breaks gpio-keys' own probe with -EBUSY.
+        self.assertNotIn("hall-n-gpios", DTS)
+        self.assertNotIn("hall-s-gpios", DTS)
+        self.assertNotIn("hall-", BINDING)
+        self.assertIn('interrupt-names = "data", "wakeup", "tablet-mode";',
+                      keyboard)
+        self.assertIn("wakeup-source;", keyboard)
+        self.assertRegex(keyboard,
+                         r"interrupts-extended\s*=\s*<&tlmm 50[^>]*>,\s*"
+                         r"<&tlmm 46[^>]*>,\s*<&tlmm 23[^>]*>;")
+        # The folio-folded hall is owned by the bridge driver, active-low.
+        self.assertIn("tablet-mode-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;", keyboard)
+        gpio_keys = DTS.split("gpio-keys {", 1)[1].split("\n\t};", 1)[0]
+        self.assertNotIn("event-hall-tablet-mode", gpio_keys)
+        self.assertNotIn("linux,code = <SW_TABLET_MODE>", gpio_keys)
