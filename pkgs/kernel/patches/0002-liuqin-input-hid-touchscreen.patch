+enum nanosic_i2c_operation {
+	NANOSIC_I2C_NONE,
+	NANOSIC_I2C_DATA_READ,
+	NANOSIC_I2C_VERSION_WRITE,
+	NANOSIC_I2C_VERSION_READ,
+	NANOSIC_I2C_HALL_WRITE,
+	NANOSIC_I2C_LED_WRITE,
+};
+
+struct nanosic {
+	struct i2c_client *client;
+	struct regulator *vdd;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *wake_gpio;
+	struct hid_device *hid[NANOSIC_HID_COUNT];
+
+	/* The gpio-keys device whose lid switch feeds the bridge command. */
+	struct input_dev *hall_dev;
+	struct input_handler *hall_handler;
+	struct input_handle *hall_handle;
+	struct delayed_work hall_work;
+
+	/*
+	 * The folio-folded hall, owned here, and the switch derived from it
+	 * plus the bridge's presence.
+	 */
+	struct gpio_desc *tablet_mode_gpio;
+	int tablet_mode_irq;
+	struct delayed_work tablet_work;
+	struct input_dev *folio_dev;
+	unsigned int folio_folded;
+	unsigned int folio_present;
+	unsigned int tablet_mode;
+	unsigned long last_irq;
+
+	/* Last keyboard output report, resent when a removed folio returns. */
+	u8 last_output[NANOSIC_OUTPUT_MAX];
+	size_t last_output_len;
+	u64 folio_irq_count;
+
+	/* Serialises the wake line, the awake flag and the I2C buffers. */
+	struct mutex lock;
+	struct delayed_work idle_work;
+	unsigned long wake_deadline;
+	bool awake;
+	bool suspended;
+	bool data_pending;
+
+	int data_irq;
+	bool data_irq_wake_enabled;
+
+	u64 irq_count;
+	u64 i2c_transfer_count;
+	u64 i2c_error_count;
+	u64 last_i2c_error_transfer;
+	u64 reset_recovery_count;
+	u64 bad_magic_count;
+	u64 valid_report_count;
+	u64 hall_send_count;
+	int last_i2c_errno;
+	enum nanosic_i2c_operation last_i2c_operation;
+
