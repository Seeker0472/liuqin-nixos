+};
+
+static const struct nanosic_packet *nanosic_packet_by_id(u8 id)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(nanosic_packets); i++)
+		if (nanosic_packets[i].id == id)
+			return &nanosic_packets[i];
+
+	return NULL;
+}
+
+static void nanosic_idle_work(struct work_struct *work)
+{
+	struct nanosic *nano = container_of(to_delayed_work(work),
+					    struct nanosic, idle_work);
+
+	guard(mutex)(&nano->lock);
+
+	if (nano->suspended)
+		return;
+
+	/*
+	 * mod_delayed_work() cannot stop an instance that is already running
+	 * and blocked on this mutex. Re-checking the deadline after taking the
+	 * lock prevents that stale instance from undoing a concurrent wake.
+	 */
+	if (time_before(jiffies, nano->wake_deadline)) {
+		mod_delayed_work(system_wq, &nano->idle_work,
+				 nano->wake_deadline - jiffies);
+		return;
+	}
+
+	gpiod_set_value_cansleep(nano->wake_gpio, 0);
+	nano->awake = false;
+}
+
+/*
+ * Raise the wake line if it is down and restart the idle countdown. The vendor
+ * driver instead sampled the interrupt line to decide whether the bridge was
+ * already running; tracking who lowered the line is the same information from
+ * the side that has it, and it keeps the GPIO out of the device tree binding.
+ */
+static void nanosic_wake(struct nanosic *nano)
+{
+	unsigned long delay = msecs_to_jiffies(NANOSIC_IDLE_TIMEOUT_MS);
+
+	lockdep_assert_held(&nano->lock);
+
+	if (!nano->awake) {
+		gpiod_set_value_cansleep(nano->wake_gpio, 1);
+		nano->awake = true;
+	}
+
+	nano->wake_deadline = jiffies + delay;
+	mod_delayed_work(system_wq, &nano->idle_work, delay);
+}
+
+static const char *nanosic_i2c_operation_name(enum nanosic_i2c_operation operation)
+{
+	switch (operation) {
+	case NANOSIC_I2C_DATA_READ:
+		return "data-read";
+	case NANOSIC_I2C_VERSION_WRITE:
+		return "version-write";
+	case NANOSIC_I2C_VERSION_READ:
+		return "version-read";
+	case NANOSIC_I2C_HALL_WRITE:
+		return "hall-write";
+	case NANOSIC_I2C_LED_WRITE:
+		return "led-write";
+	default:
+		return "none";
+	}
+}
+
+static int nanosic_i2c_transfer(struct nanosic *nano, struct i2c_msg *msg,
+				int num, enum nanosic_i2c_operation operation)
+{
+	int ret;
+
+	lockdep_assert_held(&nano->lock);
+
+	nano->i2c_transfer_count++;
+	ret = i2c_transfer(nano->client->adapter, msg, num);
+	if (ret != num) {
+		ret = ret < 0 ? ret : -EIO;
+		nano->i2c_error_count++;
+		nano->last_i2c_errno = ret;
+		nano->last_i2c_operation = operation;
+		nano->last_i2c_error_transfer = nano->i2c_transfer_count;
+		return ret;
+	}
+
+	return 0;
+}
+
+static int nanosic_read_frame(struct nanosic *nano,
+			      enum nanosic_i2c_operation operation)
+{
+	struct i2c_client *client = nano->client;
+	struct i2c_msg msg[2] = {
+		{
+			.addr = client->addr,
+			.len = sizeof(nano->reg),
+			.buf = &nano->reg,
+		},
+		{
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = sizeof(nano->rxbuf),
+			.buf = nano->rxbuf,
+		},
+	};
+	lockdep_assert_held(&nano->lock);
+
+	return nanosic_i2c_transfer(nano, msg, ARRAY_SIZE(msg), operation);
+}
+
+static int nanosic_write_version_command(struct nanosic *nano)
+{
+	struct i2c_client *client = nano->client;
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.len = sizeof(nanosic_version_command),
+		.buf = (u8 *)nanosic_version_command,
+	};
+
+	lockdep_assert_held(&nano->lock);
+
+	/* The vendor command's register byte is specific to the 0x4c device. */
+	if (client->addr != nanosic_version_command[0])
+		return -ENXIO;
+
+	return nanosic_i2c_transfer(nano, &msg, 1,
+				    NANOSIC_I2C_VERSION_WRITE);
+}
+
+/*
+ * Hall handling. The lid hall belongs to gpio-keys, and its state is read from
+ * the bitmap the input core keeps for that device - the sw bitmap, which is
+ * where EV_SW state lives; the key bitmap only ever holds EV_KEY. The
+ * folio-folded hall is owned by this driver and folded into the switch it
+ * reports (tablet_mode): the line alone cannot separate "keyboard deployed"
+ * from "folio removed". The level byte the bridge receives carries both.
+ */
+static unsigned int nanosic_hall_level(struct nanosic *nano)
+{
+	struct input_dev *dev = nano->hall_dev;
+	unsigned int lid = test_bit(SW_LID, dev->sw) ? 1 : 0;
+
+	return ((!lid) << 4) | nano->tablet_mode;
+}
+
+/*
+ * In tablet mode the switch's own semantic is "no keyboard attached", and the
+ * folio's keys and touchpad are physically out of reach behind the tablet.
+ * The vendor stack gates the folio on that state; this bridge does not, so
+ * the input reports are dropped here.
+ */
+static bool nanosic_input_muted(struct nanosic *nano)
+{
+	return nano->tablet_mode;
+}
+
+static int nanosic_write_hall_command(struct nanosic *nano)
+{
+	struct i2c_client *client = nano->client;
+	u8 command[NANOSIC_HALL_COMMAND_LEN];
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.len = sizeof(command),
+		.buf = command,
+	};
+	int ret;
+
+	lockdep_assert_held(&nano->lock);
+
+	/* The bridge takes its own slave address as the register byte. */
+	if (client->addr != nanosic_hall_command[0])
+		return -ENXIO;
+
+	memcpy(command, nanosic_hall_command, sizeof(command));
+	command[NANOSIC_HALL_LEVEL_OFFSET] = nanosic_hall_level(nano);
+
+	ret = nanosic_i2c_transfer(nano, &msg, 1, NANOSIC_I2C_HALL_WRITE);
+	if (!ret)
+		nano->hall_send_count++;
+
+	return ret;
+}
+
+static void nanosic_hall_work(struct work_struct *work)
+{
+	struct nanosic *nano = container_of(work, struct nanosic,
+					    hall_work.work);
+	bool was_awake;
+	unsigned int attempt;
+	int ret;
+
+	guard(mutex)(&nano->lock);
+
+	if (nano->suspended || !nano->hall_dev)
+		return;
+
+	/*
+	 * After a dropped wake line the bridge needs its I2C back; the vendor
+	 * measured up to 25 ms for that, the same as the version request.
+	 */
+	was_awake = nano->awake;
+	nanosic_wake(nano);
+	if (!was_awake)
+		usleep_range(NANOSIC_I2C_RETRY_US, NANOSIC_I2C_RETRY_US + 500);
+
+	for (attempt = 0; attempt < NANOSIC_HALL_RETRIES; attempt++) {
+		ret = nanosic_write_hall_command(nano);
+		if (!ret)
+			return;
+
+		/* Retry only an observed failure, like the frame read path. */
+		usleep_range(NANOSIC_I2C_RETRY_US, NANOSIC_I2C_RETRY_US + 500);
+	}
+
+	dev_dbg(&nano->client->dev, "hall command failed: %d\n", ret);
+}
+
+static void nanosic_hall_push(struct nanosic *nano, unsigned int delay_ms)
+{
+	mod_delayed_work(system_wq, &nano->hall_work, msecs_to_jiffies(delay_ms));
+}
+
+/*
+ * Liveness: the bridge stops raising its data line when the keypad comes off,
+ * and any interrupt - even one that only reports "nothing happened" - refreshes
+ * the window.
+ */
+static bool nanosic_folio_present(struct nanosic *nano)
+{
+	lockdep_assert_held(&nano->lock);
+
+	return time_before(jiffies,
+			   nano->last_irq + msecs_to_jiffies(NANOSIC_FOLIO_IDLE_MS));
+}
+
+static void nanosic_folio_report(struct nanosic *nano)
+{
+	unsigned int value = nano->folio_folded || !nano->folio_present;
+
+	if (value == nano->tablet_mode)
+		return;
+
+	nano->tablet_mode = value;
+	input_report_switch(nano->folio_dev, SW_TABLET_MODE, value);
+	input_sync(nano->folio_dev);
+
+	/* The bridge sees the same state any other switch change would push. */
+	nanosic_hall_push(nano, 0);
+}
+
+/*
+ * Send the CapsLock state as the management command the keypad acts on. The
+ * lock is held by the caller: the request hook takes it itself, the folio
+ * work already has it. data is the rendered output report - "05 <bitmap>".
+ */
+static int nanosic_send_led_command_locked(struct nanosic *nano,
+					   const u8 *data, size_t len)
+{
+	u8 command[NANOSIC_LED_COMMAND_LEN];
+	struct i2c_msg msg = {
+		.addr = nano->client->addr,
+		.len = sizeof(command),
+		.buf = command,
+	};
+	u8 caps;
+	bool was_awake;
+
+	lockdep_assert_held(&nano->lock);
+
+	if (len < 2)
+		return -EINVAL;
+
+	/* CapsLock is bit 1 of the LED bitmap in the last report byte. */
+	caps = data[len - 1] & 0x02 ? 1 : 0;
+
+	memcpy(command, nanosic_led_command, sizeof(command));
+	command[NANOSIC_LED_STATE_OFFSET] = caps;
+	command[NANOSIC_LED_COMPANION_OFFSET] =
+		NANOSIC_LED_COMPANION_BASE + caps;
+
+	was_awake = nano->awake;
+	nanosic_wake(nano);
+	if (!was_awake)
+		usleep_range(NANOSIC_I2C_RETRY_US, NANOSIC_I2C_RETRY_US + 500);
+
+	return nanosic_i2c_transfer(nano, &msg, 1, NANOSIC_I2C_LED_WRITE);
+}
+
+/*
+ * The keyboard's LEDs. hid-input sends the LED state through
+ * ll_driver->request(HID_REQ_SET_REPORT) when the transport has one; without
+ * it the core falls back to hid_hw_output_report() and then to
+ * raw_request() - and this transport had none of the three. The state is
+ * translated into the keypad's own management command (see
+ * nanosic_led_command) and remembered, so a folio that returns gets it back;
+ * its LED has been dark since it lost power.
+ */
+static void nanosic_hid_request(struct hid_device *hid, struct hid_report *report,
+				int reqtype)
+{
+	struct nanosic *nano = dev_get_drvdata(hid->dev.parent);
+	u8 buf[NANOSIC_OUTPUT_MAX];
+	unsigned int len;
+	int ret = 0;
+
+	if (reqtype != HID_REQ_SET_REPORT || report->type != HID_OUTPUT_REPORT)
+		return;
+
+	/* Only the keyboard carries LEDs; nothing else may be forwarded. */
+	if (hid != nano->hid[NANOSIC_HID_KEYBOARD])
+		return;
+
+	len = hid_report_len(report);
+	if (len == 0 || len > sizeof(buf))
+		return;
+
+	memset(buf, 0, len);
+	hid_output_report(report, buf);
+
+	scoped_guard(mutex, &nano->lock) {
+		if (nano->last_output_len == len &&
+		    !memcmp(nano->last_output, buf, len))
+			return;
+
+		memcpy(nano->last_output, buf, len);
+		nano->last_output_len = len;
+
+		ret = nanosic_send_led_command_locked(nano, buf, len);
+	}
+
+	if (ret)
+		dev_dbg(&nano->client->dev,
+			"led command failed: %d\n", ret);
+}
+
+static void nanosic_tablet_work(struct work_struct *work)
+{
+	struct nanosic *nano = container_of(to_delayed_work(work),
+					    struct nanosic, tablet_work);
+	bool was_present;
+
+	guard(mutex)(&nano->lock);
+
+	if (nano->suspended)
+		return;
+
+	was_present = nano->folio_present;
+	nano->folio_folded = gpiod_get_value_cansleep(nano->tablet_mode_gpio);
+	/* Folded is attached by construction - a magnet needs a folio. */
+	nano->folio_present = nano->folio_folded || nanosic_folio_present(nano);
+
+	/*
+	 * A folio that comes back has had its LEDs dark since it lost power;
+	 * hand it the state it missed.
+	 */
+	if (!was_present && nano->folio_present && nano->last_output_len)
+		nanosic_send_led_command_locked(nano, nano->last_output,
+						nano->last_output_len);
+
+	nanosic_folio_report(nano);
+
+	/*
+	 * Neither attach nor detach has an interrupt of its own (the hall line
+	 * only moves when the folio is folded), so the probe repeats.
+	 */
+	mod_delayed_work(system_wq, &nano->tablet_work,
+			 msecs_to_jiffies(NANOSIC_FOLIO_POLL_MS));
+}
+
+static irqreturn_t nanosic_tablet_irq(int irq, void *data)
+{
+	struct nanosic *nano = data;
+
+	nano->folio_irq_count++;
+	mod_delayed_work(system_wq, &nano->tablet_work,
+			 msecs_to_jiffies(NANOSIC_FOLIO_DEBOUNCE_MS));
+
+	return IRQ_HANDLED;
+}
+
+static int nanosic_folio_input_create(struct nanosic *nano)
+{
+	struct device *dev = &nano->client->dev;
+	struct input_dev *input;
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+
+	input->name = "liuqin-folio";
+	input->phys = "liuqin-folio/input0";
+	input->id.bustype = BUS_I2C;
+	input_set_capability(input, EV_SW, SW_TABLET_MODE);
+
+	nano->folio_dev = input;
+	nano->tablet_mode = nano->folio_folded ? 1 : 0;
+	input_report_switch(input, SW_TABLET_MODE, nano->tablet_mode);
+
+	return input_register_device(input);
+}
+
+static void nanosic_tablet_put(void *data)
+{
+	struct nanosic *nano = data;
+
+	cancel_delayed_work_sync(&nano->tablet_work);
+}
+
+/*
+ * The board's gpio-keys device is the only source of the lid switch, and the
+ * bitmaps are the whole criterion: input_match_device() stops its id walk at a
+ * zero entry and checks every bitmap unconditionally, so a capability entry
+ * needs no match() callback. (A NULL or empty table would be dereferenced or
+ * end the walk before anything is attached.)
+ */
+static const struct input_device_id nanosic_hall_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT |
+			 INPUT_DEVICE_ID_MATCH_SWBIT,
+		.evbit = { BIT_MASK(EV_SW) },
+		.swbit = { BIT_MASK(SW_LID) },
+	},
+	{ }
+};
+
+static int nanosic_hall_connect(struct input_handler *handler,
+				struct input_dev *dev,
+				const struct input_device_id *id)
+{
+	struct nanosic *nano = handler->private;
+	struct input_handle *handle;
+	int ret;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+
+	handle->private = nano;
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "hid-nanosic-hall";
+
+	ret = input_register_handle(handle);
+	if (ret)
+		goto free_handle;
+
+	ret = input_open_device(handle);
+	if (ret)
+		goto unregister_handle;
+
+	nano->hall_dev = dev;
+	nano->hall_handle = handle;
+
+	/*
+	 * The bridge is still booting under this freshly probed folio, and the
+	 * driver never talks I2C at probe for that reason; give it the same
+	 * application-ready window the reset path uses before the first push.
+	 */
+	nanosic_hall_push(nano, NANOSIC_HALL_ATTACH_DELAY_MS);
+
+	return 0;
+
+unregister_handle:
+	input_unregister_handle(handle);
+free_handle:
+	kfree(handle);
+
+	return ret;
+}
+
+static void nanosic_hall_disconnect(struct input_handle *handle)
+{
+	struct nanosic *nano = handle->private;
+
+	nano->hall_dev = NULL;
+	nano->hall_handle = NULL;
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static void nanosic_hall_event(struct input_handle *handle, unsigned int type,
+			       unsigned int code, int value)
+{
+	struct nanosic *nano = handle->private;
+
+	if (type != EV_SW || code != SW_LID)
+		return;
+
+	nanosic_hall_push(nano, 0);
+}
+
+static void nanosic_hall_handler_put(void *data)
+{
+	struct nanosic *nano = data;
+
+	input_unregister_handler(nano->hall_handler);
+	cancel_delayed_work_sync(&nano->hall_work);
+}
+
+static int nanosic_hall_handler_get(struct nanosic *nano)
+{
+	struct device *dev = &nano->client->dev;
+	int ret;
+
+	nano->hall_handler = devm_kzalloc(dev, sizeof(*nano->hall_handler),
+					  GFP_KERNEL);
+	if (!nano->hall_handler)
+		return -ENOMEM;
+
+	nano->hall_handler->name = "hid-nanosic-hall";
+	nano->hall_handler->id_table = nanosic_hall_ids;
+	nano->hall_handler->connect = nanosic_hall_connect;
+	nano->hall_handler->disconnect = nanosic_hall_disconnect;
+	nano->hall_handler->event = nanosic_hall_event;
+	nano->hall_handler->private = nano;
+
+	ret = input_register_handler(nano->hall_handler);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register hall handler\n");
+
+	return devm_add_action_or_reset(dev, nanosic_hall_handler_put, nano);
+}
+
+static void nanosic_reset_bridge(struct nanosic *nano)
+{
+	lockdep_assert_held(&nano->lock);
+
+	/* Match the vendor's bounded recovery pulse and application-ready wait. */
+	gpiod_set_value_cansleep(nano->reset_gpio, 1);
+	msleep(NANOSIC_RESET_ASSERT_MS);
+	gpiod_set_value_cansleep(nano->reset_gpio, 0);
+	msleep(NANOSIC_RESET_READY_MS);
+	nano->reset_recovery_count++;
+
+	/* The bridge reboots with the reset and needs the levels again. */
+	nanosic_hall_push(nano, 0);
+}
+
+static bool nanosic_version_error_needs_reset(int ret)
+{
+	/* GPI DMA reports callback failures as -EIO and no completion as timeout. */
+	return ret == -ENXIO || ret == -EIO || ret == -ETIMEDOUT;
+}
+
+static int nanosic_extract_firmware_version(const u8 *frame, size_t len,
+					    char *version)
+{
+	const struct nanosic_packet *pkt;
+	const u8 *p;
+	size_t left;
+	size_t version_len;
+	unsigned int i;
+
+	if (len < NANOSIC_FRAME_HDR_LEN || frame[0] != NANOSIC_FRAME_MAGIC)
+		return -ENOMSG;
+
+	switch (frame[2]) {
+	case 0x39:
+	case 0x4a:
+	case 0x5b:
+	case 0x6c:
+		break;
+	default:
+		return -ENOMSG;
+	}
+
+	p = frame + NANOSIC_FRAME_HDR_LEN;
+	left = len - NANOSIC_FRAME_HDR_LEN;
+
+	while (left) {
+		pkt = nanosic_packet_by_id(p[0]);
+		if (!pkt || !pkt->wire_len || pkt->wire_len > left)
+			return -ENOMSG;
+
+		if (p[0] == NANOSIC_ID_VENDOR_32 &&
+		    p[2] == 0x18 && p[3] == 0x80 && p[4] == 0x01) {
+			version_len = strnlen((const char *)p +
+					      NANOSIC_VERSION_OFFSET,
+					      NANOSIC_VERSION_LEN);
+			if (!version_len)
+				return -ENODATA;
+
+			for (i = 0; i < version_len; i++)
+				if (!isprint(p[NANOSIC_VERSION_OFFSET + i]))
+					return -EBADMSG;
+
+			memcpy(version, p + NANOSIC_VERSION_OFFSET, version_len);
+			version[version_len] = '\0';
+			return 0;
+		}
+
+		p += pkt->wire_len;
+		left -= pkt->wire_len;
+	}
+
+	return -ENOMSG;
+}
+
+static void nanosic_parse_frame(struct nanosic *nano, u8 *frame, size_t len)
+{
+	struct device *dev = &nano->client->dev;
+	u8 *p;
+	size_t left;
+
+	if (len < NANOSIC_FRAME_HDR_LEN)
+		return;
+
+	p = frame + NANOSIC_FRAME_HDR_LEN;
+	left = len - NANOSIC_FRAME_HDR_LEN;
+
+	if (frame[0] != NANOSIC_FRAME_MAGIC) {
+		nano->bad_magic_count++;
+		dev_dbg(dev, "bad frame magic 0x%02x\n", frame[0]);
+		return;
+	}
+
+	switch (frame[2]) {
+	case NANOSIC_FRAME_MARK_EMPTY:
+		return;
+	case 0x39:
+	case 0x4a:
+	case 0x5b:
+	case 0x6c:
+		break;
+	default:
+		dev_dbg(dev, "bad frame marker 0x%02x\n", frame[2]);
+		return;
+	}
+
+	while (left) {
+		const struct nanosic_packet *pkt = nanosic_packet_by_id(p[0]);
+		int ret;
+
+		/*
+		 * Report IDs 0x24 and 0x26 run to the end of the frame and so
+		 * carry no length of their own; every other unknown ID leaves
+		 * nothing to resynchronise on. Either way the frame ends here.
+		 */
+		if (!pkt) {
+			dev_dbg(dev, "unhandled report 0x%02x\n", p[0]);
+			return;
+		}
+
+		if (!pkt->wire_len || pkt->report_len > pkt->wire_len ||
+		    pkt->wire_len > left) {
+			dev_dbg(dev, "report 0x%02x truncated\n", p[0]);
+			return;
+		}
+		nano->valid_report_count++;
+
+		if (pkt->dest >= 0 && !nanosic_input_muted(nano)) {
+			ret = hid_input_report(nano->hid[pkt->dest],
+					       HID_INPUT_REPORT, p,
+					       pkt->report_len, 1);
+			if (ret && ret != -ENODEV && ret != -EBUSY)
+				dev_dbg(dev, "report 0x%02x rejected: %d\n",
+					p[0], ret);
+		}
+
+		p += pkt->wire_len;
+		left -= pkt->wire_len;
+	}
+}
+
+static void nanosic_receive_frame(struct nanosic *nano)
+{
+	int ret;
+
+	lockdep_assert_held(&nano->lock);
+
+	ret = nanosic_read_frame(nano, NANOSIC_I2C_DATA_READ);
+	if (ret) {
+		/* Retry only an observed failure; the normal IRQ path never waits. */
+		usleep_range(NANOSIC_I2C_RETRY_US,
+			     NANOSIC_I2C_RETRY_US + 500);
+		ret = nanosic_read_frame(nano, NANOSIC_I2C_DATA_READ);
+	}
+	if (ret) {
+		dev_err_ratelimited(&nano->client->dev,
+				    "frame read failed: %d\n", ret);
+		return;
+	}
+
+	nanosic_parse_frame(nano, nano->rxbuf, sizeof(nano->rxbuf));
+}
+
+static int nanosic_query_firmware_version(struct nanosic *nano, char *version)
+{
+	bool reset_attempted = false;
+	bool was_awake;
+	unsigned int attempt;
+	int ret = -ENODATA;
+
+	lockdep_assert_held(&nano->lock);
+
+	if (nano->suspended)
+		return -EHOSTDOWN;
+
+	was_awake = nano->awake;
+	nanosic_wake(nano);
+	if (!was_awake)
+		usleep_range(NANOSIC_I2C_RETRY_US,
+			     NANOSIC_I2C_RETRY_US + 500);
+
+	for (attempt = 0; attempt < NANOSIC_VERSION_RETRIES; attempt++) {
+		ret = nanosic_write_version_command(nano);
+		if (nanosic_version_error_needs_reset(ret) && !reset_attempted &&
+		    attempt + 1 < NANOSIC_VERSION_RETRIES) {
+			nanosic_reset_bridge(nano);
+			reset_attempted = true;
+			continue;
+		}
+		if (ret)
+			goto retry;
+
+		usleep_range(NANOSIC_VERSION_RESPONSE_US,
+			     NANOSIC_VERSION_RESPONSE_US + 500);
+		ret = nanosic_read_frame(nano, NANOSIC_I2C_VERSION_READ);
+		if (ret)
+			goto retry;
+
+		ret = nanosic_extract_firmware_version(nano->rxbuf,
+						       sizeof(nano->rxbuf),
+						       version);
+		/* Preserve any input report that happened to arrive first. */
+		nanosic_parse_frame(nano, nano->rxbuf, sizeof(nano->rxbuf));
+		if (!ret)
+			return 0;
+
+retry:
+		if (attempt + 1 < NANOSIC_VERSION_RETRIES)
+			usleep_range(NANOSIC_I2C_RETRY_US,
+				     NANOSIC_I2C_RETRY_US + 500);
+	}
+
+	return ret;
+}
+
+static irqreturn_t nanosic_data_irq(int irq, void *data)
+{
+	struct nanosic *nano = data;
+
+	guard(mutex)(&nano->lock);
+	nano->irq_count++;
+	nano->last_irq = jiffies;
+
+	if (READ_ONCE(nano->suspended)) {
+		nano->data_pending = true;
+		pm_wakeup_event(&nano->client->dev, 1000);
+		return IRQ_HANDLED;
+	}
+
+	nanosic_wake(nano);
+	nanosic_receive_frame(nano);
+
+	return IRQ_HANDLED;
+}
