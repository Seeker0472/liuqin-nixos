+    def test_folio_switch_needs_the_bridge_liveness(self):
+        # The hall reads the same with the keyboard deployed and with the
+        # folio removed, and so does every I2C probe - the bridge is on the
+        # tablet side and answers either way (measured 2026-10-09).  Its data
+        # interrupt, however, stops within seconds of the keypad coming off,
+        # so presence is a liveness window over that interrupt.
+        data_irq = function_body("nanosic_data_irq")
+        self.assertIn("nano->last_irq = jiffies;", data_irq)
+        present = function_body("nanosic_folio_present")
+        self.assertIn(
+            "nano->last_irq + msecs_to_jiffies(NANOSIC_FOLIO_IDLE_MS)",
+            present,
+        )
+        work = function_body("nanosic_tablet_work")
+        self.assertIn("nano->folio_folded || nanosic_folio_present(nano)", work)
+        self.assertIn("NANOSIC_FOLIO_POLL_MS", work)
+        self.assertIn("NANOSIC_FOLIO_DEBOUNCE_MS",
+                      function_body("nanosic_tablet_irq"))
+        # No I2C during probe: the bridge's boot-to-application time is not
+        # fixed, so the first probe rides the attach delay instead, and the
+        # window starts out stale so a folio-less boot is tablet mode.
+        irqs = function_body("nanosic_irqs_get")
+        self.assertIn('fwnode_irq_get_byname(dev_fwnode(dev), "tablet-mode")',
+                      irqs)
+        probe_fn = function_body("nanosic_probe")
+        self.assertIn("devm_request_irq(dev, nano->tablet_mode_irq,", probe_fn)
+        self.assertIn("NANOSIC_HALL_ATTACH_DELAY_MS", probe_fn)
+        self.assertIn("nano->last_irq = jiffies - ", probe_fn)
+
+    def test_capslock_led_uses_the_keypads_management_command(self):
+        # The keypad ignores the HID output report - the vendor kernel builds
+        # it and then refuses to write it ("would not write i2c cmd ->
+        # [[[0502]]]", captured from stock Android 2026-10-09) - and takes a
+        # management command instead, captured once per toggle:
+        #   32 00 4e 31 80 38 26 01 01 5f   caps on
+        #   32 00 4e 31 80 38 26 01 00 5e   caps off
+        cmd = DRIVER.split("nanosic_led_command[", 1)[1].split("};", 1)[0]
+        self.assertIn("0x4c, 0x32, 0x00, 0x4e, 0x31, 0x80, 0x38, 0x26, 0x01",
+                      cmd)
+        self.assertRegex(DRIVER, r"#define NANOSIC_LED_STATE_OFFSET\t9")
+        self.assertRegex(DRIVER, r"#define NANOSIC_LED_COMPANION_OFFSET\t10")
+        self.assertRegex(DRIVER, r"#define NANOSIC_LED_COMPANION_BASE\t0x5e")
+        send = function_body("nanosic_send_led_command_locked")
+        self.assertIn("data[len - 1] & 0x02", send)
+        self.assertIn("command[NANOSIC_LED_STATE_OFFSET] = caps", send)
+        self.assertIn("NANOSIC_LED_COMPANION_BASE + caps", send)
+        self.assertIn("NANOSIC_I2C_LED_WRITE", send)
+        req = function_body("nanosic_hid_request")
+        self.assertIn("static void nanosic_hid_request", DRIVER)
+        self.assertIn("HID_REQ_SET_REPORT", req)
+        self.assertIn("HID_OUTPUT_REPORT", req)
+        self.assertIn("hid_output_report(report, buf)", req)
+        self.assertIn("nano->hid[NANOSIC_HID_KEYBOARD]", req)
+        self.assertIn("nanosic_send_led_command_locked(nano, buf, len)", req)
+        ll = DRIVER.split("nanosic_hid_ll_driver = {", 1)[1].split("};", 1)[0]
+        self.assertIn(".request = nanosic_hid_request", ll)
+        # A folio that comes back gets the state it missed while unpowered.
+        work = function_body("nanosic_tablet_work")
+        self.assertIn("was_present = nano->folio_present;", work)
+        self.assertIn("!was_present && nano->folio_present", work)
+        self.assertIn("nanosic_send_led_command_locked(nano, nano->last_output",
+                      work)
+
