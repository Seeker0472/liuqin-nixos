+    def test_hall_command_is_the_vendor_uplink_frame(self):
+        command = DRIVER.split("nanosic_hall_command[", 1)[1].split("};", 1)[0]
+        self.assertIn(
+            "0x4c, 0x32, 0x00, 0x4f, 0x20, 0x80, 0x80, 0xe1, 0x01",
+            command,
