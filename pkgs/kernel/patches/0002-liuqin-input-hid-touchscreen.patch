+    def test_tablet_mode_hall_is_owned_by_the_bridge(self):
+        # Measured 2026-10-08 on the unit: gpio23 reads low with the folio
+        # folded onto the back (tablet posture) and high with the keyboard
+        # deployed in front *and* with the folio removed. The hall alone
+        # cannot express "no keyboard attached", so the driver owns the line
+        # and derives the switch from it plus the bridge's presence.
+        report = function_body("nanosic_folio_report")
+        self.assertIn("nano->folio_folded || !nano->folio_present", report)
+        self.assertIn(
+            "input_report_switch(nano->folio_dev, SW_TABLET_MODE, value)",
+            report,
+        )
