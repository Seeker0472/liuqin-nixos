+        self.assertRegex(DRIVER, r"#define NANOSIC_HALL_LEVEL_OFFSET\t9")
+        write = function_body("nanosic_write_hall_command")
+        self.assertIn(
+            "command[NANOSIC_HALL_LEVEL_OFFSET] = nanosic_hall_level(nano)",
