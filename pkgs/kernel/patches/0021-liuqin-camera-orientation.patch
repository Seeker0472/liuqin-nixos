arm64: dts: qcom: liuqin: declare the camera orientations

Mark the location of each camera on the board: the rear-facing s5kjn1 and
sc202cs nodes get orientation = <1>, the front-facing imx596 gets
orientation = <0>.  The camera stack derives each camera's Location from the
property, so libcamera reports front/rear instead of leaving it unknown.

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -2126,6 +2126,7 @@
 
 	camera@10 {
 		compatible = "samsung,s5kjn1";
+		orientation = <1>; /* rear */
 		reg = <0x10>;
 		clocks = <&camcc CAM_CC_MCLK2_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
@@ -2225,6 +2226,7 @@
 &cci0_i2c0 {
 	camera@10 {
 		compatible = "sony,imx596";
+		orientation = <0>; /* front */
 		reg = <0x10>; /* vendor 8-bit write address 0x20 */
 		clocks = <&camcc CAM_CC_MCLK5_CLK>;
 		clock-names = "xvclk";
@@ -2259,6 +2261,7 @@
 &cci1_i2c0 {
 	camera@36 {
 		compatible = "smartsens,sc202cs";
+		orientation = <1>; /* rear */
 		reg = <0x36>; /* vendor 8-bit write address 0x6c */
 		clocks = <&camcc CAM_CC_MCLK1_CLK>;
 		clock-names = "xvclk";
