+static void
+update_enroll_press_count (CcFingerprintDialog *self, gboolean completed)
+{
+  guint presses = self->enroll_stages_passed + self->enroll_retry_scans;
+  g_autofree char *message = NULL;
+
+  /* TRANSLATORS: Retry scans count. The sensor determines completion. */
+  message = g_strdup_printf (completed ? _("Presses: %u") :
+                             _("Presses: %u — keep pressing until complete"), presses);
+  gtk_label_set_label (self->enroll_press_count, message);
+}
