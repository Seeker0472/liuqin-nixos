#
# NixOS adaptation: the module exports `LIUQIN_FPC_OEM_FIRMWARE` as the
# packaged OS2.0.4 asset directory, so the OEM runtime verifies and loads the
# static `fpcliu.*` files from the Nix store. Deployments without that variable
# keep the component's colocated default. `resolve()` keeps the value absolute,
# which the kernel parameter requires.
#
diff -r a/oem_runtime.py b/oem_runtime.py
--- a/oem_runtime.py	2026-10-07 00:39:18.028384603 +0800
+++ b/oem_runtime.py	2026-10-07 00:39:18.067415508 +0800
@@ -67,7 +67,7 @@
         listener_command = [str(provider), "--serve-authenticated" if
                             rpmb_mode == "--ufs-rpmb-authenticated" else "--serve-read-only"]
         expected_listeners = 3
-    firmware = here / "firmware"
+    firmware = Path(os.environ.get("LIUQIN_FPC_OEM_FIRMWARE") or (here / "firmware")).resolve()
     expected = json.loads((firmware / "SHA256.json").read_text())
     for name, digest in expected.items():
         if hashlib.sha256((firmware / name).read_bytes()).hexdigest() != digest:
@@ -77,6 +77,16 @@
     state.mkdir(mode=0o700, exist_ok=True)
     os.chmod(state, 0o700)
     parameter = Path("/sys/module/firmware_class/parameters/path")
+    # The system owns this path. Never replace it for an individual TEE
+    # operation: audio and remoteproc can request firmware concurrently.
+    lookup = Path("/run/firmware")
+    if parameter.read_bytes().rstrip(b"\n") != os.fsencode(lookup):
+        print("shared firmware lookup is not ready; start liuqin-firmware-loader-path.service", file=sys.stderr)
+        return 2
+    for name, digest in expected.items():
+        if hashlib.sha256((lookup / name).read_bytes()).hexdigest() != digest:
+            print("OEM firmware is missing or shadowed in the shared lookup tree", file=sys.stderr)
+            return 2
     if match:
         client_name = "fpc_build_info"
         client = [str(here / client_name), *arguments]
@@ -104,7 +114,7 @@
         cancelled = True
     signal.signal(signal.SIGTERM, cancel_operation)
     signal.signal(signal.SIGINT, cancel_operation)
-    # All users share one SPI sensor, listener set and firmware path.
+    # All users share one sensor and listener set; firmware lookup is read-only.
     with open(state / "operation.lock", "a+b") as operation, tempfile.TemporaryFile(mode="w+b", dir=state) as log:
         os.fchmod(operation.fileno(), 0o600)
         try:
@@ -112,7 +122,8 @@
         except BlockingIOError:
             print("oem_runtime=BUSY", file=sys.stderr)
             return 1
-        # sysfs adds exactly one newline. Write NUL when restoring an empty value.
