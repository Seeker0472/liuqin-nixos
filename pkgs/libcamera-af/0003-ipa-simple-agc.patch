+int Agc::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	/*
+	 * Standard auto-exposure switch; AeEnable=false freezes the exposure
+	 * at its current values.
+	 */
+	context.ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
+
+	return 0;
+}
+
+void Agc::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	/*
+	 * Exposure is a continuous state, not per-frame data: apply the
+	 * switch immediately instead of storing it in the frame context.
+	 */
+	const auto &aeEnable = controls.get(controls::AeEnable);
+	if (aeEnable.has_value())
+		context.activeState.agc.aeEnable = *aeEnable;
+}
