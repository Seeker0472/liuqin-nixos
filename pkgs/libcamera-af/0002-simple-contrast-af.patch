 	CameraLens *focusLens() const { return focusLens_; }
 
+	/*
+	 * Contrast-detection autofocus, driven from processed frames: a coarse
+	 * full-range sweep, a fine sweep around the best point, then lock, and
+	 * (by default) keep tracking the scene for changes that warrant a
+	 * rescan.  Ported in spirit from the RPi IPA's AfAlgorithm, kept local
+	 * to the pipeline because the software ISP has no AF hooks.
+	 *
+	 * FIXME: this is deliberately crude - it works on this device, but
+	 * every part of it wants work:
+	 *
+	 *  - The score is the raw gradient energy and is therefore brightness
+	 *    sensitive, while the AE keeps adapting throughout the sweep, so
+	 *    a position that happens to be brighter scores higher regardless
+	 *    of focus.  A mean-luma normalisation was tried and reverted: on a
+	 *    dark, defocused position the AE's gain noise then dominates the
+	 *    normalised score (that is how the sweep once settled on position
+	 *    0).  The real fix is to hold the exposure for the duration of
+	 *    the sweep, which needs the soft IPA to honour AeEnable and
+	 *    ExposureTime - today it ignores both.
+	 *  - The dwell is a fixed 12 frames.  It should adapt to when the
+	 *    score and the AE actually settle, e.g. by watching the request
+	 *    metadata's exposure and gain.
+	 *  - The sweep is 9 coarse + 6 fine positions over the full 0..1023
+	 *    range, with no sub-step interpolation.  A parabolic fit around
+	 *    the coarse peak, and a range limited to the module's useful
+	 *    focus distances, would be faster and more accurate.
+	 *  - Tracking uses a fixed 3x score-drop threshold and a 10 s
+	 *    cooldown.  Scene-change detection would be better.
+	 *  - The score covers the central 3/5 of the frame with no
+	 *    region-of-interest weighting or face/subject awareness.
+	 */
+	struct Af {
+		enum class State { Idle, Coarse, Fine, Locked };
+		State state = State::Idle;
+		/* One of the controls::AfMode values. */
+		int32_t mode = controls::AfModeContinuous;
+		bool started = false;		/* Auto mode: AfTriggerStart armed a scan */
+		unsigned int settle = 90;	/* frames for AGC to converge: measured, the soft ISP's AE/AWB need ~3 s before a contrast score means anything (with 25 the coarse sweep runs on noise and locks anywhere) */
+		int idx = 0;
+		int count = 0;
+		int32_t pts[12] = {};
+		int32_t cur = -1;		/* position of the frame being scored */
+		unsigned int dwell = 11;	/* frames to let the VCM *and the AE* settle after a move */
+		int64_t bestScore = -1;
+		int32_t best = -1;
+		int32_t lo = 0;
+		int32_t hi = 1023;
+		unsigned int failCount = 0;	/* consecutive lens write failures */
+		bool warnedLensPosition = false;	/* one warning per stream */
+		/* locked state and continuous tracking */
+		int32_t lockedPos = -1;
+		int64_t lockedScore = -1;
+		unsigned int lowStreak = 0;	/* frames clearly below lockedScore */
+		unsigned int cooldown = 0;	/* frames to wait after a failed track */
+		bool track = false;		/* the running fine scan came from tracking */
+
+		/*
+		 * Reset the scan and tracking state, for a new stream or when
+		 * the application re-arms autofocus.  The mode survives: it is
+		 * the application's configuration, not part of a scan.
+		 */
+		void reset()
+		{
+			state = State::Idle;
+			started = false;
+			settle = 90;
+			idx = 0;
+			count = 0;
+			cur = -1;
+			dwell = 11;
+			bestScore = -1;
+			best = -1;
+			lowStreak = 0;
+			cooldown = 0;
+			track = false;
+			failCount = 0;
+			warnedLensPosition = false;
+		}
+	};
+	Af af_;
+	void afRun(FrameBuffer *buffer);
+	int64_t afScore(FrameBuffer *buffer);
+
 	int init();
 	int setupLinks();
