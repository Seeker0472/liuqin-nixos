+int64_t SimpleCameraData::afScore(FrameBuffer *buffer)
+{
+	/*
+	 * Score the buffer's own stream.  streams_[0] is not necessarily the
+	 * processed stream: with a raw-first configuration it is the 10-bpp
+	 * packed Bayer stream whose bitsPerPixel is not 32, so every score
+	 * came back -1 while the state machine still walked the whole sweep
+	 * and parked the lens blind.  Refuse to score anything that is not a
+	 * 32-bpp processed frame.
+	 */
+	const Stream *stream = nullptr;
+	for (const auto &[s, b] : buffer->request()->buffers()) {
+		if (b == buffer) {
+			stream = s;
+			break;
+		}
+	}
+	if (!stream)
+		return -1;
+
+	const StreamConfiguration &cfg = stream->configuration();
+	const PixelFormatInfo &fmt = PixelFormatInfo::info(cfg.pixelFormat);
+	if (!fmt.isValid() || fmt.bitsPerPixel != 32)
+		return -1;
+
+	MappedFrameBuffer map(buffer, MappedFrameBuffer::MapFlag::Read);
+	if (!map.isValid())
+		return -1;
+
+	const uint8_t *data = map.planes()[0].data();
+	const unsigned int bpp = fmt.bitsPerPixel / 8;
+	const unsigned int w = cfg.size.width, h = cfg.size.height;
+	const unsigned int x0 = w / 5, x1 = w - w / 5;
+	const unsigned int y0 = h / 5, y1 = h - h / 5;
+
+	/* Luma as the sum of the first three bytes: channel-order independent. */
+	auto luma = [bpp](const uint8_t *row, unsigned int x) {
+		const uint8_t *p = row + (size_t)x * bpp;
+		return (int)p[0] + (int)p[1] + (int)p[2];
+	};
+
+	int64_t acc = 0;
+	unsigned int n = 0;
+
+	for (unsigned int y = y0; y < y1; y++) {
+		const uint8_t *row = data + (size_t)y * cfg.stride;
+		for (unsigned int x = x0; x < x1; x++) {
+			int l = luma(row, x);
+			int dx = l - luma(row, x - 1);
+			int dy = l - luma(row - cfg.stride, x);
+			acc += (int64_t)dx * dx + (int64_t)dy * dy;
+			n++;
+		}
+	}
+
+	if (!n)
+		return -1;
+
+	/*
+	 * liuqin: keep the raw gradient energy and rely on the dwell below
+	 * for exposure stability.  Normalising by the mean luma was tried
+	 * and reverted: on a defocused (dark) position the AE pushes the
+	 * gain and the extra noise then dominates a mean-normalised score,
+	 * which is how the sweep came to prefer position 0.
+	 */
+	return acc / n;
+}
+
+void SimpleCameraData::afRun(FrameBuffer *buffer)
+{
+	if (!focusLens_)
+		return;
+
+	Request *request = buffer->request();
+	ControlList &meta = request->_d()->metadata();
+
+	/* Report LensPosition whenever it is known, in every mode. */
+	auto reportPosition = [&]() {
+		if (af_.cur >= 0)
+			meta.set(controls::LensPosition, (float)af_.cur);
+	};
+
+	/*
+	 * Move the lens and track consecutive write failures.  The VCM can
+	 * fail (typically -EIO on a bus glitch); after three consecutive
+	 * failures afRun() reports AfStateFailed and drops back to Idle
+	 * instead of pretending the lens moved.
+	 */
+	auto moveLens = [&](int32_t position) {
+		int ret = focusLens_->setFocusPosition(position);
+		if (ret < 0) {
+			af_.failCount++;
+			LOG(SimplePipeline, Warning)
+				<< "Failed to set lens position " << position
+				<< ": " << strerror(-ret);
+			return false;
+		}
+		af_.failCount = 0;
+		return true;
+	};
+
+	auto failAf = [&]() {
+		LOG(SimplePipeline, Warning)
+			<< "AF disabled after " << af_.failCount
+			<< " consecutive lens write failures";
+		af_.state = Af::State::Idle;
+		af_.started = false;
+		af_.settle = 90;
+		af_.track = false;
+		reportPosition();
+		meta.set(controls::AfState, controls::AfStateFailed);
+	};
+
+	/*
+	 * Manual mode never scans: the application drives the lens through
+	 * LensPosition (honoured in queueRequestDevice()) and we only report
+	 * the position it last asked for.  AfState stays Idle.  Reporting
+	 * AfStateFocused here (as an earlier version did) claimed a lock the
+	 * pipeline never established.
+	 */
+	if (af_.mode == controls::AfModeManual) {
+		reportPosition();
+		meta.set(controls::AfState, controls::AfStateIdle);
+		return;
+	}
+
+	/*
+	 * Auto mode is dormant until AfTriggerStart arms a scan.  It must not
+	 * sweep on its own: an application that merely selects AfModeAuto
+	 * would otherwise get a full sweep it never asked for.
+	 */
+	if (af_.mode == controls::AfModeAuto && !af_.started &&
+	    af_.state == Af::State::Idle) {
+		reportPosition();
+		meta.set(controls::AfState, controls::AfStateIdle);
+		return;
+	}
+
+	/*
+	 * Only a 32-bpp processed frame can be scored.  When this buffer
+	 * cannot be scored, report the state and return without touching the
+	 * state machine, so a raw-first configuration can never step the
+	 * sweep with a bogus score.
+	 */
+	const int64_t score = afScore(buffer);
+	if (score < 0) {
+		reportPosition();
+		meta.set(controls::AfState, af_.state == Af::State::Idle
+						   ? controls::AfStateIdle
+						   : controls::AfStateScanning);
+		return;
+	}
+
+	if (af_.state == Af::State::Locked) {
+		/*
+		 * Auto mode has completed the scan it was triggered for and
+		 * stays put (reporting Focused) until the next
+		 * AfTriggerStart.
+		 */
+		if (af_.mode == controls::AfModeAuto) {
+			af_.started = false;
+			reportPosition();
+			meta.set(controls::AfState, controls::AfStateFocused);
+			return;
+		}
+
+		/*
+		 * Continuous tracking: once frames stop looking like what we
+		 * locked on (sharply lower score, sustained), re-examine the
+		 * neighbourhood instead of trusting the stored position.
+		 */
+		if (af_.cooldown > 0)
+			af_.cooldown--;
+
+		if (af_.lockedScore > 0 &&
+		    score * 3 < af_.lockedScore)
+			af_.lowStreak++;
+		else
+			af_.lowStreak = 0;
+
+		if (af_.cooldown == 0 && af_.lowStreak >= 10) {
+			const int32_t span =
+				std::max<int32_t>((af_.hi - af_.lo) / 16, 16);
+			af_.count = 5;
+			for (int i = 0; i < 5; i++)
+				af_.pts[i] = std::clamp(af_.lockedPos - span +
+							(span / 2) * i, af_.lo, af_.hi);
+			af_.idx = 0;
+			af_.bestScore = -1;
+			af_.best = -1;
+			af_.track = true;
+			af_.state = Af::State::Fine;
+			af_.lowStreak = 0;
+			LOG(SimplePipeline, Debug)
+				<< "AF tracking rescan around " << af_.lockedPos;
+			af_.cur = af_.pts[0];
+			if (!moveLens(af_.cur) && af_.failCount >= 3) {
+				failAf();
+				return;
+			}
+			reportPosition();
+			meta.set(controls::AfState, controls::AfStateScanning);
+			return;
+		}
+
+		reportPosition();
+		meta.set(controls::AfState, controls::AfStateFocused);
+		return;
+	}
+
+	if (af_.state == Af::State::Idle) {
+		if (af_.settle > 0) {
+			af_.settle--;
+			reportPosition();
+			meta.set(controls::AfState, controls::AfStateIdle);
+			return;
+		}
+		const ControlInfoMap &ctrls = focusLens_->controls();
+		auto it = ctrls.find(V4L2_CID_FOCUS_ABSOLUTE);
+		if (it != ctrls.end()) {
+			af_.lo = it->second.min().get<int32_t>();
+			af_.hi = it->second.max().get<int32_t>();
+		}
+		af_.count = 9;
+		for (int i = 0; i < 9; i++)
+			af_.pts[i] = af_.lo + (af_.hi - af_.lo) * i / 8;
+		af_.idx = 0;
+		af_.state = Af::State::Coarse;
+	} else {
+		if (af_.dwell > 0) {
+			/*
+			 * The frames right after a focus move are useless to
+			 * score: the VCM is still moving and the AE is still
+			 * chasing the new (de)focus.  Measured: with only 3
+			 * frames of dwell the AE's gain swing dominated the
+			 * score.  Drop 11, score the 12th, then step.
+			 */
+			af_.dwell--;
+			reportPosition();
+			meta.set(controls::AfState, controls::AfStateScanning);
+			return;
+		}
+		if (score > af_.bestScore) {
+			af_.bestScore = score;
+			af_.best = af_.cur;
+		}
+		af_.idx++;
+		af_.dwell = 11;
+	}
+
+	if (af_.idx >= af_.count) {
+		if (af_.state == Af::State::Coarse) {
+			const int32_t span = (af_.hi - af_.lo) / 8;
+			af_.count = 6;
+			for (int i = 0; i < 6; i++)
+				af_.pts[i] = std::clamp(af_.best - span +
+							(2 * span * i) / 5, af_.lo, af_.hi);
+			af_.idx = 0;
+			af_.state = Af::State::Fine;
+			LOG(SimplePipeline, Debug)
+				<< "AF coarse best " << af_.best
+				<< " (score " << af_.bestScore << "), fine scan";
+		} else {
+			/* the fine scan (initial or tracking) finished */
+			if (af_.track) {
+				af_.track = false;
+				if (af_.best >= 0 && af_.bestScore > af_.lockedScore) {
+					af_.lockedPos = af_.best;
+					af_.lockedScore = af_.bestScore;
+				} else {
+					/* nothing better: restore and back off */
+					af_.cooldown = 75;
+					af_.bestScore = af_.lockedScore;
+				}
+			} else if (af_.best >= 0) {
+				af_.lockedPos = af_.best;
+				af_.lockedScore = af_.bestScore;
+			} else {
+				/* no frame scored; keep the lens where it is */
+				af_.lockedPos = af_.cur >= 0 ? af_.cur : af_.lo;
+				af_.lockedScore = -1;
+			}
+			af_.cur = af_.lockedPos;
+			af_.state = Af::State::Locked;
+			if (af_.mode == controls::AfModeAuto)
+				af_.started = false;
+			af_.lowStreak = 0;
+			LOG(SimplePipeline, Debug)
+				<< "AF locked at " << af_.cur
+				<< " (score " << af_.lockedScore << ")";
+			if (!moveLens(af_.cur) && af_.failCount >= 3) {
+				failAf();
+				return;
+			}
+			reportPosition();
+			meta.set(controls::AfState, controls::AfStateFocused);
+			return;
+		}
+	}
+
+	af_.cur = af_.pts[af_.idx];
+	if (!moveLens(af_.cur) && af_.failCount >= 3) {
+		failAf();
+		return;
+	}
+	reportPosition();
+	meta.set(controls::AfState, controls::AfStateScanning);
+}
+
 int SimplePipelineHandler::queueRequestDevice(Camera *camera, Request *request)
 {
 	SimpleCameraData *data = cameraData(camera);
 	int ret;
 
 	if (data->focusLens()) {
+		SimpleCameraData::Af &af = data->af_;
+
+		if (auto mode = request->controls().get(controls::AfMode)) {
+			if (*mode != af.mode) {
+				af.mode = *mode;
+				switch (*mode) {
+				case controls::AfModeManual:
+					/*
+					 * Stop scanning and stay put; a
+					 * LensPosition in this same request is
+					 * honoured below.
+					 */
+					af.state = SimpleCameraData::Af::State::Idle;
+					af.started = false;
+					break;
+				case controls::AfModeAuto:
+					/* Armed but dormant until AfTriggerStart. */
+					af.reset();
+					break;
+				case controls::AfModeContinuous:
+					/* Restart from a fresh initial sweep. */
+					af.reset();
+					break;
+				}
+			}
+		}
+
+		if (auto trigger = request->controls().get(controls::AfTrigger)) {
+			if (af.mode == controls::AfModeAuto) {
+				if (*trigger == controls::AfTriggerStart) {
+					/*
+					 * Ignore a start while a scan is
+					 * already running.
+					 */
+					if (!af.started) {
+						af.reset();
+						af.started = true;
+					}
+				} else if (*trigger == controls::AfTriggerCancel) {
+					/*
+					 * Back to Idle; the lens stays.
+					 * Ignored when no scan is running
+					 * (e.g. after one completed).
+					 */
+					if (af.started) {
+						af.started = false;
+						af.state = SimpleCameraData::Af::State::Idle;
+					}
+				}
+			}
+		}
+
 		if (auto lp = request->controls().get(controls::LensPosition)) {
-			int32_t position = static_cast<int32_t>(std::lround(*lp));
-			ret = data->focusLens()->setFocusPosition(position);
-			if (ret < 0)
+			if (af.mode == controls::AfModeManual) {
+				int32_t position = static_cast<int32_t>(std::lround(*lp));
+				af.cur = position;
+				ret = data->focusLens()->setFocusPosition(position);
+				if (ret < 0)
+					LOG(SimplePipeline, Warning)
+						<< "Failed to set lens position " << position
+						<< ": " << strerror(-ret);
+			} else if (!af.warnedLensPosition) {
+				/*
+				 * LensPosition is only honoured in manual
+				 * mode; warn once per stream instead of every
+				 * frame so a misbehaving application stays
+				 * diagnosable without flooding the log.
+				 */
+				af.warnedLensPosition = true;
 				LOG(SimplePipeline, Warning)
-					<< "Failed to set lens position " << position
-					<< ": " << strerror(-ret);
+					<< "Ignoring LensPosition in non-manual AF mode";
+			}
 		}
 	}
 
