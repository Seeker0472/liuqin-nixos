+/**
+ * \brief Measure the local contrast of a processed frame
+ * \param[in] frame The frame number
+ * \param[in] data Pointer to the start of the processed frame
+ * \param[in] stride The number of bytes per line
+ * \param[in] bpp The number of bytes per pixel
+ * \param[in] size The size of the processed frame in pixels
+ *
+ * The autofocus algorithm needs a sharpness figure of merit to rank lens
+ * positions, and the software ISP is the only component that has the
+ * processed frame.  Measure a normalized Tenengrad: the sum of squared
+ * luminance gradients divided by the sum of squared luminance, over the
+ * central 3/5 of the frame.  The normalization makes frames taken at
+ * different exposures comparable, which matters because the autofocus
+ * algorithm compares scores across scans.
+ *
+ * The measurement follows the statistics cadence (\ref kStatPerNumFrames):
+ * the AF algorithm only sees fresh statistics on those frames, and the other
+ * frames would only burn CPU on a value nobody reads.
+ *
+ * Luma is the sum of the first three bytes of the pixel, which makes the
+ * measure independent of the RGB byte order; the alpha byte of 32-bpp
+ * formats is ignored.
+ */
+void SwStatsCpu::setFocus(uint32_t frame, const uint8_t *data,
+			  unsigned int stride, unsigned int bpp,
+			  const Size &size)
+{
+	if (frame % kStatPerNumFrames)
+		return;
+
+	sharedStats_->focusFoM = 0.0;
+	sharedStats_->focusPixels = 0;
+
+	if (!data || size.width < 3 || size.height < 3)
+		return;
+
+	/*
+	 * The middle of the frame is where the subject usually is; the
+	 * borders add mostly lens-shading gradients that are not focus
+	 * information.
+	 */
+	const unsigned int x0 = std::max(1u, size.width / 5);
+	const unsigned int x1 = size.width - size.width / 5;
+	const unsigned int y0 = std::max(1u, size.height / 5);
+	const unsigned int y1 = size.height - size.height / 5;
+
+	uint64_t sumGradient = 0;
+	uint64_t sumLuma = 0;
+	uint32_t count = 0;
+
+	for (unsigned int y = y0; y < y1; y++) {
+		const uint8_t *row = data + static_cast<size_t>(y) * stride;
+		const uint8_t *prev = row - stride;
+
+		for (unsigned int x = x0; x < x1; x++) {
+			const uint8_t *p = row + static_cast<size_t>(x) * bpp;
+			const uint8_t *left = p - bpp;
+			const uint8_t *up = prev + static_cast<size_t>(x) * bpp;
+			int luma = p[0] + p[1] + p[2];
+			int dx = luma - (left[0] + left[1] + left[2]);
+			int dy = luma - (up[0] + up[1] + up[2]);
+
+			sumGradient += static_cast<uint64_t>(dx * dx + dy * dy);
+			sumLuma += static_cast<uint64_t>(luma * luma);
+			count++;
+		}
+	}
+
+	if (!sumLuma) {
+		/* Nothing measurable (a fully black frame). */
+		return;
+	}
+
+	sharedStats_->focusFoM = static_cast<double>(sumGradient) /
+				 static_cast<double>(sumLuma);
+	sharedStats_->focusPixels = count;
+}
