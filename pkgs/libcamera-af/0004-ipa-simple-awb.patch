+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	/*
+	 * Bound how far the red and blue gains may sit from green.
+	 *
+	 * Plain grey-world drives any scene whose average hue is not neutral
+	 * to grey - measured on the device, a screenful of saturated red
+	 * converges to R=G=B=232 and a warm-lit room comes out looking black
+	 * and white.  Strongly tinted illuminants lose some accuracy, which
+	 * is the price of keeping colour in ordinary scenes.
+	 *
+	 * The bound is a tuning parameter (per sensor): a module with measured
+	 * colour matrices and calibration can afford a wider one.
+	 */
+	maxGain_ = tuningData["max-gain"].get<float>(maxGain_);
+	maxGain_ = std::clamp(maxGain_, 1.0f, 16.0f);
+
+	return 0;
+}
