+		std::clamp(static_cast<float>(sum.g()) / sum.r(), minGain, maxGain_),
 		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		std::clamp(static_cast<float>(sum.g()) / sum.b(), minGain, maxGain_),
 	} };
 
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
