+	 * Calculate red and blue gains for AWB and bound how far they may sit
+	 * from green (max-gain): grey-world's correction is only trusted that
+	 * far, so a scene that is colour-dominant on average keeps its colour
+	 * instead of being neutralised.
 	 */
 	auto &gains = context.activeState.awb.gains;
+	const float minGain = 1.0f / maxGain_;
