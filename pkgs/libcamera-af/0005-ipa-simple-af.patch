+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, liuqin port
+ *
+ * Autofocus
+ *
+ * The state machine is ported from the CDAF half of the RPi IPA's Af
+ * algorithm (BSD-2-Clause, Copyright (C) 2022-2023 Raspberry Pi Ltd):
+ * a programmed coarse scan that reverses direction when it starts too
+ * close to the peak to bracket it, early termination when the contrast
+ * falls below a fraction of the best sample, a fine scan around the
+ * coarse peak, a parabola fit for a sub-step lock, and a final check
+ * that the peak was actually bracketed before reporting Focused.
+ *
+ * Positions are in dioptres (1/m); the piecewise-linear `map` converts
+ * them to the lens driver's DAC units.  PDAF is not part of this port:
+ * the sensor's phase data has no path to this ISP, so the scan always
+ * runs the CDAF path.
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "libipa/pwl.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext, const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class ScanState { Idle, Trigger, Coarse1, Coarse2, Fine, Settle };
+
+	struct Range {
+		double min = 0.0;
+		double max = 10.0;
+		double def = 1.0;
+	};
+
+	struct Speed {
+		double stepCoarse = 1.0;
+		double stepFine = 0.25;
+		double contrastRatio = 0.75;
+		double retriggerRatio = 0.75;
+		unsigned int retriggerDelay = 6;	/* ticks */
+		unsigned int stepTicks = 0;		/* extra ticks per step */
+	};
+
+	struct ScanRecord {
+		double position;
+		double contrast;
+	};
+
+	void goIdle();
+	void triggerScan();
+	void startProgrammedScan(IPAContext &context);
+	void moveLens(IPAContext &context, double position, bool force = false);
+	void doScanSample(IPAContext &context, double contrast);
+	double findPeak(unsigned int index) const;
+	void getAverage(const SwIspStats *stats, double average[3]) const;
+	void setSceneReference(const SwIspStats *stats, double contrast);
+	bool sceneChanged(const SwIspStats *stats, double contrast) const;
+
+	/* Tuning */
+	Range range_;
+	Speed speed_;
+	ipa::Pwl map_;			/* dioptres -> lens DAC */
+	unsigned int skipFrames_ = 60;
+
+	/* Lens range, from the pipeline handler */
+	bool hasLens_ = false;
+	int32_t lensMin_ = 0;
+	int32_t lensMax_ = 1023;
+
+	/* State machine */
+	ScanState scanState_ = ScanState::Idle;
+	int32_t mode_ = controls::AfModeContinuous;
+	bool started_ = false;		/* Auto: AfTriggerStart armed a scan */
+	uint32_t skipUntilFrame_ = 0;	/* No samples before this stream frame */
+	bool initted_ = false;		/* The lens position is known */
+	double ftarget_ = 0.0;		/* The position to measure next */
+	double fsmooth_ = 0.0;		/* The position the lens is at */
+	int32_t appliedDac_ = -1;	/* The DAC value last sent to the lens */
+	bool pending_ = false;		/* ftarget_ is awaiting its frame */
+	unsigned int waitTicks_ = 0;	/* Ticks left before the frame counts */
+	int32_t manualDac_ = -1;	/* The application's raw-DAC position */
+
+	/* Scan data */
+	double scanStep_ = 0.0;
+	double scanMaxContrast_ = 0.0;
+	double scanMinContrast_ = 1.0e9;
