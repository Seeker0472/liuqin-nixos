 	ASSERT(video_);
 
 	/*
+	 * If the sensor has a focus lens (a MEDIA_ENT_F_LENS entity linked
+	 * through the sensor's lens-focus property), expose its absolute
+	 * focus range as the core LensPosition control and register the AF
+	 * controls that drive it.  The lens position units are the lens
+	 * driver's raw position units until a dioptre mapping is calibrated,
+	 * so LensPosition is documented as raw units rather than pretending
+	 * to be the spec's dioptres.
+	 *
+	 * The readback obligation that comes with LensPosition (reporting
+	 * the lens position in every frame's metadata) is honoured by the AF
+	 * code added on top of this in the second patch.
+	 *
+	 * AfMode defaults to Continuous, deviating from the core control
+	 * documentation's recommended AfModeManual default: this camera is
+	 * meant to focus itself, and the consumers here (the GNOME camera
+	 * app path) expect continuous contrast AF out of the box.  An
+	 * application can still select Manual and drive LensPosition, or
+	 * Auto and use AfTriggerStart.
+	 */
+	focusLens_ = sensor_->focusLens();
+	if (focusLens_) {
+		const ControlInfoMap &lensCtrls = focusLens_->controls();
+		auto it = lensCtrls.find(V4L2_CID_FOCUS_ABSOLUTE);
+		if (it != lensCtrls.end()) {
+			ControlInfoMap::Map ctrls;
+			for (const auto &[id, info] : controlInfo_)
+				ctrls[id] = info;
+			const ControlInfo &range = it->second;
+			ctrls[&controls::LensPosition] =
+				ControlInfo(static_cast<float>(range.min().get<int32_t>()),
+					    static_cast<float>(range.max().get<int32_t>()),
+					    static_cast<float>(range.def().get<int32_t>()));
+			ctrls[&controls::AfMode] =
+				ControlInfo(controls::AfModeValues,
+					    controls::AfModeContinuous);
+			ctrls[&controls::AfTrigger] =
+				ControlInfo(controls::AfTriggerValues);
+			ctrls[&controls::AfState] =
+				ControlInfo(controls::AfStateValues,
+					    controls::AfStateIdle);
+			controlInfo_ = ControlInfoMap(std::move(ctrls), controlInfo_.idmap());
+		} else {
+			focusLens_ = nullptr;
+		}
+	}
+
+	/*
 	 * Setup links first as some subdev drivers take active links into
 	 * account to propagate TRY formats. Such is life :-(
 	 */
@@ -1739,6 +1791,17 @@
 	SimpleCameraData *data = cameraData(camera);
 	int ret;
 
+	if (data->focusLens()) {
+		if (auto lp = request->controls().get(controls::LensPosition)) {
+			int32_t position = static_cast<int32_t>(std::lround(*lp));
+			ret = data->focusLens()->setFocusPosition(position);
+			if (ret < 0)
+				LOG(SimplePipeline, Warning)
+					<< "Failed to set lens position " << position
+					<< ": " << strerror(-ret);
+		}
+	}
