/* Xiaomi Pad 6 Pro (liuqin) U-Boot environment.
 *
 * The stock ABL leaves its continuous-splash display scanning out at
 * 0xb8000000; the board early renderer mirrors the pre-console log there and
 * the liuqin video driver exposes it as a normal vidconsole. stdout includes
 * vidconsole so the menu and shell stay visible on the panel.
 *
 * The only supported host diagnostic channel is fastboot getvar; no CDC-ACM
 * console is enabled in the safe profile because it was not a reliable path.
 */

/* bootdelay=0: run bootcmd (the bootmenu) immediately. Any button press or
 * UART RX noise during a countdown aborts autoboot and drops to the shell,
 * which left the board sitting at "=>" instead of the menu. */
bootdelay=0
/* Never loop a failed boot command indefinitely: a missing host or a failed
 * Linux load must return to the shell/menu instead of feeding the watchdog in
 * an unattended reset loop. */
bootretry=0
stdin=button-kbd
stdout=vidconsole,serial
stderr=vidconsole,serial
fastboot_addr_r=0x98000000
fastboot=echo USB fastboot: starting...; fastboot -l $fastboot_addr_r usb 0
/* Boot targets.
 *
 * Android is NOT booted by U-Boot. The stock A slot and the hypervisor runtime
 * DT ABL builds for it stay the firmware's business, so "boot Android" only
 * makes ABL pick that slot again: liuqin_setactive performs the complete
 * qbootctl-style hand-off (A/B GPT attributes and type-GUID roles, then UFS
 * bBootLunEn so PBL selects xbl_a/xbl_b) and the reset does the rest. Coming
 * back is the host's job - from Android, `adb reboot bootloader` and then
 * `fastboot set_active b` in ABL's fastboot.
 *
 * NixOS is loaded by U-Boot from the extlinux configuration its loader module
 * installs into the pre-existing "linux" filesystem partition. The labels in
 * that file carry the kernel, initrd, device tree and kernel command line for
 * every system generation NixOS keeps, so no generation is hard-coded here and
 * U-Boot never creates or modifies the partition.
 *
 * The load addresses stay clear of everything else this board uses: the
 * fastboot download buffer (0x98000000), the kernel's bootlog ring
 * (0x9f000000), ramoops (0xa7000000) and ABL's continuous-splash framebuffer
 * (0xb8000000, the end cap for the initrd). */
boot_android=liuqin_setactive a hold reset
/* 0x90000000/0x9e000000 are inside the ABL MPSS/mailbox reservation
 * (0x8bc00000..0x9ee00000).  Keep all Linux payloads in the previously
 * validated window between ramoops and the continuous-splash framebuffer.
 * The first three names are the ones the extlinux loader reads
 * (boot/pxe_utils.c); pxefile_addr_r holds the configuration file only while
 * it is parsed, i.e. before any of those payloads is loaded, so it only has to
 * stay clear of what must survive the parse. */
kernel_addr_r=0xb3000000
ramdisk_addr_r=0xa7400000
fdt_addr_r=0xb2000000
pxefile_addr_r=0xb0000000
/* NixOS installs its generation list here: labels, kernels, initrds, device
 * trees and command lines all live in this one file on the `linux` partition,
 * and the loader behind `sysboot` reads them out of it. */
linux_conf=/boot/extlinux/extlinux.conf
/* TODO(device): the lookup below is `part number scsi 0 linux ...`, and
 * "scsi 0" is NOT the UFS LUN number: scsi_scan() creates one block device
 * per detected LUN (drivers/scsi/scsi.c) and blk_create_device() hands out
 * devnum = "next free" in creation order (drivers/block/blk-uclass.c), so
 * "scsi 0" is *the first LUN the scan found*. The scan walks lun 0 upwards and
 * this board reports all six LUNs, so it is expected to be LUN0 - which is
 * where userdata, and therefore the carved-out `linux` partition, lives.
 * That identity has never been observed on the unit: if a LUN is ever skipped
 * or the order changes, this lookup moves to another LUN and only fails
 * ("NixOS: no partition named \"linux\"" - nothing is written, nothing
 * boots). Confirm it before trusting this path: the pairing to print is
 * devnum -> lun (liuqin_ab_hold() already dumps lun per SCSI device, but not
 * the devnum it is reachable as). */
/* 24 h: nothing in mainline pets Gunyah's vWDT, so the hand-off inherits this
 * value. Keeping it finite (rather than disabling the watchdog outright) means
 * a wedged kernel still recovers by itself - slowly - instead of hanging
 * forever, which is what disabling it here would do. U-Boot only pets the
 * watchdog while it runs; it does not touch its bark/bite times. */
vwdt_linux_ms=86400000
/* Boot NixOS with no menu.  pxe_no_menu makes the extlinux loader take DEFAULT
 * straight away, i.e. the generation NixOS installed last; how many
 * generations exist and where they live stays NixOS's business. */
boot_nixos=setenv linux_part -1; part number scsi 0 linux linux_part; if test ${linux_part} -gt 0; then setenv pxe_no_menu 1; echo NixOS: ${linux_conf} on partition ${linux_part}, vwdt ${vwdt_linux_ms} ms; liuqin_vwdt ${vwdt_linux_ms}; sysboot scsi 0:${linux_part} any ${pxefile_addr_r} ${linux_conf} || echo NixOS: sysboot failed; else echo NixOS: no partition named "linux"; fi; pause
/* The generation menu: the same file, listed by the loader itself.  Volume
 * keys move the highlight, the power key selects, and the loader's own last
 * item leaves the menu without booting anything.  The menu redraws in place
 * (boot/pxe_utils.c draws it into one fixed row per label), and its own
 * TIMEOUT - boot.loader.timeout on the NixOS side, 100 = 10 s - picks DEFAULT
 * when nobody presses a button.  pxe_no_menu is cleared, in case a previous
 * Boot NixOS left it set. */
boot_nixos_menu=setenv linux_part -1; part number scsi 0 linux linux_part; if test ${linux_part} -gt 0; then setenv pxe_no_menu; echo NixOS: ${linux_conf} on partition ${linux_part}, generations; liuqin_vwdt ${vwdt_linux_ms}; sysboot scsi 0:${linux_part} any ${pxefile_addr_r} ${linux_conf} || echo NixOS: sysboot failed; else echo NixOS: no partition named "linux"; fi; pause
/* Menu. cmd/bootmenu.c re-displays the menu after every entry that returned
 * success. Boot paths plus reset/poweroff are exposed; diagnostic and
 * bulk installation-time operations are not menu actions. One entry is the
 * exception, because it reaches a state U-Boot cannot reach by itself:
 * "Reboot to ABL" hands control back to the stock ABL fastboot (the same
 * restart reason as the host's "fastboot reboot-bootloader", and the only
 * flashing endpoint this image has).
 *
 * NixOS is the default: it is the first entry, and menucmd's 5 s autoboot
 * countdown runs it when nobody touches a button. That is the safe default for
 * an unattended boot - a NixOS boot that cannot proceed prints why and pauses
 * on the panel - while "Boot Android" is a persistent slot *selection* (below)
 * and must never be reached by a countdown nobody watched.
 *
 * "Boot Android" is a slot *selection*, and a switch on this device has two
 * halves: the GPT attributes and the UFS bBootLunEn attribute that PBL reads to
 * choose xbl_a (LUN1) or xbl_b (LUN2), plus the A/B type-GUID roles ABL
 * validates. The boot-time claim (liuqin_slot_autoclaim) writes the attribute
 * byte only - a claim is not a selection (FACTS.md §3.3).
 *
 * The older repair entries (Repair GPT Geometry, Re-arm Slot B, Restore GPT
 * Identity, and the identity dump that went with them) are gone: each was a
 * second writer of a structure this board's boot chain already owns, and every
 * one of them has a stock replacement (ABL's set_active for the slot state,
 * `fastboot flash partition:*` for the identity layer). FACTS.md §3.3.
 *
 * All writing entries pass "hold": on failure the command prints the whole
 * picture (the steps it took, the LUNs, the table re-read from disk with every
 * field and CRC, plus the first bytes in hex) and then stays there instead of
 * letting the menu redraw the screen - this board has no UART, and without it
 * the reason for a refusal is on the panel for well under a second
 * (DEBUGGING.md §1). A host-reaching path never passes it, so no host can be
 * hung. Leave the hold with a power-cycle. */
bootmenu_0=Boot NixOS=run boot_nixos
bootmenu_1=NixOS Generations=run boot_nixos_menu
bootmenu_2=Boot Android=run boot_android
bootmenu_3=Enable Fastboot Mode=run fastboot
bootmenu_4=Reset Device=reset
/* True power off: the PMIC PON is set to SHUTDOWN and SCM deasserts PS_HOLD
 * (PSCI SYSTEM_OFF only warm-resets this board). Boot Android's reset command
 * uses the board's vendor-style PMIC/SCM normal-reboot hand-off. */
bootmenu_5=Power Off=poweroff
/* Panel twin of the host's "fastboot reboot-bootloader": writes the IMEM/SDAM
 * bootloader restart reason (ablfastboot refuses to reset if the write did not
 * take, and prints both cells back so the panel shows what ABL will read). */
bootmenu_6=Reboot to ABL=ablfastboot
/* Read-only: probe the table that carries the slots (both copies, both CRCs,
 * the boot_a/boot_b attributes) and keep the result on the panel until a
 * button. This is the evidence a host would read as fastboot.gptp*, and the
 * only way to get it without a host: CONFIG_FASTBOOT_OEM_RUN is off, so a menu
 * entry is the sole entry point. Writes nothing. */
bootmenu_7=GPT Probe (read-only)=liuqin_gptprobe hold
/* Read-only: scan a partition for the lines that decide a boot, and export the
 * matches as fastboot.scan*.  "logfs" carries ABL's own log - which slot it
 * picked, the retry count, whether it rebuilt a table copy ("Restore backup
 * partition table by the primary"), how many entries it repaired, and whether
 * the boot lun it keeps disagrees with the slot it is booting (that one fails
 * the boot with EFI_DEVICE_ERROR).  It is text in a partition, so it can be
 * read in exactly the state where no slot boots and Android is gone - which is
 * when the evidence is needed and when a host-side readback is impossible.
 * Writes nothing. */
bootmenu_8=Scan ABL Log (read-only)=liuqin_blkscan logfs hold
/* Only map buttons whose label exists in the DT (gpio-keys has "Volume Up",
 * the PMIC has pwrkey/resin); bogus names make process_button_cmds() log an
 * error on every shell loop. */
button_cmd_0_name=pwrkey
button_cmd_0=run menucmd
/* 5 s to a button press, then entry 0 (Boot NixOS); any button stops the
 * countdown. Only the first showing counts down - cmd/bootmenu.c asks again
 * with no delay after an entry completed, so doing nothing here cannot turn
 * into a boot loop. */
menucmd=setenv bootcmd run menucmd; bootmenu 5
/* The menu is the default entry point (entry 3 starts the USB fastboot
 * gadget). For fully hands-free host-side work - no button press at all - set
 * this to "run fastboot" instead; that skips the menu and the gadget is only
 * up while U-Boot runs. */
bootcmd=run menucmd
