+
 int boot_selected_os(int state, struct bootm_info *bmi, boot_os_fn *boot_fn)
 {
+	/* boot_fn returning after cleanup still requires the usual reset below.
+	 * Reject a handoff BEFORE entering it, while providers and console live.
+	 * Do not leak errno/libfdt values into BOOTM_ERR_RESET's -1 namespace.
+	 */
+	if (state == BOOTM_STATE_OS_GO && bmi->images->os.os == IH_OS_LINUX &&
+	    board_linux_handoff(bmi->images))
+		return 1;
+
 	arch_preboot_os();
 	board_preboot_os();
 
