diff --git a/drivers/gpio/qcom_pmic_gpio.c b/drivers/gpio/qcom_pmic_gpio.c
--- a/drivers/gpio/qcom_pmic_gpio.c
+++ b/drivers/gpio/qcom_pmic_gpio.c
@@ -56,6 +56,7 @@
 #define REG_DIG_VIN_VIN0       0
 
 #define REG_DIG_PULL_CTL       0x42
+#define REG_DIG_PULL_UP_30     0x0	/* 30 uA pull-up, as dt-bindings */
 #define REG_DIG_PULL_NO_PU     0x5
 
 #define REG_LV_MV_OUTPUT_CTL	0x44
@@ -127,9 +128,14 @@
 
 	_qcom_gpio_set_direction(dev, offset, input, value);
 
-	/* Set the right pull (no pull) */
+	/*
+	 * Set the right pull. U-Boot's PMIC pinconf implementation cannot
+	 * express bias yet, so a pin configured as an input (e.g. the liuqin
+	 * volume-up key, bias-pull-up in the DT) would otherwise float and
+	 * read randomly. Give inputs the 30 uA pull-up the DT asks for.
+	 */
 	ret = pmic_reg_write(plat->pmic, gpio_base + REG_DIG_PULL_CTL,
-			     REG_DIG_PULL_NO_PU);
+			     input ? REG_DIG_PULL_UP_30 : REG_DIG_PULL_NO_PU);
 	if (ret < 0)
 		return ret;
 
