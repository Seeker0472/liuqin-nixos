diff --git a/drivers/pinctrl/pinctrl-uclass.c b/drivers/pinctrl/pinctrl-uclass.c
--- a/drivers/pinctrl/pinctrl-uclass.c
+++ b/drivers/pinctrl/pinctrl-uclass.c
@@ -155,8 +155,17 @@
 			return -EINVAL;
 		ret = device_bind_driver_to_node(dev, "pinconfig", name,
 						 node, NULL);
-		if (ret)
-			return ret;
+		if (ret) {
+			/*
+			 * Keep going: one unbindable state node must not hide
+			 * all the other pin configuration nodes (seen on
+			 * qcom/sm8450 where a single failure starved every
+			 * peripheral of its pinmux).
+			 */
+			debug("%s: cannot bind pinconfig node %s: %d\n",
+			      __func__, name, ret);
+			continue;
+		}
 	}
 
 	return 0;
