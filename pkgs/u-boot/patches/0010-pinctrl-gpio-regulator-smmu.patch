+/*
+ * PM8350 (SM8450). Subset needed by the liuqin board: s10/l2 power the PTN3222
+ * eUSB2 repeater, l2 also the USB2 HS PHY 3.0 V rail (all from the Linux
+ * qcom-rpmh-regulator tables). ldo5 (PHY vdda-pll) uses pmic5_nldo515, which
+ * shares the 320 mV/8 mV linear range with Linux's pmic5_nldo below 1.3 V.
+ */
+static const struct rpmh_vreg_init_data pm8350_vreg_data[] = {
+	RPMH_VREG("smps10", "smp%s10", &pmic5_hfsmps510, "vdd-s10"),
+	RPMH_VREG("ldo2",   "ldo%s2",  &pmic5_pldo,      "vdd-l2-l7"),
+	RPMH_VREG("ldo5",   "ldo%s5",  &pmic5_nldo515,   "vdd-l3-l5"),
+	/* ldo7 powers the UFS VCC rail, ldo9 the UFS VCCQ/vdd-hba rail */
+	RPMH_VREG("ldo7",   "ldo%s7",  &pmic5_pldo,      "vdd-l2-l7"),
+	RPMH_VREG("ldo9",   "ldo%s9",  &pmic5_nldo515,   "vdd-l6-l9-l10"),
+	{}
+};
+
+/*
+ * PM8350C (SM8450). ldo1 is the older DT's USB2 HS PHY vdda18 rail; ldo10 is
+ * the vdda12 (1.2 V) rail the PHY needs for its digital/UTMI section - the
+ * mainline liuqin DT moved the PHY over to it. Inputs are pm8350c_s1/bob,
+ * which the boot chain leaves enabled.
+ */
+static const struct rpmh_vreg_init_data pm8350c_vreg_data[] = {
+	RPMH_VREG("ldo1",   "ldo%s1",  &pmic5_pldo_lv,   "vdd-l1-l12"),
+	RPMH_VREG("ldo10",  "ldo%s10", &pmic5_nldo515,   "vdd-l10"),
+	{}
+};
