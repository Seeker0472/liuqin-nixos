+/* A failed transfer must not turn into an unbounded wait for abort itself.
+ * Keep this bounded even if the serial engine no longer completes commands.
+ */
+static int geni_i2c_abort(struct geni_i2c_priv *geni)
+{
+	u32 elapsed, status;
+
+	writel(M_GENI_CMD_ABORT, geni->base + SE_GENI_M_CMD_CTRL_REG);
+	for (elapsed = 0; elapsed < 1000000; elapsed += 10) {
+		status = readl(geni->base + SE_GENI_M_IRQ_STATUS);
+		if (status & M_CMD_ABORT_EN) {
+			writel(status, geni->base + SE_GENI_M_IRQ_CLEAR);
+			return 0;
+		}
+		udelay(10);
+	}
+	return -ETIMEDOUT;
+}
