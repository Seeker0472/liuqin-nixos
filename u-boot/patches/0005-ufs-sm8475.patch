+/**
+ * ufshcd_query_attr() - send a UFS Query Attribute request
+ *
+ * The existing U-Boot driver had the Query opcode and the attribute ID in its
+ * definitions, but only implemented the flag and descriptor helpers.  In
+ * particular, bBootLunEn is not a GPT field: it is the UFS device attribute
+ * that PBL uses to choose xbl_a (LUN 1) or xbl_b (LUN 2).  Keep this path
+ * beside ufshcd_query_flag() so it uses the same command descriptor, response
+ * checking, cache maintenance, and timeout behavior as the other Query
+ * requests.
+ */
+static int ufshcd_query_attr(struct ufs_hba *hba, enum query_opcode opcode,
+			     enum attr_idn idn, u8 index, u8 selector,
+			     u32 *attr_val)
+{
+	struct ufs_query_req *request = NULL;
+	struct ufs_query_res *response = NULL;
+	int err;
+
+	if (!attr_val)
+		return -EINVAL;
+
+	ufshcd_init_query(hba, &request, &response, opcode, idn, index,
+			  selector);
+
+	switch (opcode) {
+	case UPIU_QUERY_OPCODE_WRITE_ATTR:
+		request->query_func = UPIU_QUERY_FUNC_STANDARD_WRITE_REQUEST;
+		request->upiu_req.value = cpu_to_be32(*attr_val);
+		break;
+	case UPIU_QUERY_OPCODE_READ_ATTR:
+		request->query_func = UPIU_QUERY_FUNC_STANDARD_READ_REQUEST;
+		break;
+	default:
+		dev_err(hba->dev,
+			"%s: expected read/write attribute opcode, got 0x%x\n",
+			__func__, opcode);
+		return -EINVAL;
+	}
+
+	err = ufshcd_exec_dev_cmd(hba, DEV_CMD_TYPE_QUERY, QUERY_REQ_TIMEOUT);
+	if (err) {
+		dev_err(hba->dev,
+			"%s: opcode 0x%x for idn %d failed, err = %d\n",
+			__func__, opcode, idn, err);
+		return err;
+	}
+
+	/* For a write this is the device's response value; for a read it is the
+	 * requested attribute.  Returning it makes the helper useful for both and
+	 * lets the board code verify a write with a separate read. */
+	*attr_val = be32_to_cpu(response->upiu_res.value);
+	return 0;
+}
+
+static int ufshcd_query_attr_retry(struct ufs_hba *hba,
+				   enum query_opcode opcode, enum attr_idn idn,
+				   u8 index, u8 selector, u32 *attr_val)
+{
+	int ret = -EIO;
+	int retries;
+
+	for (retries = 0; retries < QUERY_REQ_RETRIES; retries++) {
+		ret = ufshcd_query_attr(hba, opcode, idn, index, selector,
+					attr_val);
+		if (!ret)
+			break;
+		dev_dbg(hba->dev,
+			"%s: failed with error %d, retry %d\n",
+			__func__, ret, retries + 1);
+	}
+
+	if (ret)
+		dev_err(hba->dev,
+			"%s: opcode 0x%x, idn %d failed with error %d after %d retries\n",
+			__func__, opcode, idn, ret, retries);
+
+	return ret;
+}
