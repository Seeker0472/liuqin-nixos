+static int ufs_get_hba(struct ufs_hba **hba)
+{
+	struct udevice *dev;
+	int ret;
+
+	if (!hba)
+		return -EINVAL;
+
+	ret = uclass_get_device(UCLASS_UFS, 0, &dev);
+	if (ret)
+		return ret;
+
+	*hba = dev_get_uclass_priv(dev);
