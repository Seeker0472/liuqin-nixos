+	if (readl_relaxed(hba->mmio_base + REG_UFS_SYS1CLK_1US) !=
+	    cycles_per_us) {
+		writel_relaxed(cycles_per_us,
+			       hba->mmio_base + REG_UFS_SYS1CLK_1US);
+		/* make sure the write is applied before link startup */
+		readl_relaxed(hba->mmio_base + REG_UFS_SYS1CLK_1US);
+	}
