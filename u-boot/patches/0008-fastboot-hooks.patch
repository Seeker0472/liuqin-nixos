 /**
+ * set_active() - Make a slot the next one to boot
+ *
+ * The response only says the request was understood and carried out; where the
+ * slot state lives is the board's business (fastboot_set_active_slot()).
+ */
+static void set_active(char *cmd_parameter, char *response)
+{
+	if (!cmd_parameter || !*cmd_parameter) {
+		fastboot_fail("missing slot suffix", response);
+		return;
+	}
+
+	if (fastboot_set_active_slot(cmd_parameter))
+		fastboot_fail("cannot set active slot", response);
+	else
+		fastboot_okay(NULL, response);
+}
