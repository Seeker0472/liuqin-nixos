+ * The ordinary "fastboot reboot" has no reboot-mode reason to set.  Most
+ * boards can use U-Boot's generic reset directly, but Qualcomm boards with a
+ * vendor PS_HOLD hand-off need a board-specific normal reboot sequence.
+ */
+void __weak fastboot_reboot(void)
+{
+	do_reset(NULL, 0, 0, NULL);
+}
