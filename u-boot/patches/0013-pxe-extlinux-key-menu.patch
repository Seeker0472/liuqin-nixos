+/*
+ * Layout of the interactive menu. Row 1 carries the menu title the generic
+ * menu code prints, row 2 the key hints, and label N sits on its own row
+ * below. Each element is placed by row rather than appended, because the
+ * generic code calls menu_display() again for every redraw and appending
+ * would bury the menu in copies of itself instead of moving the highlight.
+ */
+#define PXE_MENU_HINT_ROW	2	/* key hints, under the title */
+#define PXE_MENU_ITEM_ROW	3	/* label 1; label N is N - 1 rows down */
+
+/**
+ * pxe_label_row() - Console row a label is drawn on
+ *
+ * @label: Label to place
+ * Returns: 1-based console row
+ */
+static int pxe_label_row(struct pxe_label *label)
+{
+	return PXE_MENU_ITEM_ROW + simple_strtol(label->num, NULL, 10) - 1;
+}
