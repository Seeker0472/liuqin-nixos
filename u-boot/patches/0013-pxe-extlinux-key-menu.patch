+/**
+ * pxe_choice_key() - Read one key for the label menu
+ *
+ * Returns: The key, in the bootmenu's key codes
+ */
+static enum bootmenu_key pxe_choice_key(void)
+{
+	int c;
+
+	c = cli_ch_process(&pxe_cch, 0);
+	if (!c) {
+		while (!c && !tstc()) {
+			schedule();
+			mdelay(10);
+		}
+		if (!c) {
+			c = getchar();
+			c = cli_ch_process(&pxe_cch, c);
+		}
+	}
+
+	return bootmenu_conv_key(c);
+}
+
+/**
+ * pxe_choice_wait() - Wait for a keypress, counting down like the bootmenu
+ *
+ * @secs: Seconds to wait
+ * Returns: true if a key arrived, false if the countdown ran out
+ */
+static bool pxe_choice_wait(int secs)
+{
+	bool keyed = false;
+	int i, j;
+
+	for (i = secs; i > 0 && !keyed; i--) {
+		printf("\rHit any key to stop autoboot: %d ", i);
+		for (j = 0; j < 100; j++) {
+			if (tstc()) {
+				keyed = true;
+				break;
+			}
+			schedule();
+			mdelay(10);
+		}
+	}
+
+	/* The countdown is not part of the menu: take its line back. */
+	printf("\r");
+	puts(ANSI_CLEAR_LINE);
+
+	return keyed;
+}
+
+/**
+ * pxe_choice_step() - The label before or after another one
+ *
+ * @cfg: Menu the labels belong to
+ * @from: Label to step from
+ * @dir: -1 for the previous label, 1 for the next one
+ * Returns: The neighbouring label, or NULL at either end of the menu
+ */
+static struct pxe_label *pxe_choice_step(struct pxe_menu *cfg,
+					 struct pxe_label *from, int dir)
+{
+	struct list_head *pos;
+
+	pos = dir < 0 ? from->list.prev : from->list.next;
+	if (pos == &cfg->labels)
+		return NULL;
+
+	return list_entry(pos, struct pxe_label, list);
+}
+
+/**
+ * pxe_menu_done() - Hand the panel back to whatever runs after the menu
+ *
+ * The menu draws itself into fixed rows (see label_print()), so without this
+ * the boot log after a choice - and the device menu after "Back to device
+ * menu" - would start in the middle of the panel.
+ */
+static void pxe_menu_done(void)
+{
+	pxe_menu_open = false;
+	puts(ANSI_CURSOR_SHOW);
+	puts(ANSI_CLEAR_CONSOLE);
+	printf(ANSI_CURSOR_POSITION, 1, 1);
+}
+
+/**
+ * pxe_choice() - Pick a label with the arrow keys
+ *
+ * This is the menu's item_choice callback: it returns the key of the chosen
+ * item, or NULL to have the menu redrawn and asked again. A redraw has to
+ * start where the old menu did, because the generic menu code prints what it
+ * is given below whatever is already on the screen; the fixed rows in
+ * label_print() are only correct from the top.
+ *
+ * Upstream leaves item_choice unset, so a choice can only be made by typing a
+ * number at the "Enter choice:" prompt. A board whose only input is a
+ * volume/power button pair cannot do that, and cli_readline()'s own timeout is
+ * entangled with the boot-retry timer (bootretry_tstc_timeout() compares
+ * against an endtime that only the shell ever sets), so the menu would either
+ * vanish instantly or never take input. The keys are decoded the way the
+ * bootmenu command decodes them, so the same buttons work here.
+ *
+ * @data: struct pxe_menu to choose from
+ * Returns: Key of the chosen item, or NULL if there is no choice yet
+ */
+static char *pxe_choice(void *data)
+{
+	struct pxe_menu *cfg = data;
+	struct pxe_label *label;
+	enum bootmenu_key key;
+
+	/* The countdown runs once, before the user has touched anything. */
+	if (pxe_countdown) {
+		bool keyed = pxe_choice_wait(pxe_countdown);
+
+		pxe_countdown = 0;
+		if (!keyed) {
+			/*
+			 * The countdown picks DEFAULT. Without one there is
+			 * nothing the user asked for, so stay and ask.
+			 */
+			if (!pxe_default) {
+				printf(ANSI_CURSOR_POSITION, 1, 1);
+				return NULL;
+			}
+
+			pxe_menu_done();
+			return pxe_default->num;
+		}
+	}
+
+	for (;;) {
+		key = pxe_choice_key();
+
+		switch (key) {
+		case BKEY_UP:
+			label = pxe_choice_step(cfg, pxe_active, -1);
+			if (label)
+				pxe_active = label;
+			printf(ANSI_CURSOR_POSITION, 1, 1);
+			return NULL;
+		case BKEY_DOWN:
+			label = pxe_choice_step(cfg, pxe_active, 1);
+			if (label)
+				pxe_active = label;
+			printf(ANSI_CURSOR_POSITION, 1, 1);
+			return NULL;
+		case BKEY_SELECT:
+			pxe_menu_done();
+			return pxe_active ? pxe_active->num : NULL;
+		case BKEY_QUIT:
+			pxe_menu_done();
+			return pxe_leave ? pxe_leave->num : NULL;
+		default:
+			break;
+		}
+	}
+}
+
+/**
+ * pxe_add_leave_label() - Add the item that leaves the menu without booting
+ *
+ * A menu whose only exit is to boot something is a trap when the board has no
+ * Escape key: this item carries LOCALBOOT -1, which label_boot() accepts and
+ * boots nothing, so the caller gets control back and can show its own menu
+ * again.
+ *
+ * @cfg: Menu to add the item to
+ * Returns: The new label, or NULL on allocation failure
+ */
+static struct pxe_label *pxe_add_leave_label(struct pxe_menu *cfg)
+{
+	struct pxe_label *label;
+
+	label = label_create();
+	if (!label)
+		return NULL;
+
+	label->name = strdup("Back to device menu");
+	if (!label->name) {
+		label_destroy(label);
+		return NULL;
+	}
+
+	label->localboot = 1;
+	label->localboot_val = -1;
+	list_add_tail(&label->list, &cfg->labels);
+
+	return label;
+}
+
+/**
+ * pxe_menu_statusline() - Tell the user which keys the menu takes
+ *
+ * @m: Menu being displayed
+ */
+static void pxe_menu_statusline(struct menu *m)
+{
+	printf(ANSI_CURSOR_POSITION, PXE_MENU_HINT_ROW, 1);
+	puts(ANSI_CLEAR_LINE);
+	puts("Press UP/DOWN to move, ENTER to select");
+}
