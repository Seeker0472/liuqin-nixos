+/*
+ * State of the interactive label menu (see pxe_choice()). One menu is parsed
+ * at a time, so this is file scope rather than an allocation the caller owns.
+ */
+static struct pxe_label *pxe_active;	/* highlighted label */
+static struct pxe_label *pxe_default;	/* label the countdown picks */
+static struct pxe_label *pxe_leave;	/* label that exits without booting */
+static int pxe_countdown;		/* seconds left, 0 = no countdown */
+static bool pxe_menu_open;		/* interactive menu is on screen */
+static struct cli_ch_state pxe_cch;
