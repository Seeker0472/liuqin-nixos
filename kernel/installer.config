# SPDX-License-Identifier: MIT
#
# Built-in-only additions for the RAM installer. The installer deliberately
# has no module tree: the display, Wi-Fi, USB gadget network and the folio's
# I2C input must be usable before the live root switches from the initramfs
# overlay (the touchscreen is not: its firmware is not in the initrd firmware
# subset, see pkgs/firmware-initrd.nix).

# Tablet input and recovery variants. The magnetic cover uses Nanosic; retain
# the generic HID symbols needed by the tablet input path while this image's
# DT deliberately uses the USB peripheral network path.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_NANOSIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# nixpkgs' netboot module mounts the live store with
# "loop,threads=multi" (it adds the option for every kernel >= 6.2). That
# string form of threads= exists only when the decompressor is chosen at
# mount time; without this symbol mount(2) answers EINVAL, /sysroot/nix/.ro-store
# never mounts, /nix/store never becomes an overlay, and the live system never
# starts - i.e. the RAM installer reaches neither stage 2 nor its own USB
# debug channel. SQUASHFS itself stays a module here (the initrd carries it);
# this is only the mount-time decompressor selector.
CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT=y

# The installer follows the downstream USB2 peripheral networking path. The
# current kernel's DWC3 gadget side is built in; this image's DT overlay
# selects peripheral mode and the initramfs creates an NCM gadget. This image
# has no USB host controller path, so a wired USB keyboard/dock is not a
# supported installer input device; the magnetic folio remains on I2C.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
# This DT is peripheral-only; keep host-controller and USB-HID answers out of
# the installer image even if the generic kernel fragment enables them.
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_XHCI_PLATFORM is not set
# CONFIG_USB_HID is not set

# Keep the early framebuffer and the tested display hand-off path built in.
CONFIG_SERIAL_EARLYCON_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_NOVATEK_NT36532=y
CONFIG_DRM_FBDEV_EMULATION=y
# The screen is this board's only early failure channel, so the installer must
# own it with something that can show a full terminal. With the "log" DRM
# client the panel is seized by a client that only renders the kernel log and
# implements no terminal: with NixOS' loglevel=4 it then clears the screen and
# has nothing to print (measured on the unit: panel probe, both DSI links and
# the backlight all fine, /sys/class/graphics has no fb device and the DRM
# clients list is empty). "fbdev" lets fbcon bind on top of the DRM driver, so
# console=tty0 gives the installer's getty and kernel log on the panel. The
# choice can be overridden at runtime with drm_client_lib.active=fbdev.
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
