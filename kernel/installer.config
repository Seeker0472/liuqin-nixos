# SPDX-License-Identifier: MIT
#
# Built-in-only additions for the RAM installer.  The installer deliberately
# has no module tree: the display, Wi-Fi and USB input paths must be usable
# before the live root has switched from the initramfs overlay.

# USB keyboard/input.  The magnetic cover uses Nanosic; USB keyboards use the
# generic HID transport.  Keeping both built in also makes a recovery keyboard
# work if the cover is not present.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_NANOSIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_USB_HID=y

# The port remains USB2 peripheral-only by default.  The installer overlay
# switches the controller to host mode for a wired keyboard.  Build the DWC3
# core in dual-role mode so the same kernel also retains the validated
# peripheral path if the overlay is removed during recovery.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# Keep the early framebuffer and the tested display hand-off path built in.
CONFIG_SERIAL_EARLYCON_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_NOVATEK_NT36532=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_LOG=y
CONFIG_DRM_CLIENT_DEFAULT_LOG=y
